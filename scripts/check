#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

for development_command in shellcheck tmux; do
  command -v "$development_command" >/dev/null || {
    echo "Missing required development command: $development_command" >&2
    exit 1
  }
done

bash -n bin/remote-chrome tests/remote-chrome_test.sh scripts/check
shellcheck bin/remote-chrome tests/remote-chrome_test.sh scripts/check
bash tests/remote-chrome_test.sh
git diff --check
