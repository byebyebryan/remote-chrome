#!/usr/bin/env bash
set -euo pipefail

PROGRAM="${0##*/}"
VERSION="1.4.0"

usage() {
  cat <<USAGE
Usage:
  $PROGRAM HOST [-- CHROME_ARGS...]
  $PROGRAM launch HOST [-- CHROME_ARGS...]
  $PROGRAM stop [HOST] [--from SOURCE]
  $PROGRAM status [HOST]
  $PROGRAM doctor HOST
  $PROGRAM attach HOST
  $PROGRAM reset [HOST] [--session NAME] [--yes]

Chrome options:
      --session NAME       tmux session name
      --foreground         run Chrome remoting in the foreground
      --chrome-command CMD remote Chrome command, default: google-chrome-stable
      --with-yubikey       require forwarding a local YubiKey
      --no-yubikey         skip YubiKey detection and forwarding
      --yubikey-usb-id ID  local USB id, default: 1050:0407
      --yubikey-port PORT  USB/IP TCP port, default: 3240
      --allow-existing     launch even if remote Chrome is already running
      --yes                do not prompt before killing remote Chrome
      --no-notifications   do not relay remote notifications to this machine

Reset options:
      --yes                skip reset restart/absent-group confirmations;
                           identity checks and safety refusals still apply

Stop options:
      without HOST         stop outgoing and tracked incoming sessions
      --from SOURCE        run cleanup on the forwarding host over SSH;
                           omit HOST to stop all its managed sessions

General options:
      -h, --help           print help and exit
      -V, --version        print version and exit

Environment:
  REMOTE_CHROME_COMMAND
  REMOTE_CHROME_SESSION_PREFIX
  REMOTE_CHROME_YUBIKEY_USB_ID
  REMOTE_CHROME_USBIP_PORT
  REMOTE_CHROME_YUBIKEY_SOCKET
  REMOTE_CHROME_STOP_USBIPD
  REMOTE_CHROME_YUBIKEY_TIMEOUT
  REMOTE_CHROME_YUBIKEY_BOOTSTRAP_TIMEOUT
  REMOTE_CHROME_YUBIKEY_READY_GRACE
  REMOTE_CHROME_RESET_TIMEOUT
  REMOTE_CHROME_SECRET_APPLICATION
  REMOTE_CHROME_SECRET_SCHEMA
  REMOTE_CHROME_NOTIFICATIONS
  REMOTE_CHROME_NOTIFICATION_APPS
USAGE
}

die() {
  echo "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null || die "Missing required command: $1"
}

safe_name() {
  local value="$1"
  value="${value//[^[:alnum:]_-]/_}"
  printf '%s\n' "$value"
}

runtime_artifact_status() {
  local path="$1"
  if [[ -e "$path" || -L "$path" ]]; then
    [[ -f "$path" && ! -L "$path" && -O "$path" ]] || return 2
    return 0
  fi
  return 1
}

runtime_owned_directory() {
  [[ -d "$1" && ! -L "$1" && -O "$1" ]]
}

runtime_path_present() {
  [[ -e "$1" || -L "$1" ]]
}

runtime_path_identity() {
  stat -c '%d:%i:%y' -- "$1" 2>/dev/null
}

script_path() {
  if [[ "$0" == */* ]]; then
    local dir
    dir="$(cd -P -- "$(dirname -- "$0")" && pwd)"
    printf '%s/%s\n' "$dir" "$(basename -- "$0")"
  else
    command -v "$PROGRAM"
  fi
}

quote_command() {
  printf '%q ' "$@"
}

print_command_hint() {
  local label="$1"
  shift

  printf '%s' "$label"
  printf ' %q' "$@"
  printf '\n'
}

chrome_default_session() {
  printf '%s-%s\n' "${REMOTE_CHROME_SESSION_PREFIX:-remote-chrome}" "$(safe_name "$1")"
}

chrome_secret_application=""
chrome_secret_schema=""

chrome_secret_identity() {
  local chrome_command="$1"
  local command_name="${chrome_command##*/}"
  local configured_application="${REMOTE_CHROME_SECRET_APPLICATION:-}"
  local configured_schema="${REMOTE_CHROME_SECRET_SCHEMA:-}"

  case "$command_name" in
    google-chrome|google-chrome-stable|chrome)
      chrome_secret_application="chrome"
      chrome_secret_schema="chrome_libsecret_os_crypt_password_v2"
      ;;
    chromium|chromium-browser)
      chrome_secret_application="chromium"
      chrome_secret_schema="chromium_libsecret_os_crypt_password_v2"
      ;;
    *)
      if [ -n "$configured_application" ] && [ -n "$configured_schema" ]; then
        chrome_secret_application="$configured_application"
        chrome_secret_schema="$configured_schema"
      else
        echo "No Safe Storage mapping is known for custom Chrome executable '$chrome_command'." >&2
        echo "Set both REMOTE_CHROME_SECRET_APPLICATION and REMOTE_CHROME_SECRET_SCHEMA, then retry." >&2
        return 1
      fi
      ;;
  esac

  if [ -n "$configured_application" ] || [ -n "$configured_schema" ]; then
    if [ -z "$configured_application" ] || [ -z "$configured_schema" ]; then
      echo "REMOTE_CHROME_SECRET_APPLICATION and REMOTE_CHROME_SECRET_SCHEMA must be set together." >&2
      return 1
    fi
    chrome_secret_application="$configured_application"
    chrome_secret_schema="$configured_schema"
  fi
}

chrome_validate_password_store_args() {
  local argument
  for argument in "$@"; do
    case "$argument" in
      --password-store|--password-store=*)
        die "Do not provide --password-store; remote-chrome forces --password-store=gnome-libsecret after a Safe Storage preflight."
        ;;
    esac
  done
}

# This script is sent over the existing Waypipe SSH connection. It creates a
# narrowly filtered bus proxy, verifies the exact Safe Storage item through
# that proxy, and only then starts Chrome. Keep this literal heredoc free of
# local expansion: values arrive as positional arguments in the command line.
chrome_secure_bootstrap_script() {
  cat <<'REMOTE_CHROME_SECURE_BOOTSTRAP'
set -u

chrome_command="${1:-}"
secret_application="${2:-}"
secret_schema="${3:-}"
notify_socket="${4:-}"
notify_apps="${5:-}"
shift 5 2>/dev/null || exit 64

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
normal_bus="${DBUS_SESSION_BUS_ADDRESS:-}"
case "$normal_bus" in
  /*) normal_bus="unix:path=$normal_bus" ;;
esac
export DBUS_SESSION_BUS_ADDRESS="$normal_bus"
proxy_socket="$runtime_dir/remote-chrome-dbus-proxy-${BASHPID:-$$}.sock"
notify_forwarder_script=""
notify_forwarder_script_inode=""
notify_helper_log=""
notify_helper_log_inode=""
notify_ready_file=""
notify_ready_file_inode=""
umask 077
proxy_pid=""
proxy_starttime=""
proxy_socket_owned=0
proxy_socket_inode=""
secret_pid=""
secret_starttime=""
secret_owned=0
notify_pid=""
notify_starttime=""
notify_process_description="notify forwarder"
notify_socket_inode=""
notify_backend="disabled"
notify_capabilities=""
notify_error=""
chrome_pid=""
chrome_starttime=""
incoming_state=""
cleanup_done=0
cleanup_status=0

remote_secure_pid_stat() {
  local pid="$1"
  local stat_line rest state parent_pid starttime index
  local -a stat_fields=()
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  IFS= read -r stat_line <"/proc/$pid/stat" 2>/dev/null || return 1
  case "$stat_line" in
    "$pid ("*) stat_line="${stat_line#"$pid ("}" ;;
    *) return 1 ;;
  esac

  # comm may contain spaces and right parentheses.  Scan candidates from the
  # end and accept only the one whose state/ppid/starttime fields are valid.
  for ((index = ${#stat_line} - 1; index >= 0; index--)); do
    [ "${stat_line:index:1}" = ")" ] || continue
    rest="${stat_line:index+1}"
    stat_fields=()
    read -r -a stat_fields <<<"$rest"
    [ "${#stat_fields[@]}" -ge 20 ] || continue
    state="${stat_fields[0]}"
    case "$state" in
      R|S|D|Z|T|t|W|X|K|P) ;;
      *) continue ;;
    esac
    parent_pid="${stat_fields[1]}"
    starttime="${stat_fields[19]}"
    [[ "$parent_pid" =~ ^[0-9]+$ ]] || continue
    [[ "$starttime" =~ ^[0-9]+$ ]] || continue
    printf '%s\t%s\n' "$starttime" "$parent_pid"
    return 0
  done
  return 1
}

remote_secure_pid_starttime() {
  local pid="$1"
  local identity starttime parent_pid
  identity="$(remote_secure_pid_stat "$pid" 2>/dev/null)" || return 1
  IFS=$'\t' read -r starttime parent_pid <<<"$identity"
  [ -n "$starttime" ] || return 1
  printf '%s\n' "$starttime"
}

remote_secure_pid_parent() {
  local pid="$1"
  local identity starttime parent_pid
  identity="$(remote_secure_pid_stat "$pid" 2>/dev/null)" || return 1
  IFS=$'\t' read -r starttime parent_pid <<<"$identity"
  [ -n "$parent_pid" ] || return 1
  printf '%s\n' "$parent_pid"
}

remote_secure_pid_matches() {
  local pid="$1"
  local recorded_starttime="$2"
  local expected="${3:-}"
  local expected_parent="${4:-}"
  local command_line first current_starttime current_parent
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$recorded_starttime" =~ ^[0-9]+$ ]] || return 1
  current_starttime="$(remote_secure_pid_starttime "$pid" 2>/dev/null || true)"
  [ "$current_starttime" = "$recorded_starttime" ] || return 1
  if [ -n "$expected" ]; then
    [ -r "/proc/$pid/cmdline" ] || return 1
    command_line="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    first="${command_line%% *}"
    first="${first##*/}"
    [ "$first" = "$expected" ] || return 1
  fi
  if [ -n "$expected_parent" ]; then
    current_parent="$(remote_secure_pid_parent "$pid" 2>/dev/null || true)"
    [ "$current_parent" = "$expected_parent" ] || return 1
  fi
}

remote_secure_child_pid_matches() {
  local pid="$1"
  local recorded_starttime="$2"
  # Custom Chrome commands may be wrapper scripts whose /proc executable is
  # the interpreter.  The direct-child relationship plus birth identity is
  # the stable ownership check for this child; helper daemons additionally
  # require their expected executable name below.
  remote_secure_pid_matches "$pid" "$recorded_starttime" "" "$$"
}

remote_secure_stop_pid() {
  local pid="$1"
  local recorded_starttime="$2"
  local expected="$3"
  local attempt
  remote_secure_pid_matches "$pid" "$recorded_starttime" "$expected" "$$" || return 1
  kill -TERM "$pid" >/dev/null 2>&1 || true
  for ((attempt = 0; attempt < 20; attempt++)); do
    remote_secure_pid_matches "$pid" "$recorded_starttime" "$expected" "$$" || return 0
    sleep 0.1
  done
  if remote_secure_pid_matches "$pid" "$recorded_starttime" "$expected" "$$"; then
    kill -KILL "$pid" >/dev/null 2>&1 || true
  fi
  for ((attempt = 0; attempt < 20; attempt++)); do
    remote_secure_pid_matches "$pid" "$recorded_starttime" "$expected" "$$" || return 0
    sleep 0.1
  done
  return 1
}

remote_secure_stop_child_pid() {
  local pid="$1"
  local recorded_starttime="$2"
  local attempt
  remote_secure_child_pid_matches "$pid" "$recorded_starttime" || return 1
  kill -TERM "$pid" >/dev/null 2>&1 || true
  for ((attempt = 0; attempt < 20; attempt++)); do
    remote_secure_child_pid_matches "$pid" "$recorded_starttime" || return 0
    sleep 0.1
  done
  if remote_secure_child_pid_matches "$pid" "$recorded_starttime"; then
    kill -KILL "$pid" >/dev/null 2>&1 || true
  fi
  for ((attempt = 0; attempt < 20; attempt++)); do
    remote_secure_child_pid_matches "$pid" "$recorded_starttime" || return 0
    sleep 0.1
  done
  return 1
}

remote_secure_wait_owned_pid() {
  local pid="$1"
  local recorded_starttime="$2"
  local expected="$3"
  local attempt
  for ((attempt = 0; attempt < 20; attempt++)); do
    remote_secure_pid_matches "$pid" "$recorded_starttime" "$expected" "$$" && return 0
    kill -0 "$pid" >/dev/null 2>&1 || return 1
    sleep 0.1
  done
  remote_secure_pid_matches "$pid" "$recorded_starttime" "$expected" "$$"
}

remote_secure_wait_owned_child() {
  local pid="$1"
  local recorded_starttime="$2"
  local attempt
  for ((attempt = 0; attempt < 20; attempt++)); do
    remote_secure_child_pid_matches "$pid" "$recorded_starttime" && return 0
    kill -0 "$pid" >/dev/null 2>&1 || return 1
    sleep 0.1
  done
  remote_secure_child_pid_matches "$pid" "$recorded_starttime"
}

remote_secure_stop_notify_process() {
  local process_stopped=0
  [ -n "$notify_pid" ] || return 0
  if [ -z "$notify_starttime" ]; then
    echo "remote-chrome secure session: $notify_process_description PID $notify_pid has no recorded starttime; preserving it." >&2
    return 1
  elif remote_secure_wait_owned_pid "$notify_pid" "$notify_starttime" python3; then
    if remote_secure_stop_pid "$notify_pid" "$notify_starttime" python3; then
      process_stopped=1
    else
      echo "remote-chrome secure session: owned $notify_process_description PID $notify_pid remains after TERM/KILL; inspect it before retrying." >&2
      return 1
    fi
  elif kill -0 "$notify_pid" >/dev/null 2>&1; then
    echo "remote-chrome secure session: $notify_process_description PID $notify_pid identity changed; preserving the replacement process." >&2
    return 1
  else
    process_stopped=1
  fi
  if [ "$process_stopped" = "1" ]; then
    wait "$notify_pid" >/dev/null 2>&1 || true
    notify_pid=""
    notify_starttime=""
  fi
}

remote_secure_remove_notify_file() {
  local path="$1"
  local expected_inode="$2"
  local description="$3"
  local current_inode
  [ -n "$path" ] || return 0
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return 0
  fi
  if [ -L "$path" ] || [ ! -f "$path" ] || [ ! -O "$path" ]; then
    echo "remote-chrome secure session: $description identity changed; preserving $path." >&2
    return 1
  fi
  current_inode="$(stat -c '%d:%i' "$path" 2>/dev/null || true)"
  if [ -z "$expected_inode" ] || [ "$current_inode" != "$expected_inode" ]; then
    echo "remote-chrome secure session: $description identity changed; preserving $path." >&2
    return 1
  fi
  if ! rm -f -- "$path" || [ -e "$path" ] || [ -L "$path" ]; then
    echo "remote-chrome secure session: could not remove owned $description $path." >&2
    return 1
  fi
}

remote_secure_cleanup() {
  [ "$cleanup_done" = "0" ] || return "$cleanup_status"
  # Protect both normal Chrome exit and EXIT-trap cleanup from teardown signals.
  # Finish the bounded ledger before accepting another termination.
  trap '' INT TERM HUP
  cleanup_done=1
  local cleanup_failed=0
  local process_stopped=0

  if [ -n "$chrome_pid" ]; then
    process_stopped=0
    if [ -z "$chrome_starttime" ]; then
      echo "remote-chrome secure session: Chrome child PID $chrome_pid has no recorded starttime; preserving it." >&2
      cleanup_failed=1
    elif remote_secure_wait_owned_child "$chrome_pid" "$chrome_starttime"; then
      if remote_secure_stop_child_pid "$chrome_pid" "$chrome_starttime"; then
        process_stopped=1
      else
        echo "remote-chrome secure session: owned Chrome child PID $chrome_pid remains after TERM/KILL; inspect it before retrying." >&2
        cleanup_failed=1
      fi
    elif kill -0 "$chrome_pid" >/dev/null 2>&1; then
      echo "remote-chrome secure session: Chrome child PID $chrome_pid identity changed; preserving the replacement process." >&2
      cleanup_failed=1
    fi
    if [ "$process_stopped" = "1" ]; then
      wait "$chrome_pid" >/dev/null 2>&1 || true
    fi
  fi

  if [ -n "$proxy_pid" ]; then
    process_stopped=0
    if [ -z "$proxy_starttime" ]; then
      echo "remote-chrome secure session: proxy PID $proxy_pid has no recorded starttime; preserving it." >&2
      cleanup_failed=1
    elif remote_secure_wait_owned_pid "$proxy_pid" "$proxy_starttime" xdg-dbus-proxy; then
      if remote_secure_stop_pid "$proxy_pid" "$proxy_starttime" xdg-dbus-proxy; then
        process_stopped=1
      else
        echo "remote-chrome secure session: owned xdg-dbus-proxy PID $proxy_pid remains after TERM/KILL; inspect it before retrying." >&2
        cleanup_failed=1
      fi
    elif kill -0 "$proxy_pid" >/dev/null 2>&1; then
      echo "remote-chrome secure session: xdg-dbus-proxy PID $proxy_pid identity changed; preserving the replacement process." >&2
      cleanup_failed=1
    fi
    if [ "$process_stopped" = "1" ]; then
      wait "$proxy_pid" >/dev/null 2>&1 || true
    fi
  fi

  remote_secure_stop_notify_process || cleanup_failed=1

  remote_secure_remove_notify_file "$notify_forwarder_script" \
    "$notify_forwarder_script_inode" "notification helper script" || cleanup_failed=1
  remote_secure_remove_notify_file "$notify_ready_file" \
    "$notify_ready_file_inode" "notification readiness file" || cleanup_failed=1
  remote_secure_remove_notify_file "$notify_helper_log" \
    "$notify_helper_log_inode" "notification helper log" || cleanup_failed=1

  if [ -n "$notify_socket_inode" ] && [ -S "$notify_socket" ]; then
    current_inode="$(stat -c '%d:%i' "$notify_socket" 2>/dev/null || true)"
    if [ -z "$current_inode" ]; then
      echo "remote-chrome secure session: could not inspect notify socket $notify_socket; preserving it." >&2
      cleanup_failed=1
    elif [ "$current_inode" != "$notify_socket_inode" ]; then
      echo "remote-chrome secure session: notify socket identity changed; preserving $notify_socket." >&2
      cleanup_failed=1
    elif ! rm -f -- "$notify_socket"; then
      echo "remote-chrome secure session: could not remove notify socket $notify_socket; inspect it before retrying." >&2
      cleanup_failed=1
    fi
  fi

  if [ -n "$secret_pid" ] && [ "$secret_owned" = "1" ]; then
    process_stopped=0
    if [ -z "$secret_starttime" ]; then
      echo "remote-chrome secure session: owned ksecretd PID $secret_pid has no recorded starttime; preserving it." >&2
      cleanup_failed=1
    elif remote_secure_wait_owned_pid "$secret_pid" "$secret_starttime" ksecretd; then
      if remote_secure_stop_pid "$secret_pid" "$secret_starttime" ksecretd; then
        process_stopped=1
      else
        echo "remote-chrome secure session: owned ksecretd PID $secret_pid remains after TERM/KILL; inspect it before retrying." >&2
        cleanup_failed=1
      fi
    elif kill -0 "$secret_pid" >/dev/null 2>&1; then
      echo "remote-chrome secure session: ksecretd PID $secret_pid identity changed; preserving the replacement process." >&2
      cleanup_failed=1
    fi
    if [ "$process_stopped" = "1" ]; then
      wait "$secret_pid" >/dev/null 2>&1 || true
    fi
  fi

  if [ "$proxy_socket_owned" = "1" ]; then
    if [ -e "$proxy_socket" ] || [ -L "$proxy_socket" ]; then
      current_inode="$(stat -c '%d:%i' "$proxy_socket" 2>/dev/null || true)"
    else
      current_inode=""
    fi
    if [ -z "$current_inode" ]; then
      if [ -e "$proxy_socket" ] || [ -L "$proxy_socket" ]; then
        echo "remote-chrome secure session: could not inspect owned proxy socket $proxy_socket; preserving it." >&2
        cleanup_failed=1
      fi
    elif [ -z "$proxy_socket_inode" ]; then
      echo "remote-chrome secure session: owned proxy socket $proxy_socket has no recorded inode; preserving it." >&2
      cleanup_failed=1
    elif [ "$current_inode" != "$proxy_socket_inode" ]; then
      echo "remote-chrome secure session: proxy socket identity changed; preserving $proxy_socket." >&2
      cleanup_failed=1
    else
      if ! rm -f -- "$proxy_socket"; then
        echo "remote-chrome secure session: could not remove owned proxy socket $proxy_socket; inspect it before retrying." >&2
        cleanup_failed=1
      elif [ -e "$proxy_socket" ] || [ -L "$proxy_socket" ]; then
        echo "remote-chrome secure session: owned proxy socket $proxy_socket remains after removal." >&2
        cleanup_failed=1
      fi
    fi
  fi
  cleanup_status="$cleanup_failed"
  [ -z "$incoming_state" ] || rm -f -- "$incoming_state" || true
  return "$cleanup_status"
}

remote_secure_on_exit() {
  local exit_status="$?"
  local final_status="$exit_status"
  remote_secure_cleanup || true
  if [ "$final_status" -eq 0 ] && [ "$cleanup_status" -ne 0 ]; then
    final_status="$cleanup_status"
  fi
  trap - EXIT
  exit "$final_status"
}

remote_secure_signal() {
  local status="$1"
  trap '' INT TERM HUP
  exit "$status"
}

remote_secure_fail() {
  echo "remote-chrome secure session: $*" >&2
  exit 1
}

trap 'remote_secure_on_exit' EXIT
trap 'remote_secure_signal 130' INT
trap 'remote_secure_signal 143' TERM
trap 'remote_secure_signal 129' HUP

[ -n "$chrome_command" ] || remote_secure_fail "Chrome command is missing."
[ -n "$secret_application" ] && [ -n "$secret_schema" ] ||
  remote_secure_fail "Safe Storage identity mapping is missing."
[ -n "$normal_bus" ] ||
  remote_secure_fail "DBUS_SESSION_BUS_ADDRESS is not set to the normal remote user session bus."
[ -d "$runtime_dir" ] ||
  remote_secure_fail "XDG_RUNTIME_DIR does not exist: $runtime_dir"

for required_command in bash busctl secret-tool xdg-dbus-proxy ksecretd; do
  command -v "$required_command" >/dev/null 2>&1 ||
    remote_secure_fail "remote prerequisite is missing: $required_command"
done
command -v "$chrome_command" >/dev/null 2>&1 ||
  remote_secure_fail "remote Chrome command is missing: $chrome_command"

if [ -e "$proxy_socket" ] || [ -L "$proxy_socket" ]; then
  remote_secure_fail "refusing to reuse an existing proxy socket: $proxy_socket"
fi

secret_owner=0
if busctl --user --no-pager --quiet status org.freedesktop.secrets >/dev/null 2>&1; then
  secret_owner=1
else
  # No Secret Service owner exists. This process is started inside the
  # Waypipe environment and is the only Secret Service process this wrapper
  # may clean up. A pre-existing owner is never stopped.
  ksecretd >/dev/null 2>&1 &
  secret_pid=$!
  secret_owned=1
  secret_starttime="$(remote_secure_pid_starttime "$secret_pid" 2>/dev/null || true)"
  [ -n "$secret_starttime" ] ||
    remote_secure_fail "could not record the owned ksecretd PID $secret_pid starttime; refusing unverified cleanup."
  for ((attempt = 0; attempt < 100; attempt++)); do
    if busctl --user --no-pager --quiet status org.freedesktop.secrets >/dev/null 2>&1; then
      secret_owner=1
      break
    fi
    kill -0 "$secret_pid" >/dev/null 2>&1 ||
      remote_secure_fail "ksecretd exited before owning org.freedesktop.secrets."
    sleep 0.1
  done
fi
[ "$secret_owner" = "1" ] ||
  remote_secure_fail "no org.freedesktop.secrets owner became available; a KWallet prompt may have been canceled."

# Record only this bootstrap, not arbitrary SSH connections. This advisory
# record lets a local stop request the originating session's normal cleanup.
# Failed tracking never blocks a browser launch.
if [ -n "${REMOTE_CHROME_ORIGIN_TARGET:-}" ]; then
  incoming_pid="${BASHPID:-$$}"
  incoming_starttime="$(remote_secure_pid_starttime "$incoming_pid" 2>/dev/null || true)"
  incoming_peer="${SSH_CONNECTION:-}"
  incoming_peer="${incoming_peer%% *}"
  incoming_peer="${incoming_peer:-${REMOTE_CHROME_ORIGIN_NAME:-}}"
  if [ -n "$incoming_starttime" ]; then
    incoming_pending="$(mktemp "$runtime_dir/remote-chrome-incoming-XXXXXXXX.tmp" 2>/dev/null || true)"
    if [ -n "$incoming_pending" ]; then
      incoming_state="${incoming_pending%.tmp}.state"
      if ! {
        printf 'pid\t%s\n' "$incoming_pid"
        printf 'starttime\t%s\n' "$incoming_starttime"
        printf 'boot_id\t%s\n' "$(cat /proc/sys/kernel/random/boot_id)"
        printf 'peer\t%s\n' "$incoming_peer"
        printf 'name\t%s\n' "${REMOTE_CHROME_ORIGIN_NAME:-}"
        printf 'user\t%s\n' "${REMOTE_CHROME_ORIGIN_USER:-}"
        printf 'session\t%s\n' "${REMOTE_CHROME_ORIGIN_SESSION:-}"
        printf 'target\t%s\n' "$REMOTE_CHROME_ORIGIN_TARGET"
      } >"$incoming_pending" || ! mv -f -- "$incoming_pending" "$incoming_state"; then
        rm -f -- "$incoming_state" "$incoming_pending" || true
        incoming_state=""
        echo "remote-chrome: incoming session tracking unavailable; local stop will not discover this session." >&2
      fi
    fi
  fi
fi

# --filter with these --talk rules is intentional: Chrome needs the Secret
# Service for the password store and org.freedesktop.Notifications so web
# notifications reach the remote daemon instead of Chrome drawing its own
# toplevels (which a tiling compositor will tile on the local machine).
# org.freedesktop.portal.Desktop receives no talk/see/own policy and remains
# hidden, so GTK file choosers use Waypipe.
xdg-dbus-proxy "$normal_bus" "$proxy_socket" \
  --filter --talk=org.freedesktop.secrets --talk=org.freedesktop.Notifications >/dev/null 2>&1 &
proxy_pid=$!
proxy_socket_owned=1
proxy_starttime="$(remote_secure_pid_starttime "$proxy_pid" 2>/dev/null || true)"
[ -n "$proxy_starttime" ] ||
  remote_secure_fail "could not record the owned xdg-dbus-proxy PID $proxy_pid starttime; refusing unverified cleanup."
for ((attempt = 0; attempt < 100; attempt++)); do
  if [ -S "$proxy_socket" ]; then
    proxy_socket_inode="$(stat -c '%d:%i' "$proxy_socket" 2>/dev/null || true)"
    break
  fi
  kill -0 "$proxy_pid" >/dev/null 2>&1 ||
    remote_secure_fail "xdg-dbus-proxy exited before creating its socket."
  sleep 0.1
done
[ -n "$proxy_socket_inode" ] ||
  remote_secure_fail "xdg-dbus-proxy did not create a socket: $proxy_socket"

remote_notify_name_has_owner() {
  busctl --user --timeout=0.35 --json=short call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus NameHasOwner s org.freedesktop.Notifications 2>/dev/null |
    python3 -c 'import json,sys; print("1" if json.load(sys.stdin)["data"][0] else "0")'
}

remote_notify_name_owner() {
  busctl --user --timeout=0.35 --json=short call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus GetNameOwner s org.freedesktop.Notifications 2>/dev/null |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["data"][0])'
}

remote_notify_owner_information() {
  local owner="$1"
  busctl --user --timeout=0.35 --json=short call "$owner" /org/freedesktop/Notifications \
    org.freedesktop.Notifications GetServerInformation 2>/dev/null |
    python3 -c 'import json,sys; d=json.load(sys.stdin)["data"]; print(str(d[0])+"\t"+str(d[1]))'
}

remote_notify_owner_capabilities() {
  local owner="$1"
  busctl --user --timeout=0.35 --json=short call "$owner" /org/freedesktop/Notifications \
    org.freedesktop.Notifications GetCapabilities 2>/dev/null |
    python3 -c 'import json,sys; d=json.load(sys.stdin)["data"]; print(",".join(str(x) for x in d[0]))'
}

remote_notify_record_process() {
  notify_pid=$!
  notify_starttime="$(remote_secure_pid_starttime "$notify_pid" 2>/dev/null || true)"
  if [ -z "$notify_starttime" ]; then
    if kill -0 "$notify_pid" >/dev/null 2>&1; then
      remote_secure_fail "could not record the owned notification helper PID $notify_pid starttime; refusing unverified cleanup."
    fi
    wait "$notify_pid" >/dev/null 2>&1 || true
    notify_pid=""
  fi
}

if [ -n "$notify_socket" ]; then
  if [ -S "$notify_socket" ]; then
    notify_socket_inode="$(stat -c '%d:%i' "$notify_socket" 2>/dev/null || true)"
  fi
  notify_forwarder_script="$runtime_dir/remote-chrome-notify-forwarder-$$.py"
  notify_helper_log="$runtime_dir/remote-chrome-notify-helper-$$.log"
  notify_ready_file="$runtime_dir/remote-chrome-notify-status-$$.state"
  for notify_candidate in "$notify_forwarder_script" "$notify_helper_log" "$notify_ready_file"; do
    if [ -e "$notify_candidate" ] || [ -L "$notify_candidate" ]; then
      notify_forwarder_script=""
      notify_helper_log=""
      notify_ready_file=""
      remote_secure_fail "refusing to overwrite an existing notification artifact: $notify_candidate"
    fi
  done
  : >"$notify_helper_log"
  chmod 600 -- "$notify_helper_log"
  notify_helper_log_inode="$(stat -c '%d:%i' "$notify_helper_log" 2>/dev/null || true)"
  source_owner_has="unknown"
  source_owner=""
  source_server=""
  source_vendor=""
  if command -v busctl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    source_owner_has="$(remote_notify_name_has_owner 2>/dev/null || true)"
  fi
  if [ "$source_owner_has" = "1" ]; then
    source_owner="$(remote_notify_name_owner 2>/dev/null || true)"
    if [ -n "$source_owner" ]; then
      owner_info="$(remote_notify_owner_information "$source_owner" 2>/dev/null || true)"
      IFS=$'\t' read -r source_server source_vendor <<<"$owner_info"
    fi
    if [ "$source_server" = "remote-chrome-notification-endpoint" ] &&
       [ "$source_vendor" = "remote-chrome" ]; then
      remote_secure_fail "another managed headless notification session owns org.freedesktop.Notifications; refusing a competing notifications-enabled Chrome session."
    elif [ -n "$source_owner" ] && [ -n "$source_server" ] && [ -n "$source_vendor" ]; then
      source_capabilities="$(remote_notify_owner_capabilities "$source_owner" 2>/dev/null || true)"
      if [[ ",$source_capabilities," == *,body,* && ",$source_capabilities," == *,actions,* ]]; then
        notify_backend="desktop"
        notify_capabilities="informational"
      else
        notify_backend="unavailable"
        notify_error="existing notification owner lacks compatible body/actions support"
        echo "remote-chrome: notifications unavailable ($notify_error); Chrome will start securely without notification forwarding." >&2
      fi
    else
      notify_backend="unavailable"
      notify_error="could not identify current notification owner"
      echo "remote-chrome: notifications unavailable ($notify_error); Chrome will start securely without notification forwarding." >&2
    fi
  elif [ "$source_owner_has" = "0" ]; then
    if [ -S "$notify_socket" ] && command -v python3 >/dev/null 2>&1; then
      cat >"$notify_forwarder_script" <<'REMOTE_CHROME_NOTIFY_ENDPOINT'
import json
import os
import secrets
import select
import signal
import socket
import sys
import time

NAME = "org.freedesktop.Notifications"
PATH = "/org/freedesktop/Notifications"
MANAGED_SERVER = "remote-chrome-notification-endpoint"
MANAGED_VENDOR = "remote-chrome"
MAX_LINE = 64 * 1024
MAX_QUEUE = 64
MAX_QUEUE_BYTES = 1 << 20
MAX_ACTIVE = 256
PROTOCOL_VERSION = 1


def write_status(path, value):
    try:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(value + "\n")
            handle.flush()
            os.fsync(handle.fileno())
    except OSError:
        pass


def send_frame(channel, record):
    blob = (json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
    if len(blob) > MAX_LINE:
        raise ValueError("oversized frame")
    channel.sendall(blob)


def read_frame(channel, deadline):
    buffer = bytearray()
    while time.monotonic() < deadline and len(buffer) <= MAX_LINE:
        ready, _, _ = select.select([channel], [], [], max(0, deadline - time.monotonic()))
        if not ready:
            break
        chunk = channel.recv(65536)
        if not chunk:
            break
        buffer.extend(chunk)
        if b"\n" in buffer:
            line, _, _rest = buffer.partition(b"\n")
            return json.loads(line)
    raise TimeoutError("notification listener handshake timed out")


class NotificationEndpoint:
    def __init__(self, dbus, bus, channel, session_id, generation, capabilities, apps):
        import dbus.service
        from gi.repository import GLib
        self.dbus = dbus
        self.bus = bus
        self.channel = channel
        self.session_id = session_id
        self.generation = generation
        self.apps = None if apps.strip() == "*" else tuple(term.lower() for term in apps.split(",") if term)
        self.capabilities = set(capabilities) & {"body", "actions", "body-markup"}
        self.GLib = GLib
        self.loop = GLib.MainLoop()
        self.input = bytearray()
        self.output = []
        self.output_bytes = 0
        self.write_watch = 0
        self.closed = False
        self.next_id = 1
        self.active = {}
        parent = self

        class EndpointObject(dbus.service.Object):
            @dbus.service.method(NAME, in_signature="", out_signature="as")
            def GetCapabilities(self):
                return dbus.Array(sorted(parent.capabilities), signature="s")

            @dbus.service.method(NAME, in_signature="", out_signature="ssss")
            def GetServerInformation(self):
                return (MANAGED_SERVER, MANAGED_VENDOR, "1", "1.2")

            @dbus.service.method(NAME, in_signature="susssasa{sv}i", out_signature="u")
            def Notify(self, app_name, replaces_id, icon, summary, body, actions, hints, expire_timeout):
                return parent.notify(app_name, replaces_id, summary, body, actions, hints, expire_timeout)

            @dbus.service.method(NAME, in_signature="u", out_signature="")
            def CloseNotification(self, notification_id):
                parent.close(notification_id)

            @dbus.service.signal(NAME, signature="us")
            def ActionInvoked(self, notification_id, key):
                pass

            @dbus.service.signal(NAME, signature="uu")
            def NotificationClosed(self, notification_id, reason):
                pass

        self.object = EndpointObject(bus, PATH)
        self.read_watch = GLib.io_add_watch(
            channel, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_channel
        )

    @staticmethod
    def valid_id(value):
        return isinstance(value, int) and not isinstance(value, bool) and 0 < value <= 0xFFFFFFFF

    def envelope(self, kind, **fields):
        return {"v": PROTOCOL_VERSION, "type": kind, "session_id": self.session_id, "generation": self.generation, **fields}

    def queue(self, record):
        if self.closed:
            raise self.dbus.DBusException("notification transport is unavailable")
        blob = (json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
        if len(blob) > MAX_LINE or len(self.output) >= MAX_QUEUE or self.output_bytes + len(blob) > MAX_QUEUE_BYTES:
            self.disconnect("outbound-queue-limit")
            raise self.dbus.DBusException("notification transport queue is full")
        self.output.append(memoryview(blob))
        self.output_bytes += len(blob)
        if not self.write_watch:
            self.write_watch = self.GLib.io_add_watch(
                self.channel, self.GLib.IO_OUT | self.GLib.IO_HUP | self.GLib.IO_ERR, self.on_write
            )

    def on_write(self, _source, condition):
        if condition & (self.GLib.IO_HUP | self.GLib.IO_ERR):
            self.disconnect("listener-disconnected")
            return self.GLib.SOURCE_REMOVE
        while self.output:
            try:
                written = self.channel.send(self.output[0])
            except BlockingIOError:
                return self.GLib.SOURCE_CONTINUE
            except OSError:
                self.disconnect("listener-disconnected")
                return self.GLib.SOURCE_REMOVE
            if written <= 0:
                self.disconnect("listener-disconnected")
                return self.GLib.SOURCE_REMOVE
            self.output_bytes -= written
            self.output[0] = self.output[0][written:]
            if not self.output[0]:
                self.output.pop(0)
        self.write_watch = 0
        return self.GLib.SOURCE_REMOVE

    def on_channel(self, _source, condition):
        if condition & (self.GLib.IO_IN | self.GLib.IO_HUP):
            while True:
                try:
                    chunk = self.channel.recv(65536)
                except BlockingIOError:
                    break
                except OSError:
                    self.disconnect("listener-read-failed")
                    return self.GLib.SOURCE_REMOVE
                if not chunk:
                    self.disconnect("listener-disconnected")
                    return self.GLib.SOURCE_REMOVE
                self.input.extend(chunk)
                while b"\n" in self.input:
                    line, _, rest = self.input.partition(b"\n")
                    self.input = bytearray(rest)
                    if len(line) > MAX_LINE:
                        self.disconnect("oversized-frame")
                        return self.GLib.SOURCE_REMOVE
                    try:
                        self.handle(json.loads(line))
                    except (ValueError, TypeError, RecursionError):
                        continue
                if len(self.input) > MAX_LINE:
                    self.disconnect("oversized-frame")
                    return self.GLib.SOURCE_REMOVE
        if condition & (self.GLib.IO_HUP | self.GLib.IO_ERR):
            self.disconnect("listener-disconnected")
            return self.GLib.SOURCE_REMOVE
        return self.GLib.SOURCE_CONTINUE

    def handle(self, record):
        if (not isinstance(record, dict) or type(record.get("v")) is not int
                or record["v"] != PROTOCOL_VERSION or record.get("session_id") != self.session_id
                or record.get("generation") != self.generation):
            return
        kind = record.get("type")
        source_id = record.get("source_id")
        if not self.valid_id(source_id):
            return
        state = self.active.get(source_id)
        if (state is None or not self.valid_id(record.get("revision"))
                or record["revision"] != state["revision"]):
            return
        if kind == "mapped":
            local_id = record.get("local_id")
            if state is not None and self.valid_id(local_id):
                state["local_id"] = local_id
                state["mapped_revision"] = state["revision"]
                self.active[source_id] = state
        elif kind == "action":
            local_id = record.get("local_id")
            key = record.get("key")
            if (state is not None and not state["close_requested"] and self.valid_id(local_id)
                    and state["local_id"] == local_id and isinstance(key, str) and key in state["actions"]):
                self.object.ActionInvoked(self.dbus.UInt32(source_id), self.dbus.String(key))
        elif kind == "closed":
            local_id = record.get("local_id")
            reason = record.get("reason")
            if (state is not None and self.valid_id(local_id) and state["local_id"] == local_id
                    and isinstance(reason, int) and not isinstance(reason, bool) and 1 <= reason <= 4):
                self.active.pop(source_id, None)
                self.object.NotificationClosed(self.dbus.UInt32(source_id), self.dbus.UInt32(reason))
        elif kind == "delivery-error":
            if self.active.pop(source_id, None) is not None:
                self.object.NotificationClosed(self.dbus.UInt32(source_id), self.dbus.UInt32(4))

    def allocate_id(self):
        for _ in range(MAX_ACTIVE + 1):
            candidate = self.next_id
            self.next_id = 1 if candidate == 0xFFFFFFFF else candidate + 1
            if candidate not in self.active:
                return candidate
        raise self.dbus.DBusException("notification ID space exhausted")

    def notify(self, app_name, replaces_id, summary, body, actions, hints, expire_timeout):
        if self.closed:
            raise self.dbus.DBusException("notification transport is unavailable")
        if self.apps is not None and not any(term in str(app_name).lower() for term in self.apps):
            raise self.dbus.DBusException("notification app is outside the forwarding allowlist")
        raw_actions = [str(item) for item in actions]
        if len(raw_actions) > 32 or len(raw_actions) % 2 or any(len(item) > 256 for item in raw_actions):
            raise self.dbus.DBusException("invalid action list")
        replaces = int(replaces_id)
        source_id = (replaces if replaces in self.active and not self.active[replaces]["close_requested"]
                     else self.allocate_id())
        if source_id not in self.active and len(self.active) >= MAX_ACTIVE:
            raise self.dbus.DBusException("notification active-ID limit reached")
        old_state = self.active.get(source_id, {})
        revision = old_state.get("revision", 0) + 1
        if not self.valid_id(revision):
            raise self.dbus.DBusException("notification revision limit reached")
        self.active[source_id] = {
            "actions": raw_actions[::2], "local_id": old_state.get("local_id", 0),
            "close_requested": False, "revision": revision,
            "mapped_revision": old_state.get("mapped_revision", 0),
        }
        urgency = 1
        try:
            urgency = int(hints.get("urgency", 1))
        except (TypeError, ValueError, AttributeError):
            pass
        if urgency not in (0, 1, 2):
            urgency = 1
        record = self.envelope(
            "notify", source_id=source_id, revision=revision, replaces_id=replaces if replaces == source_id else 0,
            app_name=str(app_name)[:128], summary=str(summary)[:512], body=str(body)[:4096],
            actions=raw_actions, urgency=urgency, expires=int(expire_timeout),
            desktop_entry=str(hints.get("desktop-entry", ""))[:128],
        )
        try:
            self.queue(record)
        except Exception:
            self.active.pop(source_id, None)
            raise
        return self.dbus.UInt32(source_id)

    def close(self, notification_id):
        source_id = int(notification_id)
        state = self.active.get(source_id)
        if state is None:
            raise self.dbus.DBusException("unknown notification ID")
        if state["close_requested"]:
            return
        state["close_requested"] = True
        self.active[source_id] = state
        local_id = state["local_id"] if state["mapped_revision"] == state["revision"] else 0
        self.queue(self.envelope("close", source_id=source_id, revision=state["revision"], local_id=local_id))

    def disconnect(self, reason):
        if self.closed:
            return
        self.closed = True
        self.active.clear()
        self.output.clear()
        self.output_bytes = 0
        print("notify-endpoint: transport unavailable: " + reason, file=sys.stderr)
        try:
            self.channel.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.loop.quit()
        except AttributeError:
            pass

    def run(self):
        self.queue(self.envelope("active"))
        self.loop.run()
        self.object.remove_from_connection()


def inspect_owner(bus, dbus, status_path):
    try:
        owner = str(bus.get_name_owner(NAME))
        service = dbus.Interface(bus.get_object(owner, PATH, introspect=False), NAME)
        information = service.GetServerInformation(timeout=0.35)
        if str(information[0]) == MANAGED_SERVER and str(information[1]) == MANAGED_VENDOR:
            write_status(status_path, "busy-managed")
            return "busy-managed"
        capabilities = set(map(str, service.GetCapabilities(timeout=0.35)))
        if not {"body", "actions"}.issubset(capabilities):
            write_status(status_path, "unavailable")
            return "unavailable"
        write_status(status_path, "busy-desktop")
        return "busy-desktop"
    except Exception:
        write_status(status_path, "unavailable")
        return "unavailable"


def main(argv):
    if len(argv) != 4:
        return 64
    socket_path, apps, status_path = argv[1:]
    try:
        import dbus
        import dbus.service
        from dbus.mainloop.glib import DBusGMainLoop
        from gi.repository import GLib
    except Exception as error:
        write_status(status_path, "unavailable")
        print("notify-endpoint: DBus bindings unavailable: " + str(error), file=sys.stderr)
        return 1
    DBusGMainLoop(set_as_default=True)
    address = os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")
    if not address:
        write_status(status_path, "unavailable")
        return 1
    try:
        bus = dbus.bus.BusConnection(address)
    except Exception as error:
        write_status(status_path, "unavailable")
        print("notify-endpoint: source bus unavailable: " + str(error), file=sys.stderr)
        return 1
    channel = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    channel.settimeout(0.5)
    try:
        channel.connect(socket_path)
    except OSError as error:
        write_status(status_path, "unavailable")
        print("notify-endpoint: relay unavailable: " + str(error), file=sys.stderr)
        return 1

    session_id = os.environ.get("REMOTE_CHROME_ORIGIN_SESSION", "remote-chrome")[:256] or "remote-chrome"
    generation = secrets.token_hex(24)
    try:
        send_frame(channel, {"v": PROTOCOL_VERSION, "type": "hello", "session_id": session_id,
                             "generation": generation, "notification_revisions": True})
        response = read_frame(channel, time.monotonic() + 1.2)
        if (not isinstance(response, dict) or type(response.get("v")) is not int
                or response["v"] != PROTOCOL_VERSION or response.get("type") != "ready" or response.get("session_id") != session_id
                or response.get("generation") != generation):
            message = (response.get("message", response.get("code", "listener rejected handshake"))
                       if isinstance(response, dict) else "invalid handshake")
            write_status(status_path, "unavailable")
            print("notify-endpoint: " + str(message), file=sys.stderr)
            return 1
        capabilities = response.get("capabilities", [])
        if (not isinstance(capabilities, list) or any(not isinstance(item, str) for item in capabilities)
                or not {"body", "actions"}.issubset(capabilities)
                or not isinstance(response.get("destination_owner"), str)
                or not response["destination_owner"].startswith(":")):
            write_status(status_path, "unavailable")
            print("notify-endpoint: destination does not support body/actions or pinned ownership", file=sys.stderr)
            return 1
        if response.get("notification_revisions") is not True:
            write_status(status_path, "unavailable")
            print("notify-endpoint: notification listener lacks revision support; update the forwarding host before resetting",
                  file=sys.stderr)
            return 1
    except Exception as error:
        write_status(status_path, "unavailable")
        print("notify-endpoint: handshake failed: " + str(error), file=sys.stderr)
        return 1

    name_result = bus.request_name(NAME, 4)
    if int(name_result) != 1:
        state = inspect_owner(bus, dbus, status_path)
        try:
            send_frame(channel, {"v": PROTOCOL_VERSION, "type": "abort", "session_id": session_id, "generation": generation,
                                 "reason": state})
        except OSError:
            pass
        return 20 if state == "busy-managed" else 0

    channel.setblocking(False)
    endpoint = NotificationEndpoint(dbus, bus, channel, session_id, generation, capabilities, apps)
    try:
        caps = ",".join(sorted(endpoint.capabilities))
        write_status(status_path, "ready\t" + caps)
        print("notify-endpoint: ready caps=" + caps, file=sys.stderr)
        signal.signal(signal.SIGTERM, lambda *_: endpoint.loop.quit())
        signal.signal(signal.SIGINT, lambda *_: endpoint.loop.quit())
        endpoint.run()
        return 0
    finally:
        endpoint.disconnect("endpoint-exit")
        try:
            bus.release_name(NAME)
        except Exception:
            pass
        try:
            bus.close()
        except Exception:
            pass
        write_status(status_path, "stopped")


if __name__ == "__main__":
    sys.exit(main(sys.argv))
REMOTE_CHROME_NOTIFY_ENDPOINT
      chmod 600 -- "$notify_forwarder_script"
      : >"$notify_ready_file"
      chmod 600 -- "$notify_ready_file"
      notify_forwarder_script_inode="$(stat -c '%d:%i' "$notify_forwarder_script" 2>/dev/null || true)"
      notify_ready_file_inode="$(stat -c '%d:%i' "$notify_ready_file" 2>/dev/null || true)"
      python3 "$notify_forwarder_script" "$notify_socket" "$notify_apps" "$notify_ready_file" \
        2>>"$notify_helper_log" &
      notify_process_description="notification endpoint"
      remote_notify_record_process
      for ((attempt = 0; attempt < 20; attempt++)); do
        [ -s "$notify_ready_file" ] && break
        kill -0 "$notify_pid" >/dev/null 2>&1 || break
        sleep 0.1
      done
      helper_state=""
      IFS=$'\t' read -r helper_state notify_capabilities <"$notify_ready_file" 2>/dev/null || true
      case "$helper_state" in
        ready)
          notify_backend="helper"
          ;;
        busy-managed)
          remote_secure_fail "another managed headless notification session won the service-name race; refusing a competing notifications-enabled Chrome session."
          ;;
        busy-desktop)
          notify_backend="desktop"
          notify_capabilities="informational"
          remote_secure_stop_notify_process || remote_secure_fail "could not stop losing notification endpoint helper."
          ;;
        *)
          notify_error="$helper_state"
          [ -n "$notify_error" ] || notify_error="endpoint startup timed out"
          echo "remote-chrome: notifications unavailable ($notify_error); Chrome will start securely without notification forwarding." >&2
          notify_backend="unavailable"
          remote_secure_stop_notify_process || true
          ;;
      esac
    else
      notify_error="notification relay socket or Python runtime is unavailable"
      echo "remote-chrome: notifications unavailable ($notify_error); Chrome will start securely without notification forwarding." >&2
      notify_backend="unavailable"
    fi
  else
    notify_error="could not probe the source notification owner without activation"
    echo "remote-chrome: notifications unavailable ($notify_error); Chrome will start securely without notification forwarding." >&2
    notify_backend="unavailable"
  fi
fi

if [ -n "$notify_socket" ] && [ "$notify_backend" = "desktop" ]; then
  if [ -S "$notify_socket" ]; then
    notify_socket_inode="$(stat -c '%d:%i' "$notify_socket" 2>/dev/null || true)"
  fi
  notify_forwarder_script="$runtime_dir/remote-chrome-notify-forwarder-${BASHPID:-$$}.py"
  cat >"$notify_forwarder_script" <<'REMOTE_CHROME_NOTIFY_FORWARDER'
import json
import signal
import socket
import subprocess
import sys

NOTIFY_INTERFACE = "org.freedesktop.Notifications"
BUSCTL = ["busctl", "--user", "monitor", "--json=short", NOTIFY_INTERFACE]
MAX_RECORD = 1 << 20


def parse_apps(argument):
    if argument.strip() == "*":
        return None
    apps = [term.strip().lower() for term in argument.split(",") if term.strip()]
    return apps or None


def matches(app_name, apps):
    if apps is None:
        return True
    lowered = app_name.lower()
    return any(term in lowered for term in apps)


def hint(data, name):
    hints = data[6] if len(data) > 6 else None
    if not isinstance(hints, dict):
        return None
    entry = hints.get(name)
    if isinstance(entry, dict):
        return entry.get("data")
    return None


def extract(message):
    if not isinstance(message, dict):
        return None
    if message.get("type") != "method_call":
        return None
    if message.get("member") != "Notify":
        return None
    if message.get("interface") != NOTIFY_INTERFACE:
        return None
    payload = message.get("payload")
    if not isinstance(payload, dict):
        return None
    data = payload.get("data")
    if not isinstance(data, list) or len(data) < 8:
        return None
    app_name = data[0] if isinstance(data[0], str) else ""
    return {
        "app_name": app_name,
        "replaces_id": data[1] if isinstance(data[1], int) else 0,
        "summary": data[3] if isinstance(data[3], str) else "",
        "body": data[4] if isinstance(data[4], str) else "",
        "urgency": hint(data, "urgency"),
        "desktop_entry": hint(data, "desktop-entry"),
    }


def send(socket_path, blob):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(5)
        client.connect(socket_path)
        client.sendall(blob)


def main(argv):
    if len(argv) < 2 or len(argv) > 3:
        print("usage: notify-forwarder.py SOCKET [APPS]", file=sys.stderr)
        return 64
    socket_path = argv[1]
    apps = parse_apps(argv[2] if len(argv) > 2 else "chrome")

    def stop(_signum, _frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    monitor = subprocess.Popen(
        BUSCTL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        errors="replace",
    )
    unavailable = False
    try:
        for line in monitor.stdout:
            try:
                message = json.loads(line)
            except ValueError:
                continue
            record = extract(message)
            if record is None or not matches(record["app_name"], apps):
                continue
            blob = (json.dumps(record, ensure_ascii=False) + "\n").encode("utf-8")
            if len(blob) > MAX_RECORD:
                continue
            try:
                send(socket_path, blob)
                unavailable = False
            except OSError as error:
                if not unavailable:
                    print(
                        f"notify-forwarder: relay unavailable: {error}",
                        file=sys.stderr,
                    )
                    unavailable = True
    finally:
        monitor.terminate()
        try:
            monitor.wait(timeout=5)
        except subprocess.TimeoutExpired:
            monitor.kill()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
REMOTE_CHROME_NOTIFY_FORWARDER
  chmod 600 -- "$notify_forwarder_script"
  notify_forwarder_script_inode="$(stat -c '%d:%i' "$notify_forwarder_script" 2>/dev/null || true)"
  python3 "$notify_forwarder_script" "$notify_socket" "$notify_apps" 2>>"$notify_helper_log" &
  notify_process_description="notify forwarder"
  remote_notify_record_process
fi

if [ -n "$incoming_state" ] && [ -f "$incoming_state" ]; then
  incoming_notify_pending="$incoming_state.notify-$$"
  if {
    awk -F '\t' '$1 !~ /^notify_/' "$incoming_state"
    printf 'notify_backend\t%s\n' "$notify_backend"
    printf 'notify_pid\t%s\n' "$notify_pid"
    printf 'notify_starttime\t%s\n' "$notify_starttime"
    printf 'notify_capabilities\t%s\n' "$notify_capabilities"
    printf 'notify_error\t%s\n' "$notify_error"
    printf 'notify_helper_log\t%s\n' "$notify_helper_log"
    printf 'notify_status_file\t%s\n' "$notify_ready_file"
  } >"$incoming_notify_pending" && mv -fT -- "$incoming_notify_pending" "$incoming_state"; then
    chmod 600 -- "$incoming_state"
  else
    rm -f -- "$incoming_notify_pending" 2>/dev/null || true
    echo "remote-chrome: notification status could not be recorded in incoming session state." >&2
  fi
fi

export DBUS_SESSION_BUS_ADDRESS="unix:path=$proxy_socket"
if ! secret-tool lookup application "$secret_application" \
  xdg:schema "$secret_schema" >/dev/null 2>&1; then
  remote_secure_fail "Safe Storage lookup failed or was canceled; Chrome will not start and basic password storage is never allowed."
fi

# Run Chrome as a child so EXIT/signal cleanup always owns the proxy and any
# KWallet Secret Service started above. The caller's exit status is preserved.
"$chrome_command" --password-store=gnome-libsecret "$@" &
chrome_pid=$!
chrome_starttime="$(remote_secure_pid_starttime "$chrome_pid" 2>/dev/null || true)"
if [ -z "$chrome_starttime" ] && kill -0 "$chrome_pid" >/dev/null 2>&1; then
  remote_secure_fail "could not record the Chrome child PID $chrome_pid starttime; refusing unverified cleanup."
fi
if wait "$chrome_pid"; then
  chrome_status=$?
else
  chrome_status=$?
fi
chrome_pid=""
remote_secure_cleanup || true
if [ "$chrome_status" -eq 0 ] && [ "$cleanup_status" -ne 0 ]; then
  chrome_status="$cleanup_status"
fi
exit "$chrome_status"
REMOTE_CHROME_SECURE_BOOTSTRAP
}

chrome_bootstrap_script_path() {
  local session="$1"

  printf '%s/remote-chrome-%s.bootstrap.sh\n' \
    "${XDG_RUNTIME_DIR:-/tmp}" "$(safe_name "$session")"
}

chrome_prepare_bootstrap_script() {
  local session="$1"
  local script_path
  local temp_path
  local path_status=0
  local old_umask

  script_path="$(chrome_bootstrap_script_path "$session")"
  runtime_artifact_status "$script_path" || path_status=$?
  if [ "$path_status" -eq 2 ]; then
    echo "Refusing to overwrite an unsafe remote Chrome bootstrap path: $script_path" >&2
    return 1
  fi
  old_umask="$(umask)"
  umask 077
  temp_path="$(mktemp -- "${script_path}.tmp.XXXXXXXX")" || {
    umask "$old_umask"
    echo "Could not create a private temporary bootstrap script beside $script_path." >&2
    return 1
  }
  if ! chrome_secure_bootstrap_script >"$temp_path" || ! chmod 600 -- "$temp_path"; then
    runtime_artifact_status "$temp_path" && rm -f -- "$temp_path"
    umask "$old_umask"
    echo "Could not write the remote Chrome bootstrap script to $script_path." >&2
    return 1
  fi
  if [ "$path_status" -eq 1 ]; then
    if ! ln -T -- "$temp_path" "$script_path"; then
      runtime_artifact_status "$temp_path" && rm -f -- "$temp_path"
      umask "$old_umask"
      echo "Could not safely publish the remote Chrome bootstrap script to $script_path." >&2
      return 1
    fi
    rm -f -- "$temp_path"
  else
    path_status=0
    runtime_artifact_status "$script_path" || path_status=$?
    if [ "$path_status" -ne 0 ] || ! mv -fT -- "$temp_path" "$script_path"; then
      runtime_artifact_status "$temp_path" && rm -f -- "$temp_path"
      umask "$old_umask"
      echo "Could not atomically replace the remote Chrome bootstrap script at $script_path." >&2
      return 1
    fi
  fi
  umask "$old_umask"
  printf '%s\n' "$script_path"
}

chrome_remove_bootstrap_script() {
  local session="$1"
  local script_path
  local path_status=0

  script_path="$(chrome_bootstrap_script_path "$session")"
  runtime_artifact_status "$script_path" || path_status=$?
  case "$path_status" in
    1) return 0 ;;
    2)
      echo "Preserving unsafe remote Chrome bootstrap artifact: $script_path" >&2
      return 1
      ;;
  esac
  path_status=0
  runtime_artifact_status "$script_path" || path_status=$?
  [ "$path_status" -eq 0 ] || {
    echo "Remote Chrome bootstrap artifact changed before removal; preserving $script_path" >&2
    return 1
  }
  rm -f -- "$script_path"
}

chrome_validate_launch_artifacts() {
  local session="$1"
  local forwarding_expected="$2"
  local foreground="$3"
  local skip_active_socket_check="${4:-0}"
  local bootstrap_path=""
  local path_status=0
  local socket_status=0

  if [ "$foreground" != "1" ]; then
    bootstrap_path="$(chrome_bootstrap_script_path "$session")"
    runtime_artifact_status "$bootstrap_path" || path_status=$?
    if [ "$path_status" -eq 2 ]; then
      echo "Refusing to launch with an unsafe Chrome bootstrap path: $bootstrap_path" >&2
      return 1
    fi
  fi
  [ "$forwarding_expected" = "1" ] || return 0

  path_status=0
  yk_state_path_status || path_status=$?
  if [ "$path_status" -eq 2 ]; then
    echo "Refusing to launch with an unsafe YubiKey state path: $yk_state_file" >&2
    return 1
  fi
  path_status=0
  yk_log_path_status || path_status=$?
  if [ "$path_status" -eq 2 ]; then
    echo "Refusing to launch with an unsafe YubiKey log path: $yk_log_file" >&2
    return 1
  fi
  if runtime_path_present "$yk_attempt_lock" && ! runtime_owned_directory "$yk_attempt_lock"; then
    echo "Refusing to launch with an unsafe YubiKey attempt lock: $yk_attempt_lock" >&2
    return 1
  fi
  path_status=0
  runtime_artifact_status "$yk_cleanup_lock" || path_status=$?
  if [ "$path_status" -eq 2 ]; then
    echo "Refusing to launch with an unsafe YubiKey cleanup lock: $yk_cleanup_lock" >&2
    return 1
  fi
  yk_control_socket_status || socket_status=$?
  if [ "$socket_status" -eq 2 ]; then
    echo "Refusing to launch with an unsafe SSH control socket: $yk_control_socket" >&2
    return 1
  fi
  path_status=0
  yk_pid_file_status "$yk_usbipd_pid_file" || path_status=$?
  if [ "$path_status" -eq 2 ]; then
    echo "Refusing to launch with an unsafe usbipd pid path: $yk_usbipd_pid_file" >&2
    return 1
  fi
  if [ "$skip_active_socket_check" != "1" ] && [ "$socket_status" -eq 0 ]; then
    local request_code=0
    yk_ssh_request -S "$yk_control_socket" -O check "$yk_remote" >/dev/null 2>&1 || request_code=$?
    if [ "$request_code" -eq 0 ] || yk_ssh_request_incomplete "$request_code"; then
      echo "YubiKey forwarding has an active or unresponsive SSH tunnel: $yk_control_socket" >&2
      echo "Refusing to stop or replace the existing remote Chrome session." >&2
      return 1
    fi
  fi
}

chrome_origin_args=()

chrome_set_origin_metadata() {
  local host="$1" session="$2" foreground="$3"
  [ "$foreground" != "1" ] || session=""
  chrome_origin_args=(env
    "REMOTE_CHROME_ORIGIN_TARGET=$host"
    "REMOTE_CHROME_ORIGIN_SESSION=$session"
    "REMOTE_CHROME_ORIGIN_USER=$(id -un)"
    "REMOTE_CHROME_ORIGIN_NAME=$(hostname)")
}

chrome_secure_command_line() {
  local host="$1"
  local chrome_command="$2"
  local secret_application="$3"
  local secret_schema="$4"
  local notify_remote_socket="$5"
  local notify_local_socket="$6"
  local notify_apps="$7"
  local bootstrap_script="$8"
  shift 8
  local argument quoted

  local command_line="waypipe --no-gpu ssh"
  if [ -n "$notify_remote_socket" ]; then
    printf -v quoted '%q' "-R"
    command_line+=" $quoted"
    printf -v quoted '%q' "$notify_remote_socket:$notify_local_socket"
    command_line+=" $quoted"
  fi
  printf -v quoted '%q' "$host"
  command_line+=" $quoted"
  for argument in "${chrome_origin_args[@]}" bash -s -- \
    "$chrome_command" "$secret_application" "$secret_schema" \
    "$notify_remote_socket" "$notify_apps" "$@"; do
    printf -v quoted '%q' "$argument"
  command_line+=" $quoted"
  done
  # tmux may render pane_start_command with wrappers/escaping, so reset stores
  # this raw direct Waypipe command in a session-scoped user option. tmux
  # rejects a single command line over 16 KiB, and the bootstrap exceeds that,
  # so feed the frozen bootstrap from its session-scoped file over stdin
  # instead of embedding it, without eval or remote installation.
  printf -v quoted '%q' "$bootstrap_script"
  command_line+=" < $quoted"
  printf '%s\n' "$command_line"
}

chrome_tmux_command_option="@remote-chrome-command"
chrome_tmux_yubikey_option="@remote-chrome-yubikey-mode"
chrome_yubikey_mode="auto"

chrome_tmux_record_command() {
  local session="$1"
  local command_line="$2"

  if ! tmux set-option -t "=$session:" "$chrome_tmux_command_option" \
    "$command_line" >/dev/null 2>&1 ||
    ! tmux set-option -t "=$session:" "$chrome_tmux_yubikey_option" \
    "$chrome_yubikey_mode" >/dev/null 2>&1; then
    echo "Could not record the canonical Chrome command in tmux session $session." >&2
    return 1
  fi
  return 0
}

chrome_tmux_create_chrome_session() {
  local session="$1"
  local command_line="$2"

  if ! tmux new-session -d -s "$session" -n chrome bash -c "$command_line"; then
    return 1
  fi
  if ! chrome_tmux_record_command "$session" "$command_line"; then
    tmux kill-session -t "=$session" >/dev/null 2>&1 ||
      echo "Could not remove tmux session $session after canonical command recording failed." >&2
    return 1
  fi
  return 0
}

# Parse only the options that determine a detached launch's tmux target.  The
# full launch parser remains the source of truth for validation and launch
# behavior; a parse miss deliberately falls back to it unchanged.
chrome_launch_target() {
  chrome_launch_target_host=""
  chrome_launch_target_session=""
  chrome_launch_target_foreground=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session|--chrome-command|--yubikey-usb-id|--yubikey-port)
        [ "$#" -ge 2 ] || return 1
        if [ "$1" = "--session" ]; then
          chrome_launch_target_session="$2"
        fi
        shift 2
        ;;
      --session=*)
        chrome_launch_target_session="${1#*=}"
        shift
        ;;
      --chrome-command=*|--yubikey-usb-id=*|--yubikey-port=*)
        shift
        ;;
      --password-store|--password-store=*)
        # Force the full launch parser to inspect and reject this argument;
        # bare-host reset must not bypass the password-store safety gate.
        return 1
        ;;
      --foreground|--no-tmux)
        chrome_launch_target_foreground=1
        shift
        ;;
      --with-yubikey|--no-yubikey|--allow-existing|--yes|-y|--no-notifications)
        shift
        ;;
      -h|--help)
        return 1
        ;;
      --)
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --password-store|--password-store=*) return 1 ;;
          esac
          shift
        done
        break
        ;;
      -*)
        return 1
        ;;
      *)
        if [ -z "$chrome_launch_target_host" ]; then
          chrome_launch_target_host="$1"
        fi
        shift
        ;;
    esac
  done

  [ -n "$chrome_launch_target_host" ] || return 1
  [ -n "$chrome_launch_target_session" ] ||
    chrome_launch_target_session="$(chrome_default_session "$chrome_launch_target_host")"
}

# The bare HOST form is the normal day-to-day entry point.  A second explicit
# invocation means reset the exact managed session, rather than attempting to
# infer whether an old Waypipe stream still renders correctly after suspend.
chrome_ensure() {
  if ! chrome_launch_target "$@"; then
    chrome_launch "$@"
    return
  fi

  if [ "$chrome_launch_target_foreground" = "1" ]; then
    chrome_launch "$@"
    return
  fi

  need tmux
  if tmux has-session -t "=$chrome_launch_target_session" 2>/dev/null; then
    echo "Managed tmux session $chrome_launch_target_session already exists; resetting the remote Chrome/Waypipe stream." >&2
    chrome_reset "$chrome_launch_target_host" --session "$chrome_launch_target_session" --yes
    return
  fi

  chrome_launch "$@"
}

chrome_launch() {
  local host=""
  local session=""
  local foreground=0
  local yubikey_mode="auto"
  local allow_existing=0
  local assume_yes=0
  local chrome_command="${REMOTE_CHROME_COMMAND:-google-chrome-stable}"
  local chrome_args=("--ozone-platform=wayland" "--disable-gpu" "--disable-features=Vulkan" "--new-window")
  local yubikey_args=()
  local notifications=1
  local secure_script
  local command_line

  case "${REMOTE_CHROME_NOTIFICATIONS:-1}" in
    0|no|off|false|FALSE|NO|OFF) notifications=0 ;;
  esac

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session)
        [ "$#" -ge 2 ] || die "$1 requires a session name."
        session="$2"
        shift 2
        ;;
      --session=*)
        session="${1#*=}"
        shift
        ;;
      --foreground|--no-tmux)
        foreground=1
        shift
        ;;
      --chrome-command)
        [ "$#" -ge 2 ] || die "$1 requires a command."
        chrome_command="$2"
        shift 2
        ;;
      --chrome-command=*)
        chrome_command="${1#*=}"
        shift
        ;;
      --with-yubikey)
        yubikey_mode="force"
        shift
        ;;
      --no-yubikey)
        yubikey_mode="off"
        shift
        ;;
      --yubikey-usb-id)
        [ "$#" -ge 2 ] || die "$1 requires a USB id."
        yk_usb_id="$2"
        yubikey_args+=("--usb-id" "$2")
        shift 2
        ;;
      --yubikey-usb-id=*)
        yk_usb_id="${1#*=}"
        yubikey_args+=("--usb-id" "${1#*=}")
        shift
        ;;
      --yubikey-port)
        [ "$#" -ge 2 ] || die "$1 requires a port."
        yubikey_args+=("--port" "$2")
        shift 2
        ;;
      --yubikey-port=*)
        yubikey_args+=("--port" "${1#*=}")
        shift
        ;;
      --allow-existing)
        allow_existing=1
        shift
        ;;
      --no-notifications)
        notifications=0
        shift
        ;;
      --yes|-y)
        assume_yes=1
        shift
        ;;
      --password-store|--password-store=*)
        die "Do not provide --password-store; remote-chrome forces --password-store=gnome-libsecret after a Safe Storage preflight."
        ;;
      -h|--help)
        usage
        return 0
        ;;
      --)
        shift
        chrome_args+=("$@")
        break
        ;;
      -*)
        die "Unknown launch option: $1"
        ;;
      *)
        if [ -z "$host" ]; then
          host="$1"
        else
          chrome_args+=("$1")
        fi
        shift
        ;;
    esac
  done

  [ -n "$host" ] || die "Remote host is required. Example: $PROGRAM launch HOST"
  [ -n "$session" ] || session="$(chrome_default_session "$host")"
  chrome_validate_password_store_args "${chrome_args[@]}"
  chrome_secret_identity "$chrome_command" || exit 1
  chrome_yubikey_mode="$yubikey_mode"

  need ssh
  need waypipe
  chrome_preflight "$host" "$chrome_command" "$foreground" "$notifications"

  local forwarding_expected=0
  if [ "$yubikey_mode" != "off" ]; then
    yk_prepare_for_launch "$host" "${yubikey_args[@]}"
    case "$yubikey_mode" in
      force)
        forwarding_expected=1
        echo "YubiKey forwarding was requested for $host."
        ;;
      auto)
        if yk_local_candidate_exists; then
          forwarding_expected=1
          echo "Detected local YubiKey $yk_usb_id; forwarding is expected."
        else
          echo "No local YubiKey with USB id $yk_usb_id detected; continuing without forwarding."
        fi
        ;;
    esac
  else
    echo "YubiKey forwarding disabled by --no-yubikey."
  fi

  # Validate every runtime destination before any USB setup or any action that
  # may stop an existing browser. A dangling symlink is an existing unsafe
  # artifact, just like a symlink with a live target.
  chrome_validate_launch_artifacts "$session" "$forwarding_expected" "$foreground" ||
    die "Unsafe or active runtime artifact prevents launching $session."

  # Check launch ownership before inspecting or mutating remote Chrome.  A
  # previous tmux session or managed/provisional YubiKey state means this
  # launch is a duplicate and must abort without touching the browser.
  if [ "$foreground" != "1" ]; then
    need tmux
    if tmux has-session -t "=$session" 2>/dev/null; then
      die "tmux session already exists: $session"
    fi
  fi
  if [ "$forwarding_expected" = "1" ] && runtime_path_present "$yk_state_file"; then
    local reconcile_code=0
    yk_reconcile_cleanup_failed || reconcile_code=$?
    case "$reconcile_code" in
      0) ;;
      1)
        die "YubiKey forwarding still has an active or incomplete attempt for $yk_remote; retry stop before launching."
        ;;
      *)
        die "YubiKey cleanup state for $yk_remote could not be reconciled safely; retry stop and inspect $yk_state_file."
        ;;
    esac
  fi
  if [ "$forwarding_expected" = "1" ] &&
    { runtime_path_present "$yk_state_file" || runtime_path_present "$yk_attempt_lock"; }; then
    die "YubiKey forwarding already has an active or provisional attempt for $yk_remote; stop it before launching again."
  fi

  # Complete forwarding preflight before checking/killing an existing remote
  # Chrome, so a local or remote module failure cannot disturb browser state.
  if [ "$forwarding_expected" = "1" ]; then
    yk_preflight_for_forwarding 1
  fi
  chrome_handle_existing "$host" "$chrome_command" "$allow_existing" "$assume_yes" "$foreground"

  secure_script="$(chrome_secure_bootstrap_script)"
  chrome_set_origin_metadata "$host" "$session" "$foreground"
  notify_remote_socket=""
  notify_local_socket=""
  notify_apps=""
  if [ "$notifications" = "1" ]; then
    notify_prepare_session "$session" "$host"
  fi
  local -a command=(waypipe --no-gpu ssh)
  if [ -n "$notify_remote_socket" ]; then
    command+=(-R "$notify_remote_socket:$notify_local_socket")
  fi
  command+=("$host" "${chrome_origin_args[@]}" bash -s -- "$chrome_command" "$chrome_secret_application" \
    "$chrome_secret_schema" "$notify_remote_socket" "$notify_apps" "${chrome_args[@]}")
  if [ "$foreground" = "1" ]; then
    if [ -n "$notify_local_socket" ]; then
      notify_start_listener ||
        echo "remote-chrome notify: listener start failed; notifications are not forwarded." >&2
    fi
    if [ "$forwarding_expected" = "1" ]; then
      # Install cleanup traps before setup so Ctrl-C during module loading,
      # tunnel creation, attach, or readiness polling cannot leak resources.
      trap 'notify_stop_listener; yk_cleanup; exit 130' INT
      trap 'notify_stop_listener; yk_cleanup; exit 143' TERM
      trap 'notify_stop_listener; yk_cleanup; exit 129' HUP
      trap 'notify_stop_listener; yk_cleanup' EXIT
      yk_start
      local code=0
      if "${command[@]}" <<<"$secure_script"; then
        code=$?
      else
        code=$?
      fi
      yk_stop
      trap - EXIT INT TERM HUP
      notify_stop_listener "$host"
      return "$code"
    fi
    if [ -n "$notify_local_socket" ]; then
      trap 'notify_stop_listener' EXIT INT TERM HUP
      local code=0
      if "${command[@]}" <<<"$secure_script"; then
        code=$?
      else
        code=$?
      fi
      trap - EXIT INT TERM HUP
      notify_stop_listener "$host"
      return "$code"
    fi
    exec "${command[@]}" <<<"$secure_script"
  fi

  if [ -n "$notify_local_socket" ]; then
    trap 'notify_stop_listener' EXIT
    notify_start_listener ||
      echo "remote-chrome notify: listener start failed; notifications are not forwarded." >&2
  fi
  local bootstrap_script
  bootstrap_script="$(chrome_prepare_bootstrap_script "$session")" ||
    die "Could not prepare the remote Chrome bootstrap script for $host."
  command_line="$(chrome_secure_command_line "$host" "$chrome_command" \
    "$chrome_secret_application" "$chrome_secret_schema" "$notify_remote_socket" \
    "$notify_local_socket" "$notify_apps" "$bootstrap_script" "${chrome_args[@]}")"
  if [ "$forwarding_expected" = "1" ]; then
    chrome_launch_detached_with_yubikey "$host" "$session" "$command_line" "${yubikey_args[@]}"
  else
    if ! chrome_tmux_create_chrome_session "$session" "$command_line"; then
      chrome_remove_bootstrap_script "$session" || true
      die "Could not create a reset-safe Chrome tmux session on $host."
    fi
  fi
  trap - EXIT

  echo "Started remote Chrome on $host in tmux session $session."
  if [ "$forwarding_expected" = "1" ]; then
    echo "YubiKey forwarding is ready in tmux window ${session}:yubikey."
  fi
  print_command_hint "Attach:" "$PROGRAM" attach "$host" --session "$session"
  print_command_hint "Status:" "$PROGRAM" status "$host" --session "$session"
  print_command_hint "Stop:" "$PROGRAM" stop "$host" --session "$session"
}

confirm() {
  local prompt="$1"
  local reply

  printf '%s [y/N] ' "$prompt" >&2
  read -r reply
  case "$reply" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

chrome_preflight() {
  local host="$1"
  local chrome_command="$2"
  local foreground="$3"
  local notifications="$4"
  local quoted_chrome_command
  local remote_requirements
  local python_requirement=""

  if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    die "No local Wayland/X display variables found. Run from a graphical session."
  fi

  if [ "$notifications" = "1" ]; then
    need python3
    python_requirement=" && command -v python3 >/dev/null"
  fi

  printf -v quoted_chrome_command '%q' "$chrome_command"
  remote_requirements="command -v bash >/dev/null && command -v waypipe >/dev/null && command -v xdg-dbus-proxy >/dev/null && command -v secret-tool >/dev/null && command -v ksecretd >/dev/null && command -v busctl >/dev/null$python_requirement && command -v $quoted_chrome_command >/dev/null"
  if [ "$foreground" = "0" ]; then
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "$remote_requirements" ||
      die "Detached launch needs noninteractive SSH to $host plus remote bash, waypipe, xdg-dbus-proxy, secret-tool, ksecretd, busctl, and $chrome_command."
  else
    ssh -o ConnectTimeout=5 "$host" "$remote_requirements" ||
      die "Secure launch needs remote bash, waypipe, xdg-dbus-proxy, secret-tool, ksecretd, busctl, and $chrome_command on $host."
  fi
}

chrome_process_pattern() {
  local chrome_command="$1"
  local command_name="${chrome_command##*/}"
  local escaped_name

  [ -n "$command_name" ] || die "Chrome command must not be empty."
  case "$command_name" in
    *[![:alnum:]_.+-]*)
      die "Chrome command must be an executable path or name without shell syntax: $chrome_command"
      ;;
  esac

  escaped_name="${command_name//./\\.}"
  escaped_name="${escaped_name//+/\\+}"
  printf '(^|/)(google-chrome|google-chrome-stable|chrome|%s)( |$)\n' "$escaped_name"
}

chrome_existing_processes() {
  local host="$1"
  local chrome_command="$2"
  local process_pattern
  process_pattern="$(chrome_process_pattern "$chrome_command")"

  ssh -o BatchMode=yes "$host" "
    pgrep -u \"\$(id -u)\" -af '$process_pattern' 2>/dev/null |
      grep -v -- --type= |
      grep -v chrome_crashpad_handler ||
      true
  "
}

chrome_kill_existing() {
  local host="$1"
  local chrome_command="$2"
  local process_pattern
  process_pattern="$(chrome_process_pattern "$chrome_command")"

  ssh -o BatchMode=yes "$host" "
    pkill -u \"\$(id -u)\" -f '$process_pattern' || true
  "
}

chrome_handle_existing() {
  local host="$1"
  local chrome_command="$2"
  local allow_existing="$3"
  local assume_yes="$4"
  local foreground="$5"
  local existing

  if ! existing="$(chrome_existing_processes "$host" "$chrome_command")"; then
    if [ "$foreground" = "1" ]; then
      echo "Could not check for existing remote Chrome processes; continuing in foreground mode." >&2
      return 0
    fi
    die "Could not check for existing remote Chrome processes on $host."
  fi
  [ -n "$existing" ] || return 0

  if [ "$allow_existing" = "1" ]; then
    return 0
  fi

  printf 'Remote Chrome appears to be running on %s:\n%s\n' "$host" "$existing" >&2
  if [ "$assume_yes" = "1" ] || confirm "Kill existing remote Chrome processes before launching?"; then
    chrome_kill_existing "$host" "$chrome_command"
    return 0
  fi

  cat >&2 <<EOF
Canceled. The existing remote Chrome process still owns the profile.
Use --allow-existing only if you know the existing process uses a different
user-data-dir.
EOF
  exit 1
}

# Remote notification relay helpers.  The relay is per managed tmux session: a
# local listener receives JSON records from an ssh -R streamlocal forward and
# re-emits them through the local notification daemon.  The relay is advisory
# only; failures disable local popups but never block or change a launch.
notify_state_file=""
notify_log_file=""
notify_local_socket=""
notify_remote_socket=""
notify_apps=""
notify_token=""
notify_session=""
notify_host=""

notify_set_runtime_paths() {
  local session="$1"
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"

  notify_state_file="$runtime_dir/remote-chrome-notify-$(safe_name "$session").state"
  notify_log_file="${notify_state_file}.log"
}

notify_prepare_session() {
  local session="$1"
  local host="$2"

  notify_set_runtime_paths "$session"
  notify_session="$session"
  notify_host="$host"
  notify_token="${BASHPID:-$$}.${RANDOM}.${SECONDS}"
  notify_local_socket="${XDG_RUNTIME_DIR:-/tmp}/remote-chrome-notify-${notify_token}.sock"
  notify_remote_socket="/tmp/remote-chrome-notify-${notify_token}.sock"
  notify_apps="${REMOTE_CHROME_NOTIFICATION_APPS:-chrome}"
  # Keep the value representable in the tab-separated state file.
  notify_apps="${notify_apps//$'\t'/}"
  notify_apps="${notify_apps//$'\n'/}"
  notify_apps="${notify_apps//$'\r'/}"
}

notify_load_state() {
  local state_file="$1"

  notify_state_file="$state_file"
  notify_log_file="${state_file}.log"
  notify_local_socket="$(notify_state_field "$state_file" local_socket)"
  notify_remote_socket="$(notify_state_field "$state_file" remote_socket)"
  notify_apps="$(notify_state_field "$state_file" apps)"
  notify_session="$(notify_state_field "$state_file" session)"
  notify_host="$(notify_state_field "$state_file" host)"
}

notify_state_field() {
  local state_file="$1"
  local field="$2"

  awk -F '\t' -v key="$field" '$1 == key {print $2; exit}' "$state_file" 2>/dev/null || true
}

notify_pid_starttime() {
  local pid="$1"
  local stat_line rest
  local -a fields=()

  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  IFS= read -r stat_line <"/proc/$pid/stat" 2>/dev/null || return 1
  rest="${stat_line##*) }"
  [ "$rest" != "$stat_line" ] || return 1
  read -r -a fields <<<"$rest"
  [ "${#fields[@]}" -ge 20 ] || return 1
  printf '%s\n' "${fields[19]}"
}

notify_remove_remote_socket() {
  local host="$1"
  local socket_path="$2"
  local quoted

  [ -n "$host" ] || return 0
  [ -n "$socket_path" ] || return 0
  printf -v quoted '%q' "$socket_path"
  # Socket removal is advisory. Bound the whole request so a stalled peer
  # cannot prevent the remaining session and USB/IP cleanup from running.
  timeout --kill-after=1 2 ssh -o BatchMode=yes -o ConnectTimeout=2 \
    -o ConnectionAttempts=1 "$host" "rm -f -- $quoted" \
    </dev/null >/dev/null 2>&1 || true
}

notify_stop_process() {
  local listener_pid="$1"
  local listener_starttime="$2"
  local attempt current_starttime

  if [ -n "$listener_pid" ] && kill -0 "$listener_pid" 2>/dev/null; then
    current_starttime="$(notify_pid_starttime "$listener_pid" 2>/dev/null || true)"
    if [ -n "$listener_starttime" ] && [ "$current_starttime" = "$listener_starttime" ]; then
      kill "$listener_pid" 2>/dev/null || true
      for ((attempt = 0; attempt < 20; attempt++)); do
        kill -0 "$listener_pid" 2>/dev/null || break
        current_starttime="$(notify_pid_starttime "$listener_pid" 2>/dev/null || true)"
        [ "$current_starttime" = "$listener_starttime" ] || return 0
        sleep 0.1
      done
      if kill -0 "$listener_pid" 2>/dev/null; then
        current_starttime="$(notify_pid_starttime "$listener_pid" 2>/dev/null || true)"
        if [ "$current_starttime" = "$listener_starttime" ]; then
          kill -KILL "$listener_pid" 2>/dev/null || return 0
        else
          return 0
        fi
      fi
      # Reap a startup child when called by its parent; loaded listeners may
      # belong to another shell, in which case wait simply fails.
      wait "$listener_pid" 2>/dev/null || true
    else
      echo "remote-chrome notify: listener PID $listener_pid identity changed; preserving the replacement process." >&2
    fi
  fi
  return 0
}

notify_stop_state_file() {
  local state_file="$1"
  local host="$2"
  local listener_pid listener_starttime local_socket remote_socket

  [[ -f "$state_file" && -O "$state_file" && ! -L "$state_file" ]] || return 0
  [ -n "$host" ] || host="$(notify_state_field "$state_file" host)"
  listener_pid="$(notify_state_field "$state_file" listener_pid)"
  listener_starttime="$(notify_state_field "$state_file" listener_starttime)"
  local_socket="$(notify_state_field "$state_file" local_socket)"
  remote_socket="$(notify_state_field "$state_file" remote_socket)"
  notify_stop_process "$listener_pid" "$listener_starttime"

  if [[ -S "$local_socket" && -O "$local_socket" && ! -L "$local_socket" ]]; then
    rm -f -- "$local_socket" 2>/dev/null || true
  fi
  if [[ -f "${state_file}.log" && -O "${state_file}.log" && ! -L "${state_file}.log" ]]; then
    rm -f -- "${state_file}.log" 2>/dev/null || true
  fi
  rm -f -- "$state_file" 2>/dev/null || true
  notify_remove_remote_socket "$host" "$remote_socket"
  return 0
}

notify_stop_listener() {
  local host="${1:-${notify_host:-}}"

  [ -n "$notify_state_file" ] || return 0
  notify_stop_state_file "$notify_state_file" "$host"
}

notify_stop_all() {
  local runtime_dir state_file
  runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"

  for state_file in "$runtime_dir"/remote-chrome-notify-*.state; do
    [[ -f "$state_file" && -O "$state_file" && ! -L "$state_file" ]] || continue
    notify_stop_state_file "$state_file" "$(notify_state_field "$state_file" host)"
  done
}

notify_start_listener() {
  local self pid starttime attempt pending_state pending_log candidate

  [ -n "$notify_local_socket" ] || return 0
  if ! command -v python3 >/dev/null 2>&1; then
    echo "remote-chrome notify: python3 is required to forward notifications; notifications are not forwarded." >&2
    return 1
  fi
  for candidate in "$notify_state_file" "$notify_log_file"; do
    if { [ -e "$candidate" ] || [ -L "$candidate" ]; } &&
       ! [[ -f "$candidate" && -O "$candidate" && ! -L "$candidate" ]]; then
      echo "remote-chrome notify: could not record listener state: refusing unowned or non-regular artifact $candidate." >&2
      return 1
    fi
  done
  notify_stop_listener "${notify_host:-}"
  pending_log="$(mktemp -- "${notify_log_file}.tmp.XXXXXX")" || return 1
  if ! mv -fT -- "$pending_log" "$notify_log_file"; then
    rm -f -- "$pending_log" 2>/dev/null || true
    return 1
  fi
  self="$(script_path)"
  nohup "$self" _notify-listener "$notify_local_socket" "$notify_log_file" \
    </dev/null >/dev/null 2>&1 &
  pid=$!
  starttime="$(notify_pid_starttime "$pid" 2>/dev/null || true)"
  if [ -z "$starttime" ]; then
    kill "$pid" 2>/dev/null || true
    echo "remote-chrome notify: could not record listener PID $pid starttime; notifications are not forwarded." >&2
    return 1
  fi
  for ((attempt = 0; attempt < 50; attempt++)); do
    [ -S "$notify_local_socket" ] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if [ ! -S "$notify_local_socket" ]; then
    notify_stop_process "$pid" "$starttime"
    echo "remote-chrome notify: listener did not create $notify_local_socket (see $notify_log_file); notifications are not forwarded." >&2
    return 1
  fi
  pending_state="$(mktemp -- "${notify_state_file}.tmp.XXXXXX")" || pending_state=""
  if [ -z "$pending_state" ] || ! (
    umask 077
    {
      printf 'listener_pid\t%s\n' "$pid"
      printf 'listener_starttime\t%s\n' "$starttime"
      printf 'local_socket\t%s\n' "$notify_local_socket"
      printf 'remote_socket\t%s\n' "$notify_remote_socket"
      printf 'apps\t%s\n' "$notify_apps"
      printf 'session\t%s\n' "$notify_session"
      printf 'host\t%s\n' "$notify_host"
    } >"$pending_state"
  ) || ! mv -fT -- "$pending_state" "$notify_state_file"; then
    [ -z "$pending_state" ] || rm -f -- "$pending_state" 2>/dev/null || true
    # State was never committed, so roll back using the identity captured when
    # spawning the child instead of trying to reload a missing state file.
    notify_stop_process "$pid" "$starttime"
    rm -f -- "$notify_local_socket" "$notify_log_file" 2>/dev/null || true
    echo "remote-chrome notify: could not record listener state in $notify_state_file; notifications are not forwarded." >&2
    return 1
  fi
  chmod 600 -- "$notify_state_file" 2>/dev/null || true
  return 0
}

chrome_stop_from_source() {
  local source="$1"
  local host="$2"
  local session="$3"
  local request_only="${4:-0}"
  local connect_timeout=5
  local -a stop_args=(stop)
  local remote_command
  local -a ssh_command=(ssh)
  command -v ssh >/dev/null || { echo "Missing cleanup command: ssh" >&2; return 1; }
  if [ "$request_only" = "1" ]; then
    command -v timeout >/dev/null || { echo "Missing cleanup command: timeout" >&2; return 1; }
    # Bound only the best-effort request. Accepted USB/IP cleanup runs on the
    # display host independently, so a slow detach does not block this desktop.
    connect_timeout=2
    ssh_command=(timeout --foreground 2 ssh)
  fi

  [ -n "$host" ] && stop_args+=("$host")
  [ -n "$session" ] && stop_args+=(--session "$session")
  # SSH joins its command arguments into a shell command. Quote each value
  # once before sending it so host/session names remain literal arguments.
  remote_command="$(quote_command bash -s -- "$request_only" "${stop_args[@]}")"
  "${ssh_command[@]}" -o BatchMode=yes -o "ConnectTimeout=$connect_timeout" -o ConnectionAttempts=1 \
    "$source" "$remote_command" <<'REMOTE_CHROME_SOURCE_STOP'
set -euo pipefail
request_only="$1"
shift
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
launcher="$(command -v remote-chrome || true)"
if [ -z "$launcher" ] && [ -x "$HOME/.local/bin/remote-chrome" ]; then
  launcher="$HOME/.local/bin/remote-chrome"
fi
if [ -z "$launcher" ]; then
  echo "remote-chrome is not installed on the forwarding host; install it before using stop --from." >&2
  exit 1
fi
if [ "$request_only" = "1" ]; then
  # Release the SSH channel immediately, but let the existing cleanup finish.
  # Failed cleanup keeps its normal USB/IP recovery state for a later stop.
  nohup "$launcher" "$@" </dev/null >/dev/null 2>&1 &
else
  exec "$launcher" "$@"
fi
REMOTE_CHROME_SOURCE_STOP
}

chrome_incoming_live() {
  local state="$1" pid starttime boot_id process_stat
  pid="$(notify_state_field "$state" pid)"
  starttime="$(notify_state_field "$state" starttime)"
  boot_id="$(notify_state_field "$state" boot_id)"
  [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
  [[ "$starttime" =~ ^[0-9]+$ ]] || return 1
  [ "$boot_id" = "$(cat /proc/sys/kernel/random/boot_id)" ] || return 1
  IFS= read -r process_stat 2>/dev/null <"/proc/$pid/stat" || return 1
  case "${process_stat##*) }" in Z\ *|X\ *) return 1 ;; esac
  [ "$(notify_pid_starttime "$pid" 2>/dev/null || true)" = "$starttime" ]
}

chrome_status_incoming() {
  local state found=0 phase name session
  echo "Incoming remote-chrome sessions:"
  for state in "${XDG_RUNTIME_DIR:-/tmp}"/remote-chrome-incoming-*.state; do
    [[ -f "$state" && -O "$state" && ! -L "$state" ]] || continue
    found=1
    phase=stale
    chrome_incoming_live "$state" && phase=live
    name="$(notify_state_field "$state" name)"
    session="$(notify_state_field "$state" session)"
    printf '  %s: %s (%s)\n' "${name:-$(notify_state_field "$state" peer)}" \
      "${session:-foreground}" "$phase"
    notify_source_state_status "$state" || true
  done
  [ "$found" = "1" ] || echo "  none"
}

notify_helper_live() {
  local pid="$1" starttime="$2" parent="$3" process_stat command_line first
  local -a process_fields=()
  [[ "$pid" =~ ^[0-9]+$ && "$starttime" =~ ^[0-9]+$ ]] || return 1
  IFS= read -r process_stat 2>/dev/null <"/proc/$pid/stat" || return 1
  case "${process_stat##*) }" in Z\ *|X\ *) return 1 ;; esac
  [ "$(notify_pid_starttime "$pid" 2>/dev/null || true)" = "$starttime" ] || return 1
  read -r -a process_fields <<<"${process_stat##*) }"
  [ "${process_fields[1]:-}" = "$parent" ] || return 1
  command_line="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
  first="${command_line%% *}"
  [ "${first##*/}" = "python3" ]
}

notify_source_state_status() {
  local state="$1" backend pid birth parent capabilities error owner_pid
  backend="$(notify_state_field "$state" notify_backend)"
  if [ -z "$backend" ]; then
    echo "  notifications: backend=unreported (older bootstrap; reset to select the new endpoint)"
    return 0
  fi
  pid="$(notify_state_field "$state" notify_pid)"
  birth="$(notify_state_field "$state" notify_starttime)"
  parent="$(notify_state_field "$state" pid)"
  capabilities="$(notify_state_field "$state" notify_capabilities)"
  error="$(notify_state_field "$state" notify_error)"
  printf '  notifications: backend=%s capabilities=%s helper-pid=%s\n' \
    "$backend" "${capabilities:-none}" "${pid:-none}"
  case "$backend" in
    disabled) return 0 ;;
    unavailable)
      printf '  notifications: transport=unavailable reason=%s\n' "${error:-setup failed}"
      return 1
      ;;
    helper|desktop)
      if ! chrome_incoming_live "$state" || ! notify_helper_live "$pid" "$birth" "$parent"; then
        echo "  notifications: transport=degraded (owned helper identity is no longer live)"
        return 1
      fi
      owner_pid="$(busctl --user --timeout=0.35 call org.freedesktop.DBus \
        /org/freedesktop/DBus org.freedesktop.DBus GetConnectionUnixProcessID \
        s org.freedesktop.Notifications 2>/dev/null | awk '$1 == "u" {print $2}')"
      if [ "$backend" = "helper" ]; then
        if [ "$owner_pid" != "$pid" ]; then
          echo "  notifications: transport=degraded (service name is no longer owned by this helper)"
          return 1
        fi
        echo "  notifications: transport=ready callbacks=actions,closed ownership=verified"
      else
        if ! [[ "$owner_pid" =~ ^[0-9]+$ ]]; then
          echo "  notifications: transport=degraded (existing daemon has no current owner)"
          return 1
        fi
        echo "  notifications: transport=monitoring callbacks=none ownership=existing-daemon"
      fi
      ;;
    *) echo "  notifications: transport=unknown"; return 1 ;;
  esac
}

notify_source_status() {
  local session="$1" state found=0 code=0
  for state in "${XDG_RUNTIME_DIR:-/tmp}"/remote-chrome-incoming-*.state; do
    [[ -f "$state" && -O "$state" && ! -L "$state" ]] || continue
    [ "$(notify_state_field "$state" session)" = "$session" ] || continue
    found=1
    notify_source_state_status "$state" || code=1
  done
  if [ "$found" = "0" ]; then
    echo "  notifications: source session is untracked or no longer running"
    return 1
  fi
  return "$code"
}

notify_status_current() {
  local host="$1" session="$2" state pid birth socket output failure
  notify_set_runtime_paths "$session"
  state="$notify_state_file"
  if [ ! -e "$state" ]; then
    echo "status: notifications: no managed relay (disabled or untracked)"
    return 0
  fi
  [[ -f "$state" && -O "$state" && ! -L "$state" ]] || {
    echo "status: degraded: notification state ownership is invalid." >&2
    return 1
  }
  pid="$(notify_state_field "$state" listener_pid)"
  birth="$(notify_state_field "$state" listener_starttime)"
  socket="$(notify_state_field "$state" local_socket)"
  if ! kill -0 "$pid" 2>/dev/null ||
    [ "$(notify_pid_starttime "$pid" 2>/dev/null || true)" != "$birth" ] || [ ! -S "$socket" ]; then
    echo "status: degraded: notification listener identity/socket is no longer live." >&2
    return 1
  fi
  echo "status: notifications: listener live pid=$pid"
  if output="$(timeout --kill-after=1 2 ssh -o BatchMode=yes -o ConnectTimeout=2 \
    -o ConnectionAttempts=1 "$host" \
    "remote-chrome _notify-status $(printf '%q' "$session")" </dev/null 2>&1)"; then
    printf '%s\n' "$output"
  else
    printf '%s\n' "$output" >&2
    echo "status: degraded: source notification path is unavailable; reset the exact session." >&2
    return 1
  fi
  failure="$(awk -F '\t' '$2 ~ /^(delivery-failed|interactive-disconnected|interactive-client-failed)$/ {last=$0} END {print last}' "${state}.log" 2>/dev/null || true)"
  [ -z "$failure" ] || printf 'status: notifications: recent failure: %s\n' "$failure"
}

chrome_stop_incoming() {
  local state pid peer name source user session target attempt code=0
  for state in "${XDG_RUNTIME_DIR:-/tmp}"/remote-chrome-incoming-*.state; do
    [[ -f "$state" && -O "$state" && ! -L "$state" ]] || continue
    if ! chrome_incoming_live "$state"; then
      rm -f -- "$state" || code=1
      continue
    fi
    pid="$(notify_state_field "$state" pid)"
    peer="$(notify_state_field "$state" peer)"
    name="$(notify_state_field "$state" name)"
    source="$peer"
    # The hostname preserves SSH config and known-hosts entries; the peer IP
    # is a fallback when the originating launcher did not provide a name.
    if [[ "$name" =~ ^[[:alnum:]_.:%-]+$ ]] && [[ "$name" != -* ]]; then
      source="$name"
    fi
    user="$(notify_state_field "$state" user)"
    session="$(notify_state_field "$state" session)"
    target="$(notify_state_field "$state" target)"
    if [[ "$source" =~ ^[[:alnum:]_.:%-]+$ ]] && [[ "$source" != -* ]] &&
      [[ "$user" =~ ^[[:alnum:]_][[:alnum:]_.-]*$ ]] &&
      [ -n "$session" ] && [ -n "$target" ] && [[ "$target" != -* ]]; then
      if ! chrome_stop_from_source "$user@$source" "$target" "$session" 1; then
        echo "Display host cleanup unavailable for $peer; releasing the incoming browser locally." >&2
      fi
    fi
    # Recheck the recorded PID/start time after SSH; a stale record must never
    # signal a replacement process. TERM runs the bootstrap's owned cleanup.
    if chrome_incoming_live "$state"; then
      kill -TERM "$pid" 2>/dev/null || true
      for ((attempt = 0; attempt < 50; attempt++)); do
        chrome_incoming_live "$state" || break
        sleep 0.1
      done
    fi
    if chrome_incoming_live "$state"; then
      echo "Incoming browser from $peer is still shutting down; retry stop." >&2
      code=1
    else
      rm -f -- "$state" || code=1
      echo "Released incoming remote-chrome session from $peer."
    fi
  done
  return "$code"
}

chrome_stop() {
  local host=""
  local session=""
  local source=""
  local source_requested=0
  local code=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --from)
        [ "$#" -ge 2 ] || die "$1 requires a forwarding host."
        source="$2"
        source_requested=1
        shift 2
        ;;
      --from=*)
        source="${1#*=}"
        source_requested=1
        shift
        ;;
      --session)
        [ "$#" -ge 2 ] || die "$1 requires a session name."
        session="$2"
        shift 2
        ;;
      --session=*)
        session="${1#*=}"
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      -*)
        die "Unknown stop option: $1"
        ;;
      *)
        [ -z "$host" ] || die "Unexpected argument: $1"
        host="$1"
        shift
        ;;
    esac
  done

  if [ "$source_requested" = "1" ]; then
    if [ -z "$source" ] || [[ "$source" == -* ]]; then
      die "--from requires an SSH forwarding host (for example starship)."
    fi
    chrome_stop_from_source "$source" "$host" "$session"
    return
  fi

  if [ -z "$host" ] && [ -z "$session" ]; then
    chrome_stop_all
    return
  fi

  [ -n "$session" ] || {
    [ -n "$host" ] || die "Host or --session is required."
    session="$(chrome_default_session "$host")"
  }

  need tmux
  if tmux has-session -t "=$session" 2>/dev/null; then
    if tmux kill-session -t "=$session"; then
      echo "Stopped tmux session $session."
      chrome_remove_bootstrap_script "$session" || code=1
    else
      echo "Could not stop tmux session $session." >&2
      code=1
    fi
  else
    echo "tmux session not found: $session" >&2
    chrome_remove_bootstrap_script "$session" || code=1
  fi

  notify_set_runtime_paths "$session"
  notify_stop_listener "$host" || code=1

  if [ -n "$host" ]; then
    yk_prepare_for_launch "$host"
    if ! yk_stop; then
      echo "YubiKey cleanup reported an error; inspect $yk_state_file." >&2
      code=1
    fi
  fi
  return "$code"
}

chrome_managed_sessions() {
  local session
  local prefix="${REMOTE_CHROME_SESSION_PREFIX:-remote-chrome}"

  while IFS= read -r session; do
    case "$session" in
      "$prefix"-*) printf '%s\n' "$session" ;;
    esac
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
}

chrome_stop_all() {
  local session
  local stopped_sessions=0
  local code=0

  need tmux
  while IFS= read -r session; do
    [ -n "$session" ] || continue
    if tmux kill-session -t "=$session"; then
      echo "Stopped tmux session $session."
      chrome_remove_bootstrap_script "$session" || code=1
      stopped_sessions=$((stopped_sessions + 1))
    else
      echo "Could not stop tmux session $session." >&2
      code=1
    fi
  done < <(chrome_managed_sessions)

  if [ "$stopped_sessions" = "0" ]; then
    echo "No managed remote-chrome tmux sessions found."
  fi

  if ! yk_stop_all; then
    code=1
  fi
  notify_stop_all || code=1
  chrome_stop_incoming || code=1
  return "$code"
}

chrome_attach() {
  local host=""
  local session=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session)
        [ "$#" -ge 2 ] || die "$1 requires a session name."
        session="$2"
        shift 2
        ;;
      --session=*)
        session="${1#*=}"
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      -*)
        die "Unknown attach option: $1"
        ;;
      *)
        [ -z "$host" ] || die "Unexpected argument: $1"
        host="$1"
        shift
        ;;
    esac
  done

  [ -n "$session" ] || {
    [ -n "$host" ] || die "Host or --session is required."
    session="$(chrome_default_session "$host")"
  }

  need tmux
  tmux has-session -t "=$session" 2>/dev/null ||
    die "tmux session not found: $session"

  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}

chrome_reset_pane_id=""
chrome_reset_pane_pid=""
chrome_reset_pane_command=""
chrome_reset_host=""
chrome_reset_remote_socket=""
chrome_reset_remote_pgid=""
chrome_reset_remote_pid=""
chrome_reset_remote_starttime=""
chrome_reset_remote_boot_id=""
chrome_reset_remote_browser_allowlist=()

chrome_reset_read_pane() {
  local session="$1"
  local pane_output=""
  local line_count=0
  local pane_line
  local pane_start_command=""
  local canonical_command=""
  local yubikey_mode=""
  chrome_reset_pane_command=""
  chrome_yubikey_mode="auto"

  # tmux can replace control characters in formats with underscores. Use a
  # printable separator; the final read variable retains command separators.
  if ! pane_output="$(tmux list-panes -t "=$session:=chrome" \
    -F '#{pane_id}|#{pane_pid}|#{pane_start_command}' 2>&1)"; then
    [ -n "$pane_output" ] && printf '%s\n' "$pane_output" >&2
    echo "Could not inspect the exact chrome pane in tmux session $session." >&2
    return 1
  fi
  while IFS= read -r pane_line; do
    [ -n "$pane_line" ] || continue
    line_count=$((line_count + 1))
    [ "$line_count" -eq 1 ] || break
    IFS='|' read -r chrome_reset_pane_id chrome_reset_pane_pid \
      pane_start_command <<<"$pane_line"
  done <<<"$pane_output"
  if [ "$line_count" -ne 1 ] ||
    [ -z "$chrome_reset_pane_id" ] ||
    [[ ! "$chrome_reset_pane_pid" =~ ^[0-9]+$ ]] ||
    [ -z "$pane_start_command" ]; then
    echo "The $session:chrome window must contain exactly one readable pane with a start command." >&2
    return 1
  fi

  if canonical_command="$(tmux show-options -qv -t "=$session:" \
    "$chrome_tmux_command_option" 2>/dev/null)" && [ -n "$canonical_command" ]; then
    chrome_reset_pane_command="$canonical_command"
  elif [[ "$pane_start_command" == waypipe[[:space:]]--no-gpu[[:space:]]ssh[[:space:]]* ]]; then
    # Pre-1.3 sessions stored the direct command in pane_start_command.  Do
    # not attempt to decode a newly wrapped `bash -c` pane command.
    chrome_reset_pane_command="$pane_start_command"
  else
    echo "The $session:chrome pane has no canonical remote-chrome command option; refusing reset." >&2
    return 1
  fi
  if ! yubikey_mode="$(tmux show-options -qv -t "=$session:" \
    "$chrome_tmux_yubikey_option" 2>/dev/null)"; then
    echo "Could not read YubiKey mode for tmux session $session; refusing reset." >&2
    return 1
  fi
  case "$yubikey_mode" in
    "") ;; # Older sessions did not record the mode; retain legacy auto behavior.
    auto|force|off) chrome_yubikey_mode="$yubikey_mode" ;;
    *)
      echo "Invalid recorded YubiKey mode for tmux session $session; refusing reset." >&2
      return 1
      ;;
  esac
  return 0
}

chrome_reset_parse_pane_host() {
  local command_line="$1"
  local remainder token argument

  if [[ ! "$command_line" =~ ^waypipe[[:space:]]+--no-gpu[[:space:]]+ssh[[:space:]]+(.*)$ ]]; then
    echo "The chrome pane is not a managed waypipe SSH command; refusing reset." >&2
    return 1
  fi
  chrome_reset_host=""
  remainder="${BASH_REMATCH[1]}"
  # SSH options (including the optional -R notification forward) precede the
  # destination; skip them before taking the first non-option token as host.
  while [ -n "$remainder" ]; do
    token="${remainder%%[[:space:]]*}"
    remainder="${remainder#"$token"}"
    remainder="${remainder#"${remainder%%[![:space:]]*}"}"
    case "$token" in
      -R|-L|-D|-o|-p|-l|-i|-J|-F|-E|-b|-c|-m|-O|-Q|-S|-w|-W)
        argument="${remainder%%[[:space:]]*}"
        remainder="${remainder#"$argument"}"
        remainder="${remainder#"${remainder%%[![:space:]]*}"}"
        ;;
      -*) ;;
      *)
        chrome_reset_host="$token"
        break
        ;;
    esac
  done
  [ -n "$chrome_reset_host" ] || {
    echo "The managed waypipe command is missing its SSH host; refusing reset." >&2
    return 1
  }
}

chrome_reset_find_local_ssh() {
  local pane_pid="$1"
  local host="$2"
  local ps_output=""
  local current_uid
  local pid ppid uid args
  local current depth descendant
  local reverse_spec=""
  local remote_socket=""
  local candidate_spec=""
  local token
  local token_index
  local server_seen
  local socket_seen
  local candidate_count=0
  local -a argv=()
  local -A ppid_by_pid=()

  current_uid="$(id -u)"
  if ! ps_output="$(ps -eo pid=,ppid=,pgid=,uid=,args= 2>&1)"; then
    [ -n "$ps_output" ] && printf '%s\n' "$ps_output" >&2
    echo "Could not inspect local processes for the managed waypipe SSH child." >&2
    return 1
  fi

  while read -r pid ppid _; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    ppid_by_pid["$pid"]="$ppid"
  done <<<"$ps_output"

  while read -r pid ppid _ uid args; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    [ "$uid" = "$current_uid" ] || continue
    [ "$pid" = "$pane_pid" ] && continue

    # The SSH child must descend from the selected pane, not merely happen to
    # contain the same host/socket text elsewhere on the local machine.
    descendant=0
    current="$pid"
    for ((depth = 0; depth < 64; depth++)); do
      if [ "$current" = "$pane_pid" ]; then
        descendant=1
        break
      fi
      current="${ppid_by_pid[$current]:-}"
      [ -n "$current" ] || break
      [ "$current" != "$pid" ] || break
    done
    [ "$descendant" = "1" ] || continue

    # Reconstruct only the small argv shape needed for identity checks.  The
    # local waypipe/SSH child has no shell quoting left in `ps` output.
    read -r -a argv <<<"$args"
    [ "${#argv[@]}" -gt 0 ] || continue
    server_seen=0
    socket_seen=0
    reverse_spec=""
    remote_socket=""
    for token_index in "${!argv[@]}"; do
      token="${argv[$token_index]}"
      case "$token" in
        ssh|*/ssh)
          ;;
        -R)
          if [ $((token_index + 1)) -lt "${#argv[@]}" ]; then
            candidate_spec="${argv[$((token_index + 1))]}"
            case "$candidate_spec" in
              /tmp/waypipe-server-*:/tmp/waypipe-client-*) reverse_spec="$candidate_spec" ;;
            esac
          fi
          ;;
        -R*)
          candidate_spec="${token#-R}"
          case "$candidate_spec" in
            /tmp/waypipe-server-*:/tmp/waypipe-client-*) reverse_spec="$candidate_spec" ;;
          esac
          ;;
        --)
          if [ $((token_index + 2)) -lt "${#argv[@]}" ] && {
            [ "${argv[$((token_index + 1))]}" = "waypipe" ] ||
            [[ "${argv[$((token_index + 1))]}" = */waypipe ]];
          }; then
            server_seen=1
          fi
          ;;
        --socket)
          if [ $((token_index + 1)) -lt "${#argv[@]}" ]; then
            remote_socket="${argv[$((token_index + 1))]}"
            socket_seen=1
          fi
          ;;
        --socket=*)
          remote_socket="${token#--socket=}"
          socket_seen=1
          ;;
      esac
    done
    case "$args" in
      *" $host -- waypipe "*) ;;
      *) continue ;;
    esac
    [ "$server_seen" = "1" ] || continue
    [ "$socket_seen" = "1" ] || continue
    case "$reverse_spec" in
      /tmp/waypipe-server-*:/tmp/waypipe-client-*) ;;
      *) continue ;;
    esac
    local expected_socket="${reverse_spec%%:*}"
    [ "$remote_socket" = "$expected_socket" ] || continue

    candidate_count=$((candidate_count + 1))
    chrome_reset_remote_socket="$expected_socket"
  done <<<"$ps_output"

  if [ "$candidate_count" -eq 0 ]; then
    echo "Could not verify a managed waypipe SSH child for $host under pane pid $pane_pid." >&2
    return 1
  fi
  if [ "$candidate_count" -ne 1 ]; then
    echo "Multiple managed waypipe SSH children match $host; refusing ambiguous reset." >&2
    return 1
  fi
  return 0
}

chrome_reset_remote_identity() {
  local host="$1"
  local socket_path="$2"
  local selected_session="${3:-}"
  local post_stop="${4:-0}"
  local output=""
  local result_line allowlist="-" remote_command
  if [ "$post_stop" = "1" ] && [ "${#chrome_reset_remote_browser_allowlist[@]}" -gt 0 ]; then
    allowlist="$(IFS=,; printf '%s' "${chrome_reset_remote_browser_allowlist[*]}")"
  fi
  if [ "$post_stop" != "1" ]; then
    chrome_reset_remote_starttime=""
    chrome_reset_remote_boot_id=""
    chrome_reset_remote_browser_allowlist=()
  fi
  remote_command="$(quote_command bash -s -- "$socket_path" "$selected_session" \
    "$post_stop" "$chrome_reset_remote_boot_id" "$allowlist")"

  if ! output="$(ssh -o BatchMode=yes -o ConnectTimeout=5 -o ConnectionAttempts=1 \
    "$host" "$remote_command" 2>&1 <<'REMOTE_SCRIPT'
set -u
wanted_socket="$1"
selected_session="${2:-}"
post_stop="${3:-0}"
expected_boot="${4:-}"
allowlist="${5:--}"
uid="$(id -u)" || exit 2
boot_id="$(cat /proc/sys/kernel/random/boot_id)" || exit 2
if [ "$post_stop" = "1" ] && [ "$expected_boot" != "$boot_id" ]; then
  echo "Remote boot identity changed or was not captured; refusing reset." >&2
  exit 2
fi
proc_identity() {
  local pid="$1" stat_line
  local -a fields=()
  IFS= read -r stat_line <"/proc/$pid/stat" || return 1
  read -r -a fields <<<"${stat_line##*) }"
  [[ "${fields[19]:-}" =~ ^[0-9]+$ && "${fields[2]:-}" =~ ^[0-9]+$ ]] || return 1
  [[ "${fields[0]:-}" != Z && "${fields[0]:-}" != X ]] || return 1
  proc_birth="${fields[19]}"
  proc_group="${fields[2]}"
}
same_session() {
  local entry
  [ -n "$selected_session" ] || return 1
  [ -r "/proc/$1/environ" ] || return 2
  while IFS= read -r -d '' entry; do
    [ "$entry" != "REMOTE_CHROME_ORIGIN_SESSION=$selected_session" ] || return 0
  done <"/proc/$1/environ"
  return 1
}
processes="$(ps -u "$uid" -o pid=,ppid=,pgid=,args= 2>&1)" || {
  printf '%s\n' "$processes" >&2
  exit 2
}
browser_roots="$(printf '%s\n' "$processes" | awk '
  {
    pid=$1; pgid=$3; $1=""; $2=""; $3=""; sub(/^ +/, "")
    count=split($0, argv, /[[:space:]]+/); base=argv[1]; sub(/^.*\//, "", base)
    if (base !~ /^(google-chrome|google-chrome-stable|chrome|chromium|chromium-browser)$/) next
    for (i=2; i<=count; i++) if (argv[i] ~ /^--type=/) next
    print pid "\t" pgid
  }')"
if [ "$(printf '%s\n' "$browser_roots" | awk 'NF {n++} END {print n+0}')" -gt 128 ]; then
  echo "Too many browser identities to verify safely; refusing reset." >&2
  exit 2
fi

matches="$(printf '%s\n' "$processes" |
  awk -v wanted="$wanted_socket" '
    {
      pid = $1
      ppid = $2
      pgid = $3
      $1 = ""
      $2 = ""
      $3 = ""
      sub(/^ +/, "")
      command = $0
      count = split(command, argv, /[[:space:]]+/)
      base = argv[1]
      sub(/^.*\//, "", base)
      if (base != "waypipe") {
        next
      }
      socket_ok = 0
      server_ok = 0
      for (i = 1; i <= count; i++) {
        if (argv[i] == "--socket" && argv[i + 1] == wanted) {
          socket_ok = 1
        }
        if (index(argv[i], "--socket=") == 1 && substr(argv[i], 10) == wanted) {
          socket_ok = 1
        }
        if (argv[i] == "server") {
          server_ok = 1
        }
      }
      if (socket_ok && server_ok && pid ~ /^[0-9]+$/ && pgid ~ /^[0-9]+$/) {
        print pid "\t" pgid
      }
    }
  ')"

if [ -z "$matches" ]; then
  if [ "$post_stop" = "1" ]; then
    while IFS=$'\t' read -r browser_pid browser_pgid; do
      [ -n "$browser_pid" ] || continue
      proc_identity "$browser_pid" || exit 2
      [ "$proc_group" = "$browser_pgid" ] || exit 2
      case ",$allowlist," in
        *",$browser_pid:$proc_birth,"*) ;;
        *) printf 'UNRELATED\t%s\n' "$browser_pid"; exit 0 ;;
      esac
    done <<<"$browser_roots"
    printf '%s\n' ABSENT
    exit 0
  fi
  chrome_count="$(printf '%s\n' "$processes" |
    awk '
      {
        # ps emits pid, ppid, pgid before the command.  Remove those numeric
        # columns before inspecting the executable, otherwise a browser whose
        # path is not in the first column is mistaken for an absent browser.
        $1 = ""
        $2 = ""
        $3 = ""
        sub(/^ +/, "")
        command = $0
        count = split(command, argv, /[[:space:]]+/)
        base = argv[1]
        sub(/^.*\//, "", base)
        if (base ~ /^(google-chrome|google-chrome-stable|chrome|chromium|chromium-browser)$/) {
          child = 0
          for (i = 2; i <= count; i++) {
            if (argv[i] ~ /^--type=/) {
              child = 1
              break
            }
          }
          if (!child) {
            browser_count++
          }
        }
      }
      END { print browser_count + 0 }
    ')"
  if [ "$chrome_count" -gt 0 ]; then
    printf 'UNRELATED\t%s\n' "$chrome_count"
  else
    printf '%s\n' ABSENT
  fi
  exit 0
fi

groups="$(printf '%s\n' "$matches" | cut -f2 | sort -u)"
group_count="$(printf '%s\n' "$groups" | awk 'NF {count++} END {print count + 0}')"
if [ "$group_count" -ne 1 ]; then
  printf 'AMBIGUOUS\t%s\n' "$group_count"
  exit 0
fi
pgid="$(printf '%s\n' "$groups" | sed -n '1p')"
pid="$(printf '%s\n' "$matches" | awk -F '\t' -v wanted="$pgid" '$2 == wanted {print $1; exit}')"
proc_identity "$pid" || exit 2
[ "$proc_group" = "$pgid" ] || exit 2
server_birth="$proc_birth"
allowlist=""
while IFS=$'\t' read -r browser_pid browser_pgid; do
  [ -n "$browser_pid" ] || continue
  proc_identity "$browser_pid" || exit 2
  [ "$proc_group" = "$browser_pgid" ] || exit 2
  if [ "$proc_birth" -lt "$server_birth" ] && [ "$browser_pgid" = "$pgid" ]; then
    echo "Preexisting browser shares the selected Waypipe group; refusing TERM." >&2
    exit 2
  fi
  if [ "$browser_pgid" = "$pgid" ] || [ "$proc_birth" -ge "$server_birth" ]; then
    continue
  fi
  session_code=0
  same_session "$browser_pid" || session_code=$?
  [ "$session_code" -ne 2 ] || exit 2
  [ "$session_code" -ne 0 ] || continue
  allowlist+="${allowlist:+,}$browser_pid:$proc_birth"
done <<<"$browser_roots"
printf 'MATCH\t%s\t%s\t%s\t%s\t%s\n' "$pid" "$pgid" "$server_birth" "$boot_id" "${allowlist:--}"
REMOTE_SCRIPT
)"; then
    [ -n "$output" ] && printf '%s\n' "$output" >&2
    echo "Could not inspect the exact remote waypipe server for socket $socket_path; refusing reset." >&2
    return 2
  fi

  result_line="$(printf '%s\n' "$output" | sed -n '1p')"
  case "$result_line" in
    MATCH$'\t'*)
      IFS=$'\t' read -r _ chrome_reset_remote_pid chrome_reset_remote_pgid \
        chrome_reset_remote_starttime chrome_reset_remote_boot_id allowlist <<<"$result_line"
      if [[ ! "$chrome_reset_remote_pid" =~ ^[0-9]+$ ]] ||
        [[ ! "$chrome_reset_remote_pgid" =~ ^[0-9]+$ ]] ||
        [[ ! "$chrome_reset_remote_starttime" =~ ^[0-9]+$ ]] ||
        [[ ! "$chrome_reset_remote_boot_id" =~ ^[a-f0-9-]{36}$ ]] ||
        [[ ! "$allowlist" =~ ^([0-9]+:[0-9]+)(,[0-9]+:[0-9]+)*$ && "$allowlist" != - ]]; then
        echo "Remote waypipe identity check returned an invalid process identity; refusing reset." >&2
        return 2
      fi
      if [ "$allowlist" != - ]; then
        IFS=, read -r -a chrome_reset_remote_browser_allowlist <<<"$allowlist"
      fi
      return 0
      ;;
    ABSENT)
      chrome_reset_remote_pid=""
      chrome_reset_remote_pgid=""
      return 1
      ;;
    UNRELATED$'\t'*)
      echo "Remote Chrome process(es) remain while the exact waypipe server is absent; refusing to delegate reset." >&2
      return 2
      ;;
    AMBIGUOUS$'\t'*)
      echo "Multiple remote waypipe process groups match socket $socket_path; refusing ambiguous reset." >&2
      return 2
      ;;
    *)
      [ -n "$output" ] && printf '%s\n' "$output" >&2
      echo "Remote waypipe identity check returned an invalid result; refusing reset." >&2
      return 2
      ;;
  esac
}

chrome_reset_remote_stop() {
  local host="$1"
  local socket_path="$2"
  local expected_pgid="$3"
  local timeout="${REMOTE_CHROME_RESET_TIMEOUT:-5}"
  local output=""
  local remote_command
  [[ "$expected_pgid" =~ ^[0-9]+$ ]] || return 1
  [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=5
  [ "$timeout" -gt 0 ] || timeout=1
  timeout="$((10#$timeout))"
  remote_command="$(quote_command bash -s -- "$socket_path" "$expected_pgid" "$timeout" \
    "$chrome_reset_remote_pid" "$chrome_reset_remote_starttime" "$chrome_reset_remote_boot_id")"

  if ! output="$(ssh -o BatchMode=yes -o ConnectTimeout=5 -o ConnectionAttempts=1 \
    "$host" "$remote_command" 2>&1 <<'REMOTE_SCRIPT'
set -u
wanted_socket="$1"
wanted_pgid="$2"
timeout_seconds="$3"
expected_pid="${4:-}"
expected_birth="${5:-}"
expected_boot="${6:-}"
uid="$(id -u)" || exit 2
processes="$(ps -u "$uid" -o pid=,ppid=,pgid=,args= 2>&1)" || {
  printf '%s\n' "$processes" >&2
  exit 2
}
matches="$(printf '%s\n' "$processes" |
  awk -v wanted="$wanted_socket" '
    {
      pid = $1
      ppid = $2
      pgid = $3
      $1 = ""
      $2 = ""
      $3 = ""
      sub(/^ +/, "")
      command = $0
      count = split(command, argv, /[[:space:]]+/)
      base = argv[1]
      sub(/^.*\//, "", base)
      if (base != "waypipe") next
      socket_ok = 0
      server_ok = 0
      for (i = 1; i <= count; i++) {
        if (argv[i] == "--socket" && argv[i + 1] == wanted) socket_ok = 1
        if (index(argv[i], "--socket=") == 1 && substr(argv[i], 10) == wanted) socket_ok = 1
        if (argv[i] == "server") server_ok = 1
      }
      if (socket_ok && server_ok && pid ~ /^[0-9]+$/ && pgid ~ /^[0-9]+$/) print pid "\t" pgid
    }
  ')"
groups="$(printf '%s\n' "$matches" | cut -f2 | sort -u | awk 'NF {print}')"
group_count="$(printf '%s\n' "$groups" | awk 'NF {count++} END {print count + 0}')"
if [ "$group_count" -eq 0 ]; then
  chrome_count="$(printf '%s\n' "$processes" |
    awk '
      {
        # ps emits pid, ppid, pgid before the command.  Remove those numeric
        # columns before inspecting the executable, otherwise a browser whose
        # path is not in the first column is mistaken for an absent browser.
        $1 = ""
        $2 = ""
        $3 = ""
        sub(/^ +/, "")
        command = $0
        count = split(command, argv, /[[:space:]]+/)
        base = argv[1]
        sub(/^.*\//, "", base)
        if (base ~ /^(google-chrome|google-chrome-stable|chrome|chromium|chromium-browser)$/) {
          child = 0
          for (i = 2; i <= count; i++) {
            if (argv[i] ~ /^--type=/) {
              child = 1
              break
            }
          }
          if (!child) {
            browser_count++
          }
        }
      }
      END { print browser_count + 0 }
    ')"
  if [ "$chrome_count" -gt 0 ]; then
    printf '%s\n' UNRELATED
  else
    printf '%s\n' ABSENT
  fi
  exit 0
fi
if [ "$group_count" -ne 1 ] || [ "$(printf '%s\n' "$groups" | sed -n '1p')" != "$wanted_pgid" ]; then
  printf '%s\n' CHANGED
  exit 0
fi
if [[ ! "$expected_pid" =~ ^[0-9]+$ || ! "$expected_birth" =~ ^[0-9]+$ ]] ||
  [ "$expected_boot" != "$(cat /proc/sys/kernel/random/boot_id)" ]; then
  echo "Missing or changed captured Waypipe identity; refusing TERM." >&2
  exit 2
fi
[ "$(printf '%s\n' "$matches" | awk -F '\t' -v pid="$expected_pid" -v pgid="$wanted_pgid" \
  '$1 == pid && $2 == pgid {found=1} END {print found+0}')" = 1 ] || exit 2
IFS= read -r server_stat <"/proc/$expected_pid/stat" || exit 2
read -r -a server_fields <<<"${server_stat##*) }"
if [ "${server_fields[19]:-}" != "$expected_birth" ] ||
  [ "${server_fields[2]:-}" != "$wanted_pgid" ] ||
  [[ "${server_fields[0]:-}" == Z || "${server_fields[0]:-}" == X ]]; then
  echo "Captured Waypipe process identity changed; refusing TERM." >&2
  exit 2
fi
group_browsers="$(printf '%s\n' "$processes" | awk -v pgid="$wanted_pgid" '
  $3 == pgid {
    pid=$1; $1=""; $2=""; $3=""; sub(/^ +/, "")
    count=split($0, argv, /[[:space:]]+/); base=argv[1]; sub(/^.*\//, "", base)
    if (base !~ /^(google-chrome|google-chrome-stable|chrome|chromium|chromium-browser)$/) next
    for (i=2; i<=count; i++) if (argv[i] ~ /^--type=/) next
    print pid
  }')"
while IFS= read -r browser_pid; do
  [ -n "$browser_pid" ] || continue
  IFS= read -r browser_stat <"/proc/$browser_pid/stat" || exit 2
  read -r -a browser_fields <<<"${browser_stat##*) }"
  [[ "${browser_fields[19]:-}" =~ ^[0-9]+$ ]] || exit 2
  if [ "${browser_fields[19]}" -lt "$expected_birth" ]; then
    echo "Preexisting browser shares the selected Waypipe group; refusing TERM." >&2
    exit 2
  fi
done <<<"$group_browsers"

if ! kill -TERM -- "-$wanted_pgid" 2>&1; then
  echo "Could not send TERM to exact remote waypipe process group $wanted_pgid." >&2
  exit 1
fi
for ((attempt = 0; attempt <= timeout_seconds; attempt++)); do
  if ! kill -0 -- "-$wanted_pgid" 2>/dev/null; then
    printf '%s\n' STOPPED
    exit 0
  fi
  [ "$attempt" -lt "$timeout_seconds" ] || break
  sleep 1
done
printf '%s\n' REMAINS
exit 1
REMOTE_SCRIPT
)"; then
    [ -n "$output" ] && printf '%s\n' "$output" >&2
    echo "Remote waypipe process group $expected_pgid did not terminate safely." >&2
    return 1
  fi
  case "$(printf '%s\n' "$output" | sed -n '1p')" in
    STOPPED|ABSENT) return 0 ;;
    CHANGED)
      echo "Remote waypipe process identity changed before termination; refusing reset." >&2
      return 1
      ;;
    *)
      [ -n "$output" ] && printf '%s\n' "$output" >&2
      echo "Remote waypipe process group $expected_pgid remains or returned an invalid result." >&2
      return 1
      ;;
  esac
}

chrome_reset() {
  local host=""
  local session=""
  local assume_yes=0
  local yk_state_present=0
  local yk_window_present=0
  local yk_needed=0
  local remote_identity_code=0
  local post_stop_identity_code=0
  local session_probe_code=0
  local session_probe_output=""
  local reset_forwarding_expected=0
  local pane_host
  local notify_reset_state=0
  local notify_reset_listener_started=0
  local notify_reset_previous_traps=""
  local recreate_failed=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session)
        [ "$#" -ge 2 ] || die "$1 requires a session name."
        session="$2"
        shift 2
        ;;
      --session=*)
        session="${1#*=}"
        shift
        ;;
      --yes|-y)
        assume_yes=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      -*)
        die "Unknown reset option: $1"
        ;;
      *)
        [ -z "$host" ] || die "Unexpected argument: $1"
        host="$1"
        shift
        ;;
    esac
  done

  need tmux
  if [ -z "$host" ] && [ -z "$session" ]; then
    local -a managed_sessions=()
    mapfile -t managed_sessions < <(chrome_managed_sessions)
    case "${#managed_sessions[@]}" in
      0)
        die "No managed remote-chrome tmux sessions found to reset."
        ;;
      1)
        session="${managed_sessions[0]}"
        ;;
      *)
        printf 'More than one managed remote-chrome tmux session exists; select one with %s reset HOST or --session NAME:\n' "$PROGRAM" >&2
        printf '  %s\n' "${managed_sessions[@]}" >&2
        return 1
        ;;
    esac
  fi
  [ -n "$session" ] || session="$(chrome_default_session "$host")"

  need ssh
  need ps
  tmux has-session -t "=$session" 2>/dev/null ||
    die "tmux session not found: $session"
  chrome_reset_read_pane "$session" || return 1
  chrome_reset_parse_pane_host "$chrome_reset_pane_command" || return 1
  pane_host="$chrome_reset_host"
  if [ -n "$host" ] && [ "$host" != "$pane_host" ]; then
    die "The selected chrome pane targets $pane_host, not requested host $host; refusing reset."
  fi
  host="$pane_host"
  chrome_reset_find_local_ssh "$chrome_reset_pane_pid" "$host" || return 1

  notify_set_runtime_paths "$session"
  if [ -f "$notify_state_file" ]; then
    notify_load_state "$notify_state_file"
    notify_reset_state=1
  fi

  yk_prepare_for_launch "$host"
  runtime_path_present "$yk_state_file" && yk_state_present=1
  if tmux list-windows -t "=$session" -F '#{window_name}' 2>/dev/null |
    grep -qx yubikey; then
    yk_window_present=1
  fi

  if [ "$yk_state_present" = "1" ] || [ "$yk_window_present" = "1" ] ||
    [ "$chrome_yubikey_mode" = "force" ] ||
    { [ "$chrome_yubikey_mode" = "auto" ] && yk_local_candidate_exists; }; then
    reset_forwarding_expected=1
  fi
  if ! chrome_validate_launch_artifacts "$session" "$reset_forwarding_expected" 0 1; then
    echo "Unsafe runtime artifact prevents resetting $session; the existing browser and tmux session are unchanged." >&2
    return 1
  fi

  chrome_reset_remote_identity "$host" "$chrome_reset_remote_socket" "$session" || remote_identity_code=$?
  case "$remote_identity_code" in
    0)
      echo "Remote waypipe server matched socket $chrome_reset_remote_socket (pid=$chrome_reset_remote_pid pgid=$chrome_reset_remote_pgid)." >&2
      if [ "$assume_yes" != "1" ] &&
        ! confirm "Reset will restart remote Chrome/Waypipe and may lose unsaved in-page state. Continue?"; then
        echo "Reset canceled; the existing tmux session is unchanged." >&2
        return 1
      fi
      chrome_reset_remote_stop "$host" "$chrome_reset_remote_socket" \
        "$chrome_reset_remote_pgid" || return 1
      # Verify the captured identities after TERM. Only the exact preexisting
      # browser roots may remain; an escaped/new/reused root still blocks reset.
      chrome_reset_remote_identity "$host" "$chrome_reset_remote_socket" "$session" 1 ||
        post_stop_identity_code=$?
      if [ "$post_stop_identity_code" -ne 1 ]; then
        echo "Remote Waypipe teardown did not leave a cleanly absent server; preserving the existing tmux session." >&2
        return 1
      fi
      ;;
    1)
      echo "The exact remote waypipe server is already absent for socket $chrome_reset_remote_socket." >&2
      if [ "$assume_yes" != "1" ] &&
        ! confirm "No matching remote waypipe server or Chrome was found; recreate this frozen session?"; then
        echo "Reset canceled; the existing tmux session is unchanged." >&2
        return 1
      fi
      ;;
    *)
      return 1
      ;;
  esac

  if session_probe_output="$(tmux has-session -t "=$session" 2>&1)"; then
    session_probe_code=0
  else
    session_probe_code=$?
  fi
  case "$session_probe_code" in
    0)
      if tmux kill-session -t "=$session" 2>/dev/null; then
        echo "Removed managed tmux session $session after remote Waypipe teardown." >&2
      else
        echo "Remote Waypipe teardown succeeded, but could not remove tmux session $session." >&2
        return 1
      fi
      ;;
    1)
      if [ -n "$session_probe_output" ] &&
        [[ "$session_probe_output" != *"can't find session"* ]] &&
        [[ "$session_probe_output" != *"session not found"* ]]; then
        echo "Remote Waypipe teardown succeeded, but could not confirm tmux session $session absence: $session_probe_output" >&2
        return 1
      fi
      echo "Managed tmux session $session already exited after remote Waypipe teardown; continuing with recreation." >&2
      ;;
    *)
      echo "Remote Waypipe teardown succeeded, but could not verify tmux session $session absence." >&2
      return 1
      ;;
  esac

  if [ "$yk_state_present" = "1" ] || [ "$yk_window_present" = "1" ]; then
    yk_stop || {
      echo "YubiKey cleanup remains incomplete; retry $PROGRAM stop $host before resetting." >&2
      return 1
    }
    if [ "$chrome_yubikey_mode" != "off" ]; then
      yk_needed=1
    fi
  elif [ "$chrome_yubikey_mode" = "force" ] ||
    { [ "$chrome_yubikey_mode" = "auto" ] && yk_local_candidate_exists; }; then
    yk_needed=1
  fi

  if [ "$notify_reset_state" = "1" ]; then
    notify_stop_listener "$host"
  fi

  # Recreate the session-scoped bootstrap the canonical pane command reads from
  # stdin; it may have been pruned from the runtime directory since launch.
  chrome_prepare_bootstrap_script "$session" >/dev/null || return 1

  if [ "$yk_needed" = "1" ]; then
    yk_preflight_for_forwarding 1 || return $?
  fi
  if [ "$notify_reset_state" = "1" ]; then
    # The remote endpoint connects once during bootstrap. Its local listener
    # must already be accepting connections before the Chrome pane starts.
    if notify_start_listener; then
      notify_reset_listener_started=1
      notify_reset_previous_traps="$(trap -p EXIT INT TERM HUP)"
      trap 'trap "" INT TERM HUP; notify_stop_listener "$host"' EXIT
      trap 'exit 130' INT
      trap 'exit 143' TERM
      trap 'exit 129' HUP
    else
      echo "remote-chrome notify: listener restart failed; remote notifications will not appear locally." >&2
    fi
  fi

  if [ "$yk_needed" = "1" ]; then
    if ! chrome_launch_detached_with_yubikey "$host" "$session" "$chrome_reset_pane_command"; then
      echo "Could not recreate the Chrome/YubiKey tmux session after remote Waypipe teardown." >&2
      recreate_failed=1
    fi
  else
    if ! chrome_tmux_create_chrome_session "$session" "$chrome_reset_pane_command"; then
      echo "Could not recreate chrome pane in tmux session $session." >&2
      recreate_failed=1
    fi
  fi
  if [ "$notify_reset_listener_started" = "1" ]; then
    if [ "$recreate_failed" = "1" ]; then
      trap '' INT TERM HUP
      notify_stop_listener "$host"
    fi
    trap - EXIT INT TERM HUP
    [ -z "$notify_reset_previous_traps" ] || eval "$notify_reset_previous_traps"
  fi
  [ "$recreate_failed" = "0" ] || return 1
  echo "Reset $host by restarting the managed remote Chrome/Waypipe stream; in-page state may have been lost." >&2
  print_command_hint "Attach:" "$PROGRAM" attach "$host" --session "$session"
  print_command_hint "Status:" "$PROGRAM" status "$host" --session "$session"
  print_command_hint "Stop:" "$PROGRAM" stop "$host" --session "$session"
}

chrome_status_all() {
  local session state_file lock_file state_output
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  local found_sessions=0
  local found_forwarding=0
  local code=0

  need tmux
  echo "Managed tmux sessions:"
  while IFS= read -r session; do
    [ -n "$session" ] || continue
    found_sessions=1
    printf '  %s\n' "$session"
    if ! tmux list-windows -t "=$session" -F '    window: #{window_name} (#{window_index})' 2>/dev/null; then
      echo "    windows unavailable (session may have exited)" >&2
      code=1
    fi
  done < <(chrome_managed_sessions)
  [ "$found_sessions" = "1" ] || echo "  none"

  echo "Managed YubiKey forwarding:"
  while IFS= read -r state_file; do
    [ -n "$state_file" ] || continue
    found_forwarding=1
    if state_output="$(yk_status_state_file "$state_file")"; then
      printf '  %s\n' "$state_output"
    else
      code=1
    fi
  done < <(yk_standard_state_files)

  for lock_file in "$runtime_dir"/remote-chrome-yubikey-*.sock.state.lock; do
    [ -d "$lock_file" ] || continue
    [ -e "${lock_file%.lock}" ] && continue
    found_forwarding=1
    printf '  provisional setup lock: %s\n' "$lock_file"
  done
  [ "$found_forwarding" = "1" ] || echo "  none"

  echo "Tool-owned orphan usbipd daemons:"
  yk_status_orphan_usbipd
  chrome_status_incoming

  return "$code"
}

chrome_status() {
  local host=""
  local session=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session)
        [ "$#" -ge 2 ] || die "$1 requires a session name."
        session="$2"
        shift 2
        ;;
      --session=*)
        session="${1#*=}"
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      -*)
        die "Unknown status option: $1"
        ;;
      *)
        [ -z "$host" ] || die "Unexpected argument: $1"
        host="$1"
        shift
        ;;
    esac
  done

  if [ -z "$host" ] && [ -z "$session" ]; then
    chrome_status_all
    return
  fi

  [ -n "$host" ] || die "status with --session requires HOST."
  [ -n "$session" ] || session="$(chrome_default_session "$host")"
  chrome_status_current "$host" "$session"
}

chrome_status_current() {
  local host="$1"
  local session="$2"
  local code=0
  local windows
  local state_code=0

  [ -n "$session" ] || session="$(chrome_default_session "$host")"
  need tmux

  if tmux has-session -t "=$session" 2>/dev/null; then
    echo "status: tmux session running: $session"
    windows="$(tmux list-windows -t "=$session" -F '#{window_name}' 2>/dev/null || true)"
    if [ -n "$windows" ]; then
      printf '%s\n' "$windows" | sed 's/^/status: window: /'
    else
      echo "status: degraded: tmux session has no readable windows." >&2
      code=1
    fi
    if ! printf '%s\n' "$windows" | grep -qx 'chrome'; then
      echo "status: degraded: tmux session has no chrome window." >&2
      code=1
    fi
  else
    echo "status: degraded: tmux session is not running: $session" >&2
    code=1
  fi

  yk_prepare_for_launch "$host"
  if yk_load_state; then
    echo "status: yubikey phase=$yk_phase readiness=$yk_readiness"
    if [ "$yk_phase" = "cleanup-failed" ]; then
      echo "status: degraded: YubiKey cleanup previously failed; retry stop before trusting this state." >&2
      code=1
    fi

    if [ -n "$yk_active_busid" ] && [ "$yk_bind_state" != "none" ]; then
      if yk_local_busid_bound "$yk_active_busid"; then
        echo "status: local USB/IP bind present: $yk_active_busid"
      else
        echo "status: degraded: recorded local USB/IP bind is absent: $yk_active_busid" >&2
        code=1
      fi
    fi

    if [ "$yk_started_usbipd" = "1" ]; then
      if yk_owned_usbipd_running "$yk_usbipd_pid" &&
        ss -ltn 2>/dev/null | grep -q ":${yk_usbip_port}\b"; then
        echo "status: owned usbipd running and listening: pid=$yk_usbipd_pid port=$yk_usbip_port"
      else
        echo "status: degraded: owned usbipd is not alive, exact-owned, or listening on port $yk_usbip_port: pid=${yk_usbipd_pid:-unknown}" >&2
        code=1
      fi
    fi

    if [ "$yk_tunnel_open" = "1" ] || [ "$yk_attach_state" != "none" ]; then
      local socket_status=0
      yk_control_socket_status || socket_status=$?
      if [ "$socket_status" -eq 0 ] &&
        yk_ssh_request -S "$yk_control_socket" -O check "$yk_remote" >/dev/null 2>&1; then
        echo "status: SSH USB/IP control socket is alive: $yk_control_socket"
      else
        if [ "$socket_status" -eq 2 ]; then
          echo "status: degraded: unsafe SSH USB/IP control socket path is preserved: $yk_control_socket" >&2
        else
          echo "status: degraded: SSH USB/IP control socket is unavailable: $yk_control_socket" >&2
        fi
        code=1
      fi
    fi

    if [ "$yk_attach_state" != "none" ] || [ "$yk_phase" = "ready" ]; then
      if yk_remote_probe_readiness; then
        echo "status: remote YubiKey readiness probe passed."
      else
        echo "status: degraded: remote YubiKey readiness probe failed (${yk_readiness:-not-ready})." >&2
        code=1
      fi
    fi
  else
    state_code=$?
    if [ "$state_code" = "1" ]; then
      echo "status: no managed YubiKey state for $host."
    else
      echo "status: degraded: managed YubiKey state is invalid for $host." >&2
      code=1
    fi
  fi

  notify_status_current "$host" "$session" || code=1

  if [ "$code" = "0" ]; then
    echo "status: healthy"
  else
    echo "status: degraded; inspect the failing checks above and retry after repair." >&2
  fi
  return "$code"
}

yk_remote=""
yk_usb_id="${REMOTE_CHROME_YUBIKEY_USB_ID:-1050:0407}"
yk_usbip_port="${REMOTE_CHROME_USBIP_PORT:-3240}"
yk_control_socket="${REMOTE_CHROME_YUBIKEY_SOCKET:-}"
yk_stop_usbipd="${REMOTE_CHROME_STOP_USBIPD:-1}"
yk_usbip_host_sysfs="${REMOTE_CHROME_USBIP_HOST_SYSFS:-/sys/bus/usb/drivers/usbip-host}"
yk_cleanup_done=0
yk_state_file=""
yk_usbipd_pid_file=""
yk_log_file=""
yk_attempt_lock=""
yk_attempt_owned=0
yk_attempt_lock_identity=""
yk_attempt_token="${REMOTE_CHROME_YUBIKEY_ATTEMPT_TOKEN:-}"
yk_cleanup_lock=""
yk_cleanup_lock_owned=0
yk_cleanup_lock_token=""
yk_cleanup_reload_state=0
yk_phase="idle"
yk_readiness="none"
yk_tunnel_open=0
yk_active_busid=""
yk_bind_state="none"
yk_bound_before=0
yk_attach_state="none"
yk_started_usbipd=0
yk_usbipd_pid=""
yk_usbipd_pid_file_identity=""
yk_usbipd_start_failed=0
yk_cleanup_unresolved=0
yk_cleanup_messages=""

yk_prepare_for_launch() {
  yk_remote="$1"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --usb-id)
        [ "$#" -ge 2 ] || die "$1 requires a USB id."
        yk_usb_id="$2"
        shift 2
        ;;
      --usb-id=*)
        yk_usb_id="${1#*=}"
        shift
        ;;
      --port)
        [ "$#" -ge 2 ] || die "$1 requires a port."
        yk_usbip_port="$2"
        shift 2
        ;;
      --port=*)
        yk_usbip_port="${1#*=}"
        shift
        ;;
      *)
        die "Unexpected YubiKey launch option: $1"
        ;;
    esac
  done

  if [ -z "$yk_control_socket" ]; then
    yk_control_socket="${XDG_RUNTIME_DIR:-/tmp}/remote-chrome-yubikey-$(safe_name "$yk_remote").sock"
  fi
  yk_validate_settings
  yk_set_runtime_paths
}

yk_validate_settings() {
  if [[ ! "$yk_usb_id" =~ ^[[:xdigit:]]{1,4}:[[:xdigit:]]{1,4}$ ]]; then
    die "YubiKey USB id must be hexadecimal vendor:product (for example 1050:0407)."
  fi
  if [[ ! "$yk_usbip_port" =~ ^[0-9]+$ ]] ||
    [ "$((10#$yk_usbip_port))" -lt 1 ] ||
    [ "$((10#$yk_usbip_port))" -gt 65535 ]; then
    die "USB/IP port must be an integer from 1 through 65535."
  fi
  yk_usbip_port="$((10#$yk_usbip_port))"
}

yk_set_runtime_paths() {
  yk_state_file="${yk_control_socket}.state"
  yk_log_file="${yk_state_file}.log"
  yk_attempt_lock="${yk_state_file}.lock"
  yk_cleanup_lock="${yk_state_file}.cleanup.lock"
  yk_usbipd_pid_file="${XDG_RUNTIME_DIR:-/tmp}/remote-chrome-usbipd-$(safe_name "$yk_usbip_port").pid"
}

yk_state_path_status() {
  runtime_artifact_status "$yk_state_file"
}

yk_log_path_status() {
  runtime_artifact_status "$yk_log_file"
}

yk_pid_file_reservation_identity() {
  runtime_path_identity "$1"
}

yk_prepare_log_file() {
  local path_status=0
  yk_log_path_status || path_status=$?
  if [ "$path_status" -eq 2 ]; then
    echo "Refusing to append to unsafe YubiKey log path: $yk_log_file" >&2
    return 1
  fi
  if [ "$path_status" -eq 1 ]; then
    if ! (umask 077; set -o noclobber; : >"$yk_log_file") 2>/dev/null; then
      path_status=0
      yk_log_path_status || path_status=$?
      if [ "$path_status" -ne 0 ]; then
        echo "Could not safely create YubiKey log file: $yk_log_file" >&2
        return 1
      fi
    fi
  fi
  yk_log_path_status || {
    echo "YubiKey log path became unsafe: $yk_log_file" >&2
    return 1
  }
  chmod 600 -- "$yk_log_file"
}

yk_remove_runtime_artifact() {
  local path="$1"
  local path_status=0
  runtime_artifact_status "$path" || path_status=$?
  case "$path_status" in
    1) return 0 ;;
    2)
      echo "Preserving unsafe runtime artifact: $path" >&2
      return 1
      ;;
  esac
  path_status=0
  runtime_artifact_status "$path" || path_status=$?
  [ "$path_status" -eq 0 ] || {
    echo "Runtime artifact changed before removal; preserving $path" >&2
    return 1
  }
  rm -f -- "$path"
}

yk_control_socket_status() {
  local path="$yk_control_socket"
  if runtime_path_present "$path"; then
    [[ -S "$path" && ! -L "$path" && -O "$path" ]] || return 2
    return 0
  fi
  return 1
}

yk_pid_file_status() {
  local path="$1"
  local owner
  if ! runtime_path_present "$path"; then
    return 1
  fi
  [[ -f "$path" && ! -L "$path" ]] || return 2
  owner="$(stat -c '%u' -- "$path" 2>/dev/null)" || return 2
  [[ "$owner" = 0 || "$owner" = "$EUID" ]] || return 2
  return 0
}

yk_remove_pid_file() {
  local path="$1"
  local expected_pid="${2:-}"
  local path_status=0
  local file_pid

  yk_pid_file_status "$path" || path_status=$?
  [ "$path_status" -eq 1 ] && return 0
  if [ "$path_status" -ne 0 ]; then
    echo "Preserving unsafe usbipd pid file: $path" >&2
    return 1
  fi
  if [ -n "$expected_pid" ]; then
    yk_pid_file_status "$path" || {
      echo "Preserving unsafe usbipd pid file: $path" >&2
      return 1
    }
    file_pid="$(sudo cat -- "$path" 2>/dev/null || true)"
    if [[ ! "$file_pid" =~ ^[0-9]+$ ]]; then
      echo "Preserving invalid usbipd pid file: $path" >&2
      return 1
    fi
    [ "$file_pid" = "$expected_pid" ] || {
      echo "Preserving usbipd pid file with unexpected PID $file_pid: $path" >&2
      return 1
    }
  fi
  if ! sudo rm -f -- "$path" >/dev/null 2>&1; then
    echo "Could not remove usbipd pid file $path." >&2
    return 1
  fi
}

yk_remove_failed_usbipd_reservation() {
  local path_status=0
  local current_identity=""
  local file_size=""

  if [ "$yk_usbipd_start_failed" != "1" ] ||
    [ -z "$yk_usbipd_pid_file_identity" ]; then
    echo "No confirmed failed-start reservation authority for $yk_usbipd_pid_file; preserving it." >&2
    return 1
  fi

  yk_pid_file_status "$yk_usbipd_pid_file" || path_status=$?
  if [ "$path_status" -ne 0 ]; then
    echo "Preserving missing or unsafe usbipd pid reservation: $yk_usbipd_pid_file" >&2
    return 1
  fi
  if [ ! -O "$yk_usbipd_pid_file" ]; then
    echo "Preserving usbipd pid reservation not owned by this user: $yk_usbipd_pid_file" >&2
    return 1
  fi
  current_identity="$(yk_pid_file_reservation_identity "$yk_usbipd_pid_file")" || current_identity=""
  if [ -z "$current_identity" ] || [ "$current_identity" != "$yk_usbipd_pid_file_identity" ]; then
    echo "Preserving replaced usbipd pid reservation: $yk_usbipd_pid_file" >&2
    return 1
  fi
  file_size="$(stat -c '%s' -- "$yk_usbipd_pid_file" 2>/dev/null)" || file_size=""
  if [ "$file_size" != "0" ]; then
    echo "Preserving non-empty usbipd pid reservation: $yk_usbipd_pid_file" >&2
    return 1
  fi

  path_status=0
  yk_pid_file_status "$yk_usbipd_pid_file" || path_status=$?
  current_identity="$(yk_pid_file_reservation_identity "$yk_usbipd_pid_file")" || current_identity=""
  file_size="$(stat -c '%s' -- "$yk_usbipd_pid_file" 2>/dev/null)" || file_size=""
  if [ "$path_status" -ne 0 ] || [ ! -O "$yk_usbipd_pid_file" ] ||
    [ "$current_identity" != "$yk_usbipd_pid_file_identity" ] || [ "$file_size" != "0" ]; then
    echo "Usbipd pid reservation changed before removal; preserving $yk_usbipd_pid_file." >&2
    return 1
  fi
  if ! rm -f -- "$yk_usbipd_pid_file"; then
    echo "Could not remove failed usbipd pid reservation $yk_usbipd_pid_file." >&2
    return 1
  fi
  if runtime_path_present "$yk_usbipd_pid_file"; then
    echo "Usbipd pid path reappeared after reservation removal; preserving recovery state: $yk_usbipd_pid_file" >&2
    return 1
  fi
  return 0
}

yk_reserve_pid_file() {
  local path_status=0
  yk_pid_file_status "$yk_usbipd_pid_file" || path_status=$?
  if [ "$path_status" -ne 1 ]; then
    echo "Refusing to reserve an existing or unsafe usbipd pid path: $yk_usbipd_pid_file" >&2
    return 1
  fi
  if ! (umask 077; set -o noclobber; : >"$yk_usbipd_pid_file") 2>/dev/null; then
    echo "Could not safely reserve usbipd pid path $yk_usbipd_pid_file." >&2
    return 1
  fi
  if ! yk_pid_file_status "$yk_usbipd_pid_file"; then
    echo "Reserved usbipd pid path is not a safe regular file: $yk_usbipd_pid_file" >&2
    return 1
  fi
  yk_usbipd_pid_file_identity="$(yk_pid_file_reservation_identity "$yk_usbipd_pid_file")" ||
    yk_usbipd_pid_file_identity=""
  if [[ ! "$yk_usbipd_pid_file_identity" =~ ^[0-9]+:[0-9]+:[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+[[:space:]][+-][0-9]{4}$ ]]; then
    yk_usbipd_pid_file_identity=""
    echo "Could not record the reserved usbipd pid file identity: $yk_usbipd_pid_file" >&2
    return 1
  fi
}

yk_local_busid_bound() {
  local busid="$1"
  [ -e "$yk_usbip_host_sysfs/$busid" ] || [ -L "$yk_usbip_host_sysfs/$busid" ]
}

yk_is_standard_pid_file() {
  local pid_file="$1"
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  local basename

  basename="${pid_file##*/}"
  [ "$pid_file" = "$runtime_dir/$basename" ] || return 1
  [[ "$basename" =~ ^remote-chrome-usbipd-[0-9]+\.pid$ ]]
}

yk_state_owns_pid_file() {
  local state_file="$1"
  local pid_file="$2"
  local state_pid_file
  local state_port
  local state_started
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  local basename

  runtime_artifact_status "$state_file" || return 1
  state_pid_file="$(awk -F '\t' '$1 == "usbipd_pid_file" {print $2; exit}' "$state_file" 2>/dev/null || true)"
  state_started="$(awk -F '\t' '$1 == "started_usbipd" {print $2; exit}' "$state_file" 2>/dev/null || true)"
  [ "$state_started" = "1" ] || return 1
  if [ -n "$state_pid_file" ]; then
    [ "$state_pid_file" = "$pid_file" ]
    return
  fi

  # Legacy states did not record a port or pid-file path.  Their only
  # supported daemon path was the default runtime path, so derive it without
  # trusting arbitrary state-file content.
  state_port="$(awk -F '\t' '$1 == "usbip_port" {print $2; exit}' "$state_file" 2>/dev/null || true)"
  [ -n "$state_port" ] || state_port=3240
  [[ "$state_port" =~ ^[0-9]+$ ]] || return 1
  basename="remote-chrome-usbipd-$((10#$state_port)).pid"
  [ "$pid_file" = "$runtime_dir/$basename" ]
}

yk_standard_state_files() {
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  local state_file

  for state_file in "$runtime_dir"/remote-chrome-yubikey-*.sock.state; do
    runtime_artifact_status "$state_file" || continue
    printf '%s\n' "$state_file"
  done
}

yk_print_status_line() {
  local label="$1"
  local state_code=0

  yk_load_state || state_code=$?
  case "$state_code" in
    0)
      printf '%s phase=%s readiness=%s' "$label" "${yk_phase:-unknown}" "${yk_readiness:-unknown}"
      [ -n "$yk_active_busid" ] && printf ' busid=%s' "$yk_active_busid"
      printf '\n'
      ;;
    1)
      if runtime_owned_directory "$yk_attempt_lock"; then
        printf '%s phase=starting readiness=unknown provisional-lock=%s\n' "$label" "$yk_attempt_lock"
      else
        printf '%s no managed state\n' "$label"
      fi
      ;;
    *)
      echo "$label invalid managed state ($yk_state_file)" >&2
      return 1
      ;;
  esac
}

yk_status_state_file() (
  local state_file="$1"
  local host
  local path_status=0

  runtime_artifact_status "$state_file" || path_status=$?
  if [ "$path_status" -ne 0 ]; then
    echo "Ignoring unsafe or missing YubiKey state file: $state_file" >&2
    return 1
  fi
  host="$(awk -F '\t' '$1 == "remote" {print $2; exit}' "$state_file" 2>/dev/null || true)"
  if [ -z "$host" ]; then
    echo "Managed YubiKey state is missing its remote host: $state_file" >&2
    return 1
  fi

  yk_control_socket="${state_file%.state}"
  yk_prepare_for_launch "$host"
  yk_print_status_line "$host:"
)

yk_stop_state_file() {
  local state_file="$1"
  local host
  local path_status=0

  runtime_artifact_status "$state_file" || path_status=$?
  if [ "$path_status" -ne 0 ]; then
    echo "Refusing to read or clean an unsafe or missing YubiKey state file: $state_file" >&2
    return 1
  fi
  host="$(awk -F '\t' '$1 == "remote" {print $2; exit}' "$state_file" 2>/dev/null || true)"
  if [ -z "$host" ]; then
    echo "Managed YubiKey state is missing its remote host: $state_file" >&2
    return 1
  fi

  yk_control_socket="${state_file%.state}"
  yk_prepare_for_launch "$host"
  yk_stop
}

yk_stop_orphan_attempt_locks() {
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  local lock_file
  local state_file
  local code=0

  for lock_file in "$runtime_dir"/remote-chrome-yubikey-*.sock.state.lock; do
    runtime_owned_directory "$lock_file" || continue
    state_file="${lock_file%.lock}"
    local state_status=0
    runtime_artifact_status "$state_file" || state_status=$?
    [ "$state_status" -eq 1 ] || continue
    if rmdir -- "$lock_file"; then
      echo "Removed orphaned YubiKey setup lock $lock_file."
    else
      echo "Could not remove orphaned YubiKey setup lock $lock_file." >&2
      code=1
    fi
  done
  return "$code"
}

yk_stop_all() {
  local state_file
  local found_state=0
  local code=0

  while IFS= read -r state_file; do
    [ -n "$state_file" ] || continue
    found_state=1
    if ! yk_stop_state_file "$state_file"; then
      echo "YubiKey cleanup reported an error; inspect $state_file." >&2
      code=1
    fi
  done < <(yk_standard_state_files)

  if [ "$found_state" = "0" ]; then
    echo "No managed YubiKey forwarding states found."
  fi

  yk_stop_orphan_attempt_locks || code=1
  yk_stop_orphan_usbipd_files || code=1
  return "$code"
}

yk_reset_runtime_state() {
  yk_phase="idle"
  yk_readiness="none"
  yk_tunnel_open=0
  yk_active_busid=""
  yk_bind_state="none"
  yk_bound_before=0
  yk_attach_state="none"
  yk_started_usbipd=0
  yk_usbipd_pid=""
  yk_usbipd_pid_file_identity=""
  yk_usbipd_start_failed=0
}

yk_cleanup_lock_release() {
  local owner_pid=""
  local owner_token=""
  local lock_pid="${BASHPID:-$$}"
  local path_status=0

  [ "$yk_cleanup_lock_owned" = "1" ] || return 0
  runtime_artifact_status "$yk_cleanup_lock" || path_status=$?
  if [ "$path_status" -eq 2 ]; then
    echo "YubiKey cleanup lock became unsafe; preserving $yk_cleanup_lock." >&2
    return 1
  fi
  if [ "$path_status" -eq 0 ]; then
    IFS=$'\t' read -r owner_pid owner_token <"$yk_cleanup_lock" || true
    if [ "$owner_pid" != "$lock_pid" ] ||
      [ "$owner_token" != "$yk_cleanup_lock_token" ]; then
      echo "YubiKey cleanup lock ownership changed; preserving $yk_cleanup_lock." >&2
      return 1
    fi
    path_status=0
    runtime_artifact_status "$yk_cleanup_lock" || path_status=$?
    if [ "$path_status" -ne 0 ] ||
      [ "$(cat -- "$yk_cleanup_lock" 2>/dev/null || true)" != "$owner_pid	$owner_token" ]; then
      echo "YubiKey cleanup lock changed before release; preserving $yk_cleanup_lock." >&2
      return 1
    fi
    if ! rm -f -- "$yk_cleanup_lock"; then
      echo "Could not release YubiKey cleanup lock $yk_cleanup_lock." >&2
      return 1
    fi
  fi
  yk_cleanup_lock_owned=0
  yk_cleanup_lock_token=""
  return 0
}

yk_cleanup_lock_release_on_exit() {
  yk_cleanup_lock_release >/dev/null 2>&1 || true
}

yk_cleanup_lock_acquire() {
  local timeout="${REMOTE_CHROME_YUBIKEY_CLEANUP_LOCK_TIMEOUT:-30}"
  local attempt=0
  local lock_pid
  local lock_token
  local owner_tmp=""
  local owner_pid=""
  local owner_token=""
  local current_owner
  local process_alive
  local lock_status=0

  if [ -z "$yk_cleanup_lock" ] && [ -n "$yk_state_file" ]; then
    yk_cleanup_lock="${yk_state_file}.cleanup.lock"
  fi
  [ -n "$yk_cleanup_lock" ] || {
    echo "YubiKey cleanup lock path is not configured." >&2
    return 1
  }
  if [ "$yk_cleanup_lock_owned" = "1" ]; then
    return 0
  fi
  [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=30
  timeout="$((10#$timeout))"
  lock_pid="${BASHPID:-$$}"

  while true; do
    lock_token="${lock_pid}.${RANDOM}.${SECONDS}.${attempt}"
    owner_tmp="$(umask 077; mktemp -- "${yk_cleanup_lock}.owner.XXXXXXXX" 2>/dev/null)" || owner_tmp=""
    if [ -n "$owner_tmp" ] &&
      printf '%s\t%s\n' "$lock_pid" "$lock_token" >"$owner_tmp" 2>/dev/null &&
      ln -T -- "$owner_tmp" "$yk_cleanup_lock" 2>/dev/null; then
      runtime_artifact_status "$owner_tmp" && rm -f -- "$owner_tmp"
      yk_cleanup_lock_owned=1
      yk_cleanup_lock_token="$lock_token"
      return 0
    fi
    if [ -n "$owner_tmp" ]; then
      if runtime_artifact_status "$owner_tmp"; then
        rm -f -- "$owner_tmp" 2>/dev/null || true
      fi
    fi

    lock_status=0
    runtime_artifact_status "$yk_cleanup_lock" || lock_status=$?
    if [ "$lock_status" -eq 0 ]; then
      owner_pid=""
      owner_token=""
      IFS=$'\t' read -r owner_pid owner_token <"$yk_cleanup_lock" || true
      process_alive=0
      if [[ "$owner_pid" =~ ^[0-9]+$ ]] && kill -0 "$owner_pid" 2>/dev/null; then
        process_alive=1
      fi
      if [ "$process_alive" = "0" ] &&
        [[ "$owner_pid" =~ ^[0-9]+$ ]] && [ -n "$owner_token" ]; then
        # Confirm the owner record did not change while its process was being
        # checked.  Never remove a lock that may have been handed to a live
        # cleanup operation in the meantime.
        current_owner="$(cat -- "$yk_cleanup_lock" 2>/dev/null || true)"
        lock_status=0
        runtime_artifact_status "$yk_cleanup_lock" || lock_status=$?
        if [ "$current_owner" = "$owner_pid	$owner_token" ]; then
          if [ "$lock_status" -eq 0 ] &&
            [ "$(cat -- "$yk_cleanup_lock" 2>/dev/null || true)" = "$current_owner" ] &&
            rm -f -- "$yk_cleanup_lock" 2>/dev/null; then
            continue
          fi
        fi
      fi
    fi

    if [ "$attempt" -ge "$timeout" ]; then
      if [ -n "$owner_pid" ] && [ -n "$owner_token" ]; then
        echo "YubiKey cleanup is already in progress (lock: $yk_cleanup_lock; owner pid=$owner_pid)." >&2
      else
        echo "YubiKey cleanup lock is busy or unreadable: $yk_cleanup_lock." >&2
      fi
      echo "Wait for the current cleanup to finish, then retry stop or launch." >&2
      return 1
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
}

yk_release_attempt() {
  local current_identity=""
  if [ -n "$yk_attempt_lock" ] && runtime_path_present "$yk_attempt_lock"; then
    if ! runtime_owned_directory "$yk_attempt_lock"; then
      echo "Preserving unsafe YubiKey attempt lock $yk_attempt_lock." >&2
      return 1
    fi
    if [ "$yk_attempt_owned" = "1" ] && [ -n "$yk_attempt_lock_identity" ]; then
      current_identity="$(runtime_path_identity "$yk_attempt_lock")" || current_identity=""
      if [ -z "$current_identity" ] || [ "$current_identity" != "$yk_attempt_lock_identity" ]; then
        echo "YubiKey attempt lock generation changed; preserving $yk_attempt_lock." >&2
        return 1
      fi
    fi
    if ! rmdir -- "$yk_attempt_lock" >/dev/null 2>&1; then
      echo "Could not release YubiKey attempt lock $yk_attempt_lock." >&2
      return 1
    fi
  fi
  yk_attempt_owned=0
  yk_attempt_lock_identity=""
  return 0
}

yk_release_orphan_attempt() {
  local state_status=0
  # A lock is created before the first state write, so a lock with no state
  # cannot own any USB/IP resources yet.  Only remove the exact empty lock
  # directory; a non-empty or otherwise unusual path is left untouched.
  [ -n "$yk_attempt_lock" ] || return 0
  yk_state_path_status || state_status=$?
  [ "$state_status" -eq 1 ] || return 0
  runtime_path_present "$yk_attempt_lock" || return 0
  runtime_owned_directory "$yk_attempt_lock" || return 1
  if [ "$yk_attempt_owned" = "1" ] && [ -n "$yk_attempt_lock_identity" ]; then
    local current_identity
    current_identity="$(runtime_path_identity "$yk_attempt_lock")" || return 1
    [ "$current_identity" = "$yk_attempt_lock_identity" ] || return 1
  fi
  rmdir -- "$yk_attempt_lock"
}

yk_acquire_attempt() {
  local state_status=0
  yk_state_path_status || state_status=$?
  if [ "$state_status" -eq 0 ]; then
    echo "YubiKey forwarding already has managed state: $yk_state_file" >&2
    echo "Stop the existing $PROGRAM session for $yk_remote before starting it again." >&2
    return 1
  fi
  if [ "$state_status" -eq 2 ]; then
    echo "Refusing to use unsafe YubiKey state path: $yk_state_file" >&2
    return 1
  fi
  if ! mkdir -m 700 -- "$yk_attempt_lock" 2>/dev/null; then
    echo "YubiKey forwarding setup is already being started (lock: $yk_attempt_lock)." >&2
    echo "Wait for that attempt or use stop $yk_remote to clean its managed state." >&2
    return 1
  fi
  yk_attempt_owned=1
  yk_attempt_lock_identity="$(runtime_path_identity "$yk_attempt_lock")" || yk_attempt_lock_identity=""
  if [ -z "$yk_attempt_lock_identity" ]; then
    rmdir -- "$yk_attempt_lock" 2>/dev/null || true
    yk_attempt_owned=0
    echo "Could not record YubiKey attempt lock identity: $yk_attempt_lock" >&2
    return 1
  fi
  if [ -z "$yk_attempt_token" ]; then
    yk_attempt_token="${BASHPID:-$$}.${RANDOM}.${SECONDS}"
  fi
  return 0
}

yk_write_state() {
  local state_tmp=""
  local old_umask
  local state_status=0

  if [ "$yk_attempt_owned" = "1" ] &&
    { [ -z "$yk_attempt_lock" ] || ! runtime_owned_directory "$yk_attempt_lock" ||
      [ -z "$yk_attempt_lock_identity" ] ||
      [ "$(runtime_path_identity "$yk_attempt_lock")" != "$yk_attempt_lock_identity" ]; }; then
    echo "YubiKey attempt lock disappeared before state could be persisted: $yk_attempt_lock" >&2
    return 1
  fi

  yk_state_path_status || state_status=$?
  if [ "$state_status" -eq 2 ]; then
    echo "Refusing to overwrite unsafe YubiKey state path: $yk_state_file" >&2
    return 1
  fi

  old_umask="$(umask)"
  umask 077
  if ! state_tmp="$(mktemp -- "${yk_state_file}.tmp.XXXXXXXX")"; then
    umask "$old_umask"
    echo "Could not create a private temporary YubiKey state file beside $yk_state_file." >&2
    return 1
  fi

  if ! {
    printf 'remote\t%s\n' "$yk_remote"
    printf 'usb_id\t%s\n' "$yk_usb_id"
    printf 'attempt_token\t%s\n' "$yk_attempt_token"
    printf 'phase\t%s\n' "$yk_phase"
    printf 'readiness\t%s\n' "$yk_readiness"
    printf 'busid\t%s\n' "$yk_active_busid"
    printf 'bind_state\t%s\n' "$yk_bind_state"
    printf 'bound_before\t%s\n' "$yk_bound_before"
    printf 'attach_state\t%s\n' "$yk_attach_state"
    printf 'tunnel_open\t%s\n' "$yk_tunnel_open"
    printf 'started_usbipd\t%s\n' "$yk_started_usbipd"
    printf 'usbipd_pid\t%s\n' "$yk_usbipd_pid"
    printf 'usbipd_pid_file_identity\t%s\n' "$yk_usbipd_pid_file_identity"
    printf 'usbipd_start_failed\t%s\n' "$yk_usbipd_start_failed"
    printf 'usbip_port\t%s\n' "$yk_usbip_port"
    printf 'usbipd_pid_file\t%s\n' "$yk_usbipd_pid_file"
  } >"$state_tmp"; then
    umask "$old_umask"
    runtime_artifact_status "$state_tmp" && rm -f -- "$state_tmp"
    return 1
  fi

  if [ "$state_status" -eq 1 ]; then
    if ! ln -T -- "$state_tmp" "$yk_state_file"; then
      umask "$old_umask"
      runtime_artifact_status "$state_tmp" && rm -f -- "$state_tmp"
      echo "Could not safely publish YubiKey state to $yk_state_file." >&2
      return 1
    fi
    rm -f -- "$state_tmp"
  else
    state_status=0
    yk_state_path_status || state_status=$?
    if [ "$state_status" -ne 0 ] || ! mv -fT -- "$state_tmp" "$yk_state_file"; then
      umask "$old_umask"
      runtime_artifact_status "$state_tmp" && rm -f -- "$state_tmp"
      return 1
    fi
  fi
  umask "$old_umask"
}

yk_load_state() {
  local path_status=0
  yk_state_path_status || path_status=$?
  if [ "$path_status" -eq 1 ]; then
    return 1
  fi
  if [ "$path_status" -ne 0 ]; then
    echo "Refusing to read unsafe YubiKey state file: $yk_state_file" >&2
    return 2
  fi

  local key
  local value
  local state_remote=""
  local state_usbip_port=""
  local state_usb_id=""
  local state_pid_file=""
  local state_pid_file_identity=""
  local bind_state_present=0
  local modern_state=0
  yk_reset_runtime_state
  yk_attempt_token=""

  while IFS=$'\t' read -r key value; do
    case "$key" in
      remote) state_remote="$value" ;;
      usb_id) state_usb_id="$value" ;;
      attempt_token) modern_state=1; yk_attempt_token="$value" ;;
      phase) modern_state=1; yk_phase="$value" ;;
      readiness) modern_state=1; yk_readiness="$value" ;;
      busid) yk_active_busid="$value" ;;
      bind_state) modern_state=1; bind_state_present=1; yk_bind_state="$value" ;;
      bound_before) modern_state=1; yk_bound_before="$value" ;;
      attach_state) modern_state=1; yk_attach_state="$value" ;;
      tunnel_open) modern_state=1; yk_tunnel_open="$value" ;;
      started_usbipd) yk_started_usbipd="$value" ;;
      usbipd_pid) yk_usbipd_pid="$value" ;;
      usbipd_pid_file_identity) state_pid_file_identity="$value" ;;
      usbipd_start_failed) yk_usbipd_start_failed="$value" ;;
      usbip_port) state_usbip_port="$value" ;;
      usbipd_pid_file) state_pid_file="$value" ;;
    esac
  done <"$yk_state_file"

  if [ "$state_remote" != "$yk_remote" ]; then
    echo "YubiKey state belongs to $state_remote, not $yk_remote: $yk_state_file" >&2
    return 2
  fi
  if [ -n "$state_usb_id" ]; then
    if [[ ! "$state_usb_id" =~ ^[[:xdigit:]]{1,4}:[[:xdigit:]]{1,4}$ ]]; then
      echo "YubiKey state has an invalid USB id: $yk_state_file" >&2
      return 2
    fi
    yk_usb_id="$state_usb_id"
  fi
  if [ -n "$state_usbip_port" ]; then
    if [[ ! "$state_usbip_port" =~ ^[0-9]+$ ]] ||
      [ "$((10#$state_usbip_port))" -lt 1 ] ||
      [ "$((10#$state_usbip_port))" -gt 65535 ]; then
      echo "YubiKey state has an invalid USB/IP port: $yk_state_file" >&2
      return 2
    fi
    yk_usbip_port="$((10#$state_usbip_port))"
  fi
  if [ -n "$state_pid_file" ]; then
    if ! yk_is_standard_pid_file "$state_pid_file"; then
      echo "YubiKey state has an invalid usbipd pid file: $yk_state_file" >&2
      return 2
    fi
    if [ -n "$state_usbip_port" ] &&
      [ "$state_pid_file" != "${XDG_RUNTIME_DIR:-/tmp}/remote-chrome-usbipd-${yk_usbip_port}.pid" ]; then
      echo "YubiKey state has inconsistent USB/IP port and pid file: $yk_state_file" >&2
      return 2
    fi
    yk_usbipd_pid_file="$state_pid_file"
  elif [ -n "$state_usbip_port" ]; then
    yk_usbipd_pid_file="${XDG_RUNTIME_DIR:-/tmp}/remote-chrome-usbipd-${yk_usbip_port}.pid"
  fi
  if [ -n "$state_pid_file_identity" ]; then
    if [[ ! "$state_pid_file_identity" =~ ^[0-9]+:[0-9]+:[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+[[:space:]][+-][0-9]{4}$ ]]; then
      echo "YubiKey state has an invalid usbipd pid file identity: $yk_state_file" >&2
      return 2
    fi
    yk_usbipd_pid_file_identity="$state_pid_file_identity"
  fi
  if [ "$modern_state" = "0" ]; then
    yk_readiness="unknown"
    if [ -n "$yk_active_busid" ]; then
      yk_phase="legacy-active"
    else
      yk_phase="legacy-provisional"
    fi
  fi
  [ -n "$yk_phase" ] || yk_phase="unknown"
  [ -n "$yk_readiness" ] || yk_readiness="unknown"
  case "$yk_tunnel_open" in
    0|1) ;;
    *)
      echo "YubiKey state has an invalid tunnel ownership flag: $yk_state_file" >&2
      return 2
      ;;
  esac
  case "$yk_bound_before" in
    0|1) ;;
    *)
      echo "YubiKey state has an invalid prior-bind flag: $yk_state_file" >&2
      return 2
      ;;
  esac
  case "$yk_attach_state" in
    none|attempting|attached) ;;
    *)
      echo "YubiKey state has an invalid remote-attach phase: $yk_state_file" >&2
      return 2
      ;;
  esac
  if [ "$bind_state_present" = "0" ] && [ -n "$yk_active_busid" ]; then
    # State written by v1.0.0 had no bind phase; a recorded bus ID represented
    # a successful bind and is safe to clean up exactly.
    yk_bind_state="bound"
  fi
  case "$yk_bind_state" in
    none|attempting|bound) ;;
    *)
      echo "YubiKey state has an invalid local bind phase: $yk_state_file" >&2
      return 2
      ;;
  esac
  if [ -z "$yk_attach_state" ] || {
    [ -n "$yk_active_busid" ] &&
      { [ "$yk_phase" = "idle" ] || [ "$yk_phase" = "attached" ] ||
        [ "$yk_phase" = "ready" ] || [ "$yk_phase" = "legacy-active" ]; };
  }; then
    yk_attach_state="attached"
  fi
  case "$yk_started_usbipd" in
    0|1) ;;
    *)
      echo "YubiKey state has an invalid usbipd ownership flag: $yk_state_file" >&2
      return 2
      ;;
  esac
  case "$yk_usbipd_start_failed" in
    0|1) ;;
    *)
      echo "YubiKey state has an invalid usbipd startup result: $yk_state_file" >&2
      return 2
      ;;
  esac
  if [ "$yk_usbipd_start_failed" = "1" ] &&
    { [ "$yk_started_usbipd" != "1" ] || [ -z "$yk_usbipd_pid_file_identity" ]; }; then
    echo "YubiKey state has incomplete failed usbipd startup evidence: $yk_state_file" >&2
    return 2
  fi
  if [ -n "$yk_usbipd_pid" ] && [[ ! "$yk_usbipd_pid" =~ ^[0-9]+$ ]]; then
    echo "YubiKey state has an invalid usbipd pid: $yk_state_file" >&2
    return 2
  fi
  if [ "$yk_started_usbipd" = "1" ] && [ -z "$yk_usbipd_pid" ] &&
    [ "$yk_phase" != "usbipd-starting" ] &&
    [ "$yk_phase" != "usbipd-started" ] && [ "$yk_phase" != "starting" ] &&
    [ "$yk_phase" != "cleanup-failed" ]; then
    echo "YubiKey state is missing the owned usbipd pid: $yk_state_file" >&2
    return 2
  fi
}

yk_ssh_deadline() {
  local seconds="${REMOTE_CHROME_SSH_TIMEOUT:-5}"
  if [[ "$seconds" =~ ^0*([1-9][0-9]*)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    printf '5\n'
  fi
}

yk_ssh_request() {
  # ConnectTimeout covers connection establishment only. Bound the complete
  # command/control request, including a peer that stalls after connecting.
  timeout --kill-after=1 "$(yk_ssh_deadline)" ssh "$@"
}

yk_ssh_request_incomplete() {
  # A deadline or local invocation failure cannot establish that a control
  # master is dead. Keep its socket and ledger available for a later retry.
  case "$1" in
    124|125|126|127|137) return 0 ;;
    *) return 1 ;;
  esac
}

yk_ssh() {
  yk_ssh_request -o BatchMode=yes -o ConnectTimeout="$(yk_ssh_deadline)" \
    -o ConnectionAttempts=1 "$yk_remote" "$@"
}

yk_sysfs_busids() {
  local candidate vendor product
  local wanted_vendor="${yk_usb_id%%:*}"
  local wanted_product="${yk_usb_id#*:}"
  wanted_vendor="${wanted_vendor,,}"
  wanted_product="${wanted_product,,}"

  for candidate in /sys/bus/usb/devices/*; do
    [ -d "$candidate" ] || continue
    [ -r "$candidate/idVendor" ] || continue
    [ -r "$candidate/idProduct" ] || continue
    vendor="$(tr -d '[:space:]' <"$candidate/idVendor" 2>/dev/null || true)"
    product="$(tr -d '[:space:]' <"$candidate/idProduct" 2>/dev/null || true)"
    if [ "${vendor,,}" = "$wanted_vendor" ] && [ "${product,,}" = "$wanted_product" ]; then
      basename -- "$candidate"
    fi
  done
}

yk_find_busids() {
  local sysfs_busids
  sysfs_busids="$(yk_sysfs_busids)"
  if [ -n "$sysfs_busids" ]; then
    printf '%s\n' "$sysfs_busids"
    return 0
  fi

  command -v usbip >/dev/null 2>&1 || return 0
  usbip list -l |
    awk -v wanted="${yk_usb_id,,}" '
      /^ - busid / {
        busid = $3
        id = $4
        gsub(/[()]/, "", id)
        if (tolower(id) == wanted) {
          print busid
        }
      }
    '
}

yk_first_busid() {
  yk_find_busids | sed -n '1p'
}

yk_owned_usbipd_running() {
  local pid="$1"
  local command_line
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [ "$(cat "/proc/$pid/comm" 2>/dev/null || true)" = "usbipd" ] || return 1
  command_line="$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null || true)"
  printf '%s\n' "$command_line" | grep -Fxq -- "--pid=$yk_usbipd_pid_file"
}

yk_standard_pid_files() {
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  local pid_file

  for pid_file in "$runtime_dir"/remote-chrome-usbipd-*.pid; do
    yk_is_standard_pid_file "$pid_file" || continue
    yk_pid_file_status "$pid_file" || continue
    printf '%s\n' "$pid_file"
  done
}

yk_pid_file_pid() {
  local pid_file="$1"
  local pid
  if ! yk_pid_file_status "$pid_file"; then
    return 1
  fi
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  # A PID file is a single numeric line.  Do not trim arbitrary content into
  # a value that could accidentally identify a different process.
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$pid"
}

yk_pid_file_pid_for_cleanup() {
  local pid_file="$1"
  local pid
  if pid="$(yk_pid_file_pid "$pid_file")"; then
    printf '%s\n' "$pid"
    return 0
  fi
  if ! yk_pid_file_status "$pid_file"; then
    return 1
  fi
  pid="$(sudo cat -- "$pid_file" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$pid"
}

yk_process_exists() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [ -e "/proc/$pid" ]
}

yk_wait_usbipd_exit() {
  local pid="$1"
  local timeout="${REMOTE_CHROME_USBIP_STOP_TIMEOUT:-3}"
  local attempt
  [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=3
  timeout="$((10#$timeout))"

  for ((attempt = 0; attempt <= timeout; attempt++)); do
    if ! yk_process_exists "$pid" || ! yk_owned_usbipd_running "$pid"; then
      return 0
    fi
    [ "$attempt" -lt "$timeout" ] || break
    sleep 1
  done
  return 1
}

yk_validate_usbipd_pid_file() {
  local expected_pid="$1"
  local file_pid

  if ! yk_pid_file_status "$yk_usbipd_pid_file"; then
    echo "Preserving unsafe usbipd pid file: $yk_usbipd_pid_file" >&2
    return 1
  fi
  file_pid="$(sudo cat "$yk_usbipd_pid_file" 2>/dev/null || true)"
  if [[ ! "$file_pid" =~ ^[0-9]+$ ]]; then
    echo "Preserving invalid owned usbipd pid file: $yk_usbipd_pid_file" >&2
    return 1
  fi
  if [ -n "$expected_pid" ] && [ "$file_pid" != "$expected_pid" ]; then
    echo "Preserving usbipd pid file with unexpected PID $file_pid (state expects $expected_pid): $yk_usbipd_pid_file" >&2
    return 1
  fi
  printf '%s\n' "$file_pid"
}

yk_orphan_usbipd_state() {
  local pid_file="$1"
  local pid
  local previous_pid_file="$yk_usbipd_pid_file"

  if pid="$(yk_pid_file_pid "$pid_file")"; then
    yk_usbipd_pid_file="$pid_file"
    if yk_owned_usbipd_running "$pid"; then
      printf '  orphan usbipd: %s pid=%s verified-owned\n' "$pid_file" "$pid"
    elif yk_process_exists "$pid"; then
      printf '  unverified usbipd pid file: %s pid=%s (preserved)\n' "$pid_file" "$pid"
    else
      printf '  stale usbipd pid file: %s pid=%s\n' "$pid_file" "$pid"
    fi
  else
    printf '  invalid usbipd pid file: %s (preserved)\n' "$pid_file"
  fi
  yk_usbipd_pid_file="$previous_pid_file"
}

yk_status_orphan_usbipd() {
  local pid_file
  local state_file
  local found=0

  while IFS= read -r pid_file; do
    [ -n "$pid_file" ] || continue
    local owned_by_state=0
    while IFS= read -r state_file; do
      [ -n "$state_file" ] || continue
      if yk_state_owns_pid_file "$state_file" "$pid_file"; then
        owned_by_state=1
        break
      fi
    done < <(yk_standard_state_files)
    [ "$owned_by_state" = "0" ] || continue
    found=1
    yk_orphan_usbipd_state "$pid_file"
  done < <(yk_standard_pid_files)

  [ "$found" = "1" ] || echo "  none"
}

yk_wait_local_usbipd() {
  local timeout="${REMOTE_CHROME_USBIP_TIMEOUT:-5}"
  local attempt
  [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=5
  [ "$timeout" -gt 0 ] || timeout=1
  timeout="$((10#$timeout))"
  for ((attempt = 0; attempt < timeout; attempt++)); do
    if ss -ltn | grep -q ":${yk_usbip_port}\\b"; then
      return 0
    fi
    sleep 1
  done
  echo "usbipd did not listen on local TCP port $yk_usbip_port within ${timeout}s." >&2
  return 1
}

yk_print_local_module_diagnostic() {
  local kernel
  local modules_root="${REMOTE_CHROME_MODULES_ROOT:-/lib/modules}"
  local dirs=""
  kernel="$(uname -r 2>/dev/null || echo unknown)"
  if [ -d "$modules_root" ]; then
    dirs="$(find "$modules_root" -mindepth 1 -maxdepth 1 -type d -printf '%f ' 2>/dev/null || true)"
  fi
  echo "Local USB/IP module diagnostics:" >&2
  echo "  running kernel: $kernel" >&2
  echo "  available $modules_root directories: ${dirs:-none}" >&2
  echo "  required module: usbip-host" >&2
  echo "  If the kernel was upgraded recently, reboot so the running kernel matches /lib/modules, then retry." >&2
}

yk_local_module_preflight() {
  local kernel
  local module_path=""
  local modules_root="${REMOTE_CHROME_MODULES_ROOT:-/lib/modules}"
  kernel="$(uname -r)"
  local module_tree="$modules_root/$kernel"

  if [ ! -d "$module_tree" ]; then
    yk_print_local_module_diagnostic
    return 1
  fi

  if command -v modinfo >/dev/null 2>&1; then
    if ! module_path="$(modinfo -n usbip-host 2>&1)"; then
      printf '%s\n' "$module_path" >&2
      yk_print_local_module_diagnostic
      return 1
    fi
  else
    module_path="$(find "$module_tree" -type f \( -name 'usbip-host.ko' -o -name 'usbip-host.ko.*' \) -print -quit 2>/dev/null || true)"
  fi

  if [ -z "$module_path" ] || [ ! -e "$module_path" ] || [[ "$module_path" != "$module_tree"/* ]]; then
    [ -n "$module_path" ] && printf 'Local modinfo usbip-host result: %s\n' "$module_path" >&2
    yk_print_local_module_diagnostic
    return 1
  fi
  return 0
}

yk_remote_module_preflight() {
  local remote_script
  # The variables in this script must expand on the remote host.
  # shellcheck disable=SC2016
  remote_script='set -u
kernel=$(uname -r 2>&1) || exit $?
printf "Remote USB/IP diagnostics (kernel): %s\\n" "$kernel" >&2
dirs=$(find /lib/modules -mindepth 1 -maxdepth 1 -type d -printf "%f " 2>/dev/null || true)
printf "Remote available /lib/modules directories: %s\\n" "${dirs:-none}" >&2
command -v usbip >/dev/null 2>&1 || { echo "Remote prerequisite missing: usbip" >&2; exit 127; }
command -v timeout >/dev/null 2>&1 || { echo "Remote prerequisite missing: timeout" >&2; exit 127; }
tree="/lib/modules/$kernel"
if [ ! -d "$tree" ]; then
  echo "Remote module tree is missing for running kernel $kernel." >&2
  echo "If the kernel was upgraded recently, reboot the remote host so it matches /lib/modules." >&2
  exit 1
fi
module_path=""
if command -v modinfo >/dev/null 2>&1; then
  module_path=$(modinfo -n vhci-hcd 2>&1) || { printf "%s\\n" "$module_path" >&2; exit 1; }
else
  module_path=$(find "$tree" -type f \( -name "vhci-hcd.ko" -o -name "vhci-hcd.ko.*" \) -print -quit 2>/dev/null || true)
fi
if [ -z "$module_path" ] || [ ! -e "$module_path" ] || [ "${module_path#"$tree"/}" = "$module_path" ]; then
  [ -n "$module_path" ] && printf "Remote modinfo vhci-hcd result: %s\\n" "$module_path" >&2
  echo "Remote vhci-hcd module is not available for running kernel $kernel." >&2
  echo "If the kernel was upgraded recently, reboot the remote host so it matches /lib/modules." >&2
  exit 1
fi
sudo -n modprobe vhci-hcd'

  yk_ssh "$remote_script"
}

yk_remote_module_check() {
  local remote_script
  # Doctor is deliberately read-only: unlike launch preflight this script
  # never invokes modprobe or any other privileged state change.
  # shellcheck disable=SC2016
  remote_script='set -u
kernel=$(uname -r 2>&1) || exit $?
command -v usbip >/dev/null 2>&1 || { echo "Remote prerequisite missing: usbip" >&2; exit 127; }
command -v timeout >/dev/null 2>&1 || { echo "Remote prerequisite missing: timeout" >&2; exit 127; }
tree="/lib/modules/$kernel"
if [ ! -d "$tree" ]; then
  echo "Remote module tree is missing for running kernel $kernel." >&2
  exit 1
fi
module_path=""
if command -v modinfo >/dev/null 2>&1; then
  module_path=$(modinfo -n vhci-hcd 2>&1) || { printf "%s\\n" "$module_path" >&2; exit 1; }
else
  module_path=$(find "$tree" -type f \( -name "vhci-hcd.ko" -o -name "vhci-hcd.ko.*" \) -print -quit 2>/dev/null || true)
fi
if [ -z "$module_path" ] || [ ! -e "$module_path" ] || [ "${module_path#"$tree"/}" = "$module_path" ]; then
  echo "Remote vhci-hcd module is not available for running kernel $kernel." >&2
  exit 1
fi
printf "Remote USB/IP prerequisites available (kernel %s).\\n" "$kernel"'
  yk_ssh "$remote_script"
}

doctor_check() {
  local label="$1"
  shift
  if "$@"; then
    echo "doctor: ok: $label"
    return 0
  fi
  echo "doctor: FAIL: $label" >&2
  return 1
}

doctor_local_display() {
  [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]
}

doctor_remote_chrome() {
  local host="$1"
  local chrome_command="$2"
  local notifications="$3"
  local quoted_chrome
  local python_requirement=""
  printf -v quoted_chrome '%q' "$chrome_command"
  if [ "$notifications" = "1" ]; then
    python_requirement=" && command -v python3 >/dev/null"
  fi
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" \
    "command -v bash >/dev/null && command -v waypipe >/dev/null && command -v xdg-dbus-proxy >/dev/null && command -v secret-tool >/dev/null && command -v ksecretd >/dev/null && command -v busctl >/dev/null$python_requirement && command -v $quoted_chrome >/dev/null"
}

doctor_notifications() {
  local host="$1"
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  local state_file="" candidate listener_pid listener_starttime apps probe_app marker delivered=0
  local attempt

  for candidate in "$runtime_dir"/remote-chrome-notify-*.state; do
    [ -f "$candidate" ] || continue
    if [ "$(notify_state_field "$candidate" host)" = "$host" ]; then
      state_file="$candidate"
      break
    fi
  done
  if [ -z "$state_file" ]; then
    echo "doctor: notifications: no live relay session for $host; skipping round-trip probe"
    return 0
  fi

  listener_pid="$(notify_state_field "$state_file" listener_pid)"
  listener_starttime="$(notify_state_field "$state_file" listener_starttime)"
  if [ -z "$listener_pid" ] ||
    ! kill -0 "$listener_pid" 2>/dev/null ||
    [ "$(notify_pid_starttime "$listener_pid" 2>/dev/null || true)" != "$listener_starttime" ]; then
    echo "doctor: FAIL: notification listener for $host is not running; relaunch or reset the session." >&2
    return 1
  fi

  apps="$(notify_state_field "$state_file" apps)"
  probe_app="${apps%%,*}"
  [ "$probe_app" = "*" ] && probe_app="chrome"
  marker="remote-chrome doctor probe ${BASHPID:-$$}.${SECONDS}.${RANDOM}"
  if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" \
    "busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications Notify susssasa{sv}i $(printf '%q' "$probe_app") 0 '' $(printf '%q' "$marker") $(printf '%q' 'Checking remote notification delivery') 0 0 5000" >/dev/null 2>&1; then
    echo "doctor: FAIL: remote notification probe failed; notifications will not be forwarded." >&2
    return 1
  fi

  for ((attempt = 0; attempt < 50; attempt++)); do
    if awk -F '\t' -v marker="$marker" '$2 == "delivered" && index($0, marker) {found=1} END {exit !found}' \
      "${state_file}.log" 2>/dev/null; then
      delivered=1
      break
    fi
    sleep 0.1
  done
  if [ "$delivered" = "1" ]; then
    echo "doctor: ok: notification round-trip through the local notification daemon"
    return 0
  fi
  echo "doctor: FAIL: probe was sent but never delivered locally; inspect ${state_file}.log and the ssh -R forward." >&2
  return 1
}

doctor_chrome_command() {
  (chrome_process_pattern "$1" >/dev/null)
}

doctor_chrome_secret_identity() {
  (chrome_secret_identity "$1" >/dev/null)
}

doctor_local_command() {
  command -v "$1" >/dev/null 2>&1
}

doctor_local_key() {
  yk_local_candidate_exists
}

chrome_doctor() {
  local host=""
  local chrome_command="${REMOTE_CHROME_COMMAND:-google-chrome-stable}"
  local yubikey_mode="auto"
  local yk_args=()
  local code=0
  local command_name
  local local_key=0
  local notifications_default=1

  case "${REMOTE_CHROME_NOTIFICATIONS:-1}" in
    0|no|off|false|FALSE|NO|OFF) notifications_default=0 ;;
  esac

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --chrome-command)
        [ "$#" -ge 2 ] || die "$1 requires a command."
        chrome_command="$2"
        shift 2
        ;;
      --chrome-command=*)
        chrome_command="${1#*=}"
        shift
        ;;
      --with-yubikey)
        yubikey_mode="force"
        shift
        ;;
      --no-yubikey)
        yubikey_mode="off"
        shift
        ;;
      --yubikey-usb-id)
        [ "$#" -ge 2 ] || die "$1 requires a USB id."
        yk_args+=("--usb-id" "$2")
        shift 2
        ;;
      --yubikey-usb-id=*)
        yk_args+=("--usb-id" "${1#*=}")
        shift
        ;;
      --yubikey-port)
        [ "$#" -ge 2 ] || die "$1 requires a port."
        yk_args+=("--port" "$2")
        shift 2
        ;;
      --yubikey-port=*)
        yk_args+=("--port" "${1#*=}")
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      -*)
        die "Unknown doctor option: $1"
        ;;
      *)
        [ -z "$host" ] || die "Unexpected argument: $1"
        host="$1"
        shift
        ;;
    esac
  done

  [ -n "$host" ] || die "Remote host is required. Example: $PROGRAM doctor HOST"
  if [ "$yubikey_mode" != "off" ]; then
    yk_prepare_for_launch "$host" "${yk_args[@]}"
  else
    # Chrome-only doctor must not parse or validate YubiKey settings.
    yk_remote="$host"
  fi

  if ! doctor_check "local graphical display variables" doctor_local_display; then
    echo "doctor: set WAYLAND_DISPLAY or DISPLAY from a graphical session before launching." >&2
    code=1
  fi
  for command_name in ssh waypipe tmux; do
    if ! doctor_check "local command: $command_name" doctor_local_command "$command_name"; then
      code=1
    fi
  done
  if [ "$notifications_default" = "1" ]; then
    if ! doctor_check "local command: python3" doctor_local_command python3; then
      code=1
    fi
    if ! doctor_check "local command: notify-send" doctor_local_command notify-send; then
      echo "doctor: install python3 and libnotify (notify-send) to forward remote notifications." >&2
      code=1
    fi
  else
    echo "doctor: notifications disabled by REMOTE_CHROME_NOTIFICATIONS; skipping relay command checks."
  fi
  if ! doctor_check "Chrome command is a simple executable name/path" doctor_chrome_command "$chrome_command"; then
    code=1
  fi
  if ! doctor_check "Chrome Safe Storage identity mapping" doctor_chrome_secret_identity "$chrome_command"; then
    code=1
  fi
  if ! doctor_check "detached SSH reachability and remote waypipe/$chrome_command" \
    doctor_remote_chrome "$host" "$chrome_command" "$notifications_default"; then
    echo "doctor: verify BatchMode SSH and install bash, waypipe, xdg-dbus-proxy, secret-tool, ksecretd, busctl, python3, plus $chrome_command on $host." >&2
    code=1
  fi
  if ! doctor_notifications "$host"; then
    code=1
  fi

  if [ "$yubikey_mode" = "off" ]; then
    echo "doctor: YubiKey checks skipped by --no-yubikey."
  else
    if yk_local_candidate_exists; then
      local_key=1
      echo "doctor: ok: local YubiKey with USB id $yk_usb_id is visible"
    elif [ "$yubikey_mode" = "force" ]; then
      echo "doctor: FAIL: local YubiKey with USB id $yk_usb_id is visible" >&2
      echo "doctor: no matching local YubiKey found; --with-yubikey cannot proceed." >&2
      code=1
    else
      echo "doctor: warning: no local YubiKey found; auto mode will launch without forwarding."
    fi

    if [ "$yubikey_mode" = "force" ] || [ "$local_key" = "1" ]; then
      for command_name in usbip ss timeout; do
        if ! doctor_check "local command: $command_name" doctor_local_command "$command_name"; then
          code=1
        fi
      done
      if ! doctor_check "local usbip-host module is available for the running kernel" yk_local_module_preflight; then
        code=1
      fi
      if ! doctor_check "remote usbip/vhci-hcd prerequisites (read-only)" yk_remote_module_check; then
        echo "doctor: remote module check never loads modules; repair the remote kernel/module tree before launch." >&2
        code=1
      fi
    else
      echo "doctor: USB/IP module checks skipped because auto mode found no local key."
    fi
  fi

  if [ "$code" = "0" ]; then
    echo "doctor: healthy"
  else
    echo "doctor: degraded; repair the failed checks before launching." >&2
  fi
  return "$code"
}

yk_ensure_local_ready() {
  local pid_file_status=0
  local existing_pid=""
  local reserved_pid_identity=""

  yk_pid_file_status "$yk_usbipd_pid_file" || pid_file_status=$?
  if [ "$pid_file_status" -eq 2 ]; then
    echo "Refusing to use unsafe usbipd pid path: $yk_usbipd_pid_file" >&2
    return 1
  fi

  need ssh
  need usbip
  need ss
  need timeout

  sudo -v || return $?

  if [ "$pid_file_status" -eq 0 ]; then
    existing_pid="$(sudo cat -- "$yk_usbipd_pid_file" 2>/dev/null || true)"
    if [[ ! "$existing_pid" =~ ^[0-9]+$ ]]; then
      echo "An invalid usbipd pid file is present at $yk_usbipd_pid_file; preserving it." >&2
      return 1
    fi
  fi

  yk_local_module_preflight || return $?

  if ! sudo modprobe usbip-host; then
    echo "Could not load local usbip-host for running kernel $(uname -r)." >&2
    yk_print_local_module_diagnostic
    return 1
  fi

  if ! ss -ltn | grep -q ":${yk_usbip_port}\\b"; then
    if [ "$pid_file_status" -eq 0 ]; then
      if yk_owned_usbipd_running "$existing_pid"; then
        echo "An owned usbipd process is recorded but not listening on port $yk_usbip_port; refusing to overwrite $yk_usbipd_pid_file." >&2
        return 1
      fi
      if yk_process_exists "$existing_pid"; then
        echo "An unverified process owns usbipd pid file $yk_usbipd_pid_file; preserving it." >&2
        return 1
      fi
      yk_remove_pid_file "$yk_usbipd_pid_file" "$existing_pid" || return 1
    fi

    yk_reserve_pid_file || return 1
    reserved_pid_identity="$(runtime_path_identity "$yk_usbipd_pid_file")" || reserved_pid_identity=""
    [ -n "$reserved_pid_identity" ] || return 1
    yk_started_usbipd=1
    yk_phase="usbipd-starting"
    # Record ownership before invoking the daemon so a signal during startup
    # still gives rollback a pid-file path to inspect.
    if ! yk_write_state; then
      if [ "$(runtime_path_identity "$yk_usbipd_pid_file")" = "$reserved_pid_identity" ]; then
        yk_remove_pid_file "$yk_usbipd_pid_file" || true
      fi
      yk_started_usbipd=0
      return 1
    fi
    if ! sudo usbipd --daemon --pid="$yk_usbipd_pid_file" \
      --tcp-port "$yk_usbip_port" >/dev/null 2>&1; then
      yk_usbipd_start_failed=1
      if ! yk_write_state; then
        echo "Could not persist the failed usbipd startup result; preserving its PID reservation." >&2
      fi
      echo "Could not start usbipd on local port $yk_usbip_port." >&2
      return 1
    fi
    if ! yk_usbipd_pid="$(yk_validate_usbipd_pid_file "")"; then
      return 1
    fi
    if [[ ! "$yk_usbipd_pid" =~ ^[0-9]+$ ]]; then
      echo "usbipd started without recording a valid pid in $yk_usbipd_pid_file." >&2
      return 1
    fi
    yk_usbipd_pid_file_identity=""
    yk_usbipd_start_failed=0
    if ! yk_owned_usbipd_running "$yk_usbipd_pid"; then
      echo "usbipd started with pid $yk_usbipd_pid but exact ownership could not be verified; preserving recovery state." >&2
      return 1
    fi
    yk_phase="usbipd-started"
    # Persist the validated daemon PID before subsequent visibility/attach
    # work so an interruption can still stop this daemon through `stop HOST`.
    yk_write_state || return $?
    yk_wait_local_usbipd || return $?
  elif [ "$pid_file_status" -eq 0 ]; then
    yk_usbipd_pid="$existing_pid"
    if yk_owned_usbipd_running "$yk_usbipd_pid"; then
      yk_started_usbipd=1
    else
      yk_usbipd_pid=""
      echo "Preserving unverified usbipd pid file $yk_usbipd_pid_file." >&2
    fi
  fi
}

yk_ensure_remote_ready() {
  if ! yk_remote_module_preflight; then
    echo "Remote YubiKey preflight failed for $yk_remote (kernel/module/sudo/usbip check)." >&2
    return 1
  fi
}

yk_remote_forward_port_available() {
  # Read the remote kernel socket tables directly so this check does not add a
  # remote ss/lsof dependency or require privileges. Exit 23 is reserved for a
  # confirmed listener; other failures mean availability could not be proven.
  yk_ssh 'bash -s' -- "$yk_usbip_port" <<'REMOTE_SCRIPT'
set -u
port="$1"
printf -v wanted_port '%04X' "$port" || exit 2
checked=0

for table in /proc/net/tcp /proc/net/tcp6; do
  [ -r "$table" ] || continue
  checked=1
  while read -r slot local_address remote_address state rest; do
    [ "$state" = "0A" ] || continue
    [ "${local_address##*:}" = "$wanted_port" ] || continue
    exit 23
  done <"$table"
done

if [ "$checked" != "1" ]; then
  echo "Remote TCP listener tables are unavailable." >&2
  exit 2
fi
exit 0
REMOTE_SCRIPT
}

yk_preflight_for_tmux() {
  yk_preflight_for_forwarding 1
}

yk_preflight_for_forwarding() {
  need ssh
  need usbip
  need ss
  need timeout
  # Local sudo may authenticate interactively before a detached session is
  # created; only remote sudo is required to be noninteractive.
  sudo -v || die "YubiKey forwarding needs local sudo for usbip."
  yk_local_module_preflight || die "Local YubiKey USB/IP preflight failed."
  if ! sudo modprobe usbip-host; then
    echo "Local sudo could not load usbip-host for running kernel $(uname -r)." >&2
    yk_print_local_module_diagnostic
    die "Local YubiKey USB/IP preflight failed."
  fi
  yk_remote_module_preflight || die "Remote YubiKey USB/IP preflight failed for $yk_remote."
  yk_local_candidate_exists ||
    die "No local YubiKey found with USB id $yk_usb_id."

  local remote_port_code=0
  yk_remote_forward_port_available || remote_port_code=$?
  case "$remote_port_code" in
    0) ;;
    23)
      echo "Remote USB/IP reverse-forward port $yk_usbip_port is already listening on $yk_remote." >&2
      echo "This can be a stale SSH tunnel after the forwarding host reboots; wait for the remote SSH server to expire it or inspect that listener." >&2
      die "Refusing to stop remote Chrome because YubiKey forwarding cannot start."
      ;;
    *)
      die "Could not verify that remote USB/IP reverse-forward port $yk_usbip_port is available on $yk_remote."
      ;;
  esac
}

yk_local_candidate_exists() {
  [ -n "$(yk_first_busid)" ]
}

yk_close_tunnel() {
  local code=0
  local socket_status=0
  local request_code=0

  yk_control_socket_status || socket_status=$?
  if [ "$socket_status" -eq 2 ]; then
    echo "Preserving unsafe SSH control socket path $yk_control_socket." >&2
    return 1
  fi
  if [ "$socket_status" -eq 0 ]; then
    # -O exit may fail when the peer already died; unlinking the exact
    # recorded socket still completes cleanup in that case.  If the socket
    # survives, however, retain state so stop can be retried.
    yk_ssh_request -S "$yk_control_socket" -O exit "$yk_remote" >/dev/null 2>&1 || request_code=$?
    if yk_ssh_request_incomplete "$request_code"; then
      echo "SSH control exit did not complete; preserving $yk_control_socket for retry." >&2
      return 1
    fi
    socket_status=0
    yk_control_socket_status || socket_status=$?
    if [ "$socket_status" -eq 2 ]; then
      echo "SSH control socket path changed during cleanup; preserving $yk_control_socket." >&2
      return 1
    fi
  fi
  if [ "$socket_status" -eq 0 ]; then
    if ! unlink -- "$yk_control_socket" >/dev/null 2>&1; then
      echo "Could not remove SSH control socket $yk_control_socket." >&2
      code=1
    fi
  fi
  if runtime_path_present "$yk_control_socket"; then
    echo "SSH control socket remains after cleanup: $yk_control_socket" >&2
    code=1
  else
    yk_tunnel_open=0
  fi
  return "$code"
}

yk_open_tunnel() {
  local socket_status=0
  local request_code=0
  yk_control_socket_status || socket_status=$?
  if [ "$socket_status" -eq 2 ]; then
    echo "Refusing to use unsafe SSH control socket path $yk_control_socket." >&2
    return 1
  fi
  if [ "$socket_status" -eq 0 ]; then
    if yk_ssh_request -S "$yk_control_socket" -O check "$yk_remote" >/dev/null 2>&1; then
      yk_tunnel_open=1
      return
    else
      request_code=$?
    fi
    if yk_ssh_request_incomplete "$request_code"; then
      echo "SSH control check did not complete; preserving $yk_control_socket." >&2
      return 1
    fi
    socket_status=0
    yk_control_socket_status || socket_status=$?
    if [ "$socket_status" -eq 2 ] ||
      { [ "$socket_status" -eq 0 ] && ! unlink -- "$yk_control_socket"; }; then
      echo "Could not safely remove stale SSH control socket $yk_control_socket." >&2
      return 1
    fi
  fi

  yk_ssh_request -M -S "$yk_control_socket" -fN \
    -o ExitOnForwardFailure=yes \
    -o BatchMode=yes -o ConnectTimeout="$(yk_ssh_deadline)" \
    -o ConnectionAttempts=1 \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=2 \
    -R "127.0.0.1:${yk_usbip_port}:127.0.0.1:${yk_usbip_port}" \
    "$yk_remote" || return $?

  local timeout="${REMOTE_CHROME_TUNNEL_TIMEOUT:-5}"
  local attempt
  [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=5
  [ "$timeout" -gt 0 ] || timeout=1
  timeout="$((10#$timeout))"
  for ((attempt = 0; attempt < timeout; attempt++)); do
    if yk_ssh_request -S "$yk_control_socket" -O check "$yk_remote" >/dev/null 2>&1; then
      yk_tunnel_open=1
      return 0
    else
      request_code=$?
    fi
    if yk_ssh_request_incomplete "$request_code"; then
      echo "SSH tunnel readiness check did not complete; preserving $yk_control_socket." >&2
      return 1
    fi
    sleep 1
  done
  echo "SSH USB/IP tunnel did not become ready within ${timeout}s for $yk_remote." >&2
  return 1
}

yk_remote_detach_busid() {
  local busid="$1"
  yk_ssh 'bash -s' -- "$busid" "$yk_usbip_port" <<'REMOTE_SCRIPT'
busid="$1"
usbip_port="$2"

platform_devices=/sys/bus/platform/devices
if [ ! -d "$platform_devices" ]; then
  echo "Could not inspect remote platform devices while detaching busid $busid." >&2
  exit 1
fi
if [ ! -e "$platform_devices/vhci_hcd.0" ]; then
  # The USB/IP import controller does not exist after a remote reboot until
  # vhci_hcd is loaded again, so no imported device can still be attached.
  exit 0
fi

if ! port_output="$(timeout 5 sudo -n usbip port 2>&1)"; then
  echo "Could not inspect remote USB/IP ports while detaching busid $busid:" >&2
  printf '%s\n' "$port_output" >&2
  exit 1
fi

ports="$(printf '%s\n' "$port_output" |
  awk -v wanted="usbip://127.0.0.1:$usbip_port/$busid" '
    /^Port [0-9]+:/ {
      port = $2
      sub(":", "", port)
    }
    {
      for (field = 1; field <= NF; field++) {
        if ($field == wanted && port != "") {
          print port
          break
        }
      }
    }
  ')"

detach_failed=0
while IFS= read -r port; do
  [ -n "$port" ] || continue
  if ! timeout 5 sudo -n usbip detach -p "$port" >/dev/null; then
    echo "Could not detach remote USB/IP port $port for busid $busid." >&2
    detach_failed=1
  fi
done <<<"$ports"
exit "$detach_failed"
REMOTE_SCRIPT
}

yk_remote_probe_attachment() {
  local busid="$1"
  local output=""

  if ! output="$(yk_ssh 'bash -s' -- "$busid" "$yk_usbip_port" 2>&1 <<'REMOTE_SCRIPT'
busid="$1"
usbip_port="$2"

platform_devices=/sys/bus/platform/devices
if [ ! -d "$platform_devices" ]; then
  echo "Could not inspect remote platform devices while reconciling busid $busid." >&2
  exit 2
fi
if [ ! -e "$platform_devices/vhci_hcd.0" ]; then
  # The import controller and every attachment disappear together on reboot.
  printf '%s\n' absent
  exit 0
fi

if ! port_output="$(timeout 5 sudo -n usbip port 2>&1)"; then
  echo "Could not inspect remote USB/IP ports while reconciling busid $busid:" >&2
  printf '%s\n' "$port_output" >&2
  exit 2
fi

ports="$(printf '%s\n' "$port_output" |
  awk -v wanted="usbip://127.0.0.1:$usbip_port/$busid" '
    /^Port [0-9]+:/ {
      port = $2
      sub(":", "", port)
    }
    {
      for (field = 1; field <= NF; field++) {
        if ($field == wanted && port != "") {
          print port
          break
        }
      }
    }
  ')"

if [ -n "$ports" ]; then
  printf '%s\n' attached
else
  printf '%s\n' absent
fi
REMOTE_SCRIPT
)"; then
    [ -n "$output" ] && printf '%s\n' "$output" >&2
    echo "Could not determine whether remote USB/IP busid $busid is attached; preserving recovery state." >&2
    return 2
  fi

  case "$output" in
    *attached*) return 0 ;;
    *absent*) return 1 ;;
    *)
      [ -n "$output" ] && printf '%s\n' "$output" >&2
      echo "Remote USB/IP attachment probe returned an invalid result for busid $busid; preserving recovery state." >&2
      return 2
      ;;
  esac
}

yk_reconcile_local_bind() {
  local bind_code=0

  [ -n "$yk_active_busid" ] || return 0
  case "$yk_bind_state" in
    none)
      return 0
      ;;
    attempting|bound)
      if yk_local_busid_bound "$yk_active_busid"; then
        echo "Recorded local USB/IP busid $yk_active_busid is still bound; retry stop before launching." >&2
        return 1
      else
        bind_code=$?
      fi
      if [ "$bind_code" -ne 1 ]; then
        echo "Could not determine whether local USB/IP busid $yk_active_busid is bound; preserving recovery state." >&2
        return 2
      fi
      return 0
      ;;
    *)
      echo "Cannot reconcile unknown local bind ownership state '$yk_bind_state' for busid $yk_active_busid." >&2
      return 2
      ;;
  esac
}

yk_reconcile_tunnel() {
  local socket_output=""
  local socket_status=0
  local request_code=0

  yk_control_socket_status || socket_status=$?
  if [ "$socket_status" -eq 2 ]; then
    echo "Unsafe SSH control socket path; preserving recovery state: $yk_control_socket" >&2
    return 2
  fi
  if [ "$yk_tunnel_open" != "1" ] &&
    [ "$socket_status" -eq 1 ]; then
    return 0
  fi

  if [ "$socket_status" -eq 0 ]; then
    socket_output="$(yk_ssh_request -S "$yk_control_socket" -O check "$yk_remote" 2>&1)" || request_code=$?
    if [ "$request_code" -eq 0 ]; then
      echo "Recorded SSH USB/IP tunnel is still alive ($yk_control_socket); retry stop before launching." >&2
      return 1
    fi
    if yk_ssh_request_incomplete "$request_code"; then
      echo "SSH control check did not complete; preserving recovery state: $yk_control_socket" >&2
      return 2
    fi
  fi

  # A failed control-master check means the exact recorded socket no longer
  # has a live SSH peer.  Remove only that path; a live socket was handled
  # above and is never auto-cleaned during launch reconciliation.
  if [ "$socket_status" -eq 0 ]; then
    socket_status=0
    yk_control_socket_status || socket_status=$?
    if [ "$socket_status" -ne 0 ]; then
      [ -n "$socket_output" ] && printf '%s\n' "$socket_output" >&2
      echo "SSH control socket changed during reconciliation: $yk_control_socket" >&2
      return 2
    fi
    if ! unlink -- "$yk_control_socket"; then
      [ -n "$socket_output" ] && printf '%s\n' "$socket_output" >&2
      echo "Could not remove stale SSH USB/IP control socket $yk_control_socket; preserving recovery state." >&2
      return 2
    fi
  fi
  if runtime_path_present "$yk_control_socket"; then
    echo "SSH USB/IP control socket remains after reconciliation: $yk_control_socket" >&2
    return 1
  fi
  return 0
}

yk_reconcile_usbipd() {
  local pid_file_pid=""
  local pid_file_status=0

  [ "$yk_started_usbipd" = "1" ] || return 0
  if [ -n "$yk_usbipd_pid" ] && [[ ! "$yk_usbipd_pid" =~ ^[0-9]+$ ]]; then
    echo "Owned usbipd has an invalid recorded PID; preserving recovery state." >&2
    return 2
  fi
  if [ -z "$yk_usbipd_pid" ] && [ "$yk_usbipd_start_failed" = "1" ]; then
    if yk_stop_owned_usbipd; then
      return 0
    fi
    return 2
  fi
  yk_pid_file_status "$yk_usbipd_pid_file" || pid_file_status=$?
  if [ "$pid_file_status" -eq 2 ]; then
    echo "Unsafe usbipd pid file; preserving recovery state: $yk_usbipd_pid_file" >&2
    return 2
  fi
  if [ "$pid_file_status" -eq 0 ]; then
    if ! pid_file_pid="$(yk_validate_usbipd_pid_file "$yk_usbipd_pid")"; then
      return 2
    fi
    if [ -n "$yk_usbipd_pid" ] && [ "$pid_file_pid" != "$yk_usbipd_pid" ]; then
      echo "Owned usbipd pid file changed from $yk_usbipd_pid to $pid_file_pid; preserving recovery state." >&2
      return 2
    fi
    [ -n "$yk_usbipd_pid" ] || yk_usbipd_pid="$pid_file_pid"
  fi

  if [ -z "$yk_usbipd_pid" ]; then
    echo "Owned usbipd has no recorded PID; cannot prove that the daemon is gone." >&2
    return 2
  fi
  if yk_owned_usbipd_running "$yk_usbipd_pid"; then
    if [ "$yk_stop_usbipd" != "1" ]; then
      echo "Leaving verified owned usbipd pid $yk_usbipd_pid running by request; launch reconciliation can proceed." >&2
      return 0
    fi
    if yk_other_exports_exist; then
      echo "Leaving verified owned usbipd pid $yk_usbipd_pid because other USB/IP exports remain; launch reconciliation can proceed." >&2
      return 0
    fi
    echo "Verified owned usbipd pid $yk_usbipd_pid is still running; retry stop before launching." >&2
    return 1
  fi
  if yk_process_exists "$yk_usbipd_pid"; then
    echo "Cannot verify ownership of live usbipd pid $yk_usbipd_pid; preserving recovery state." >&2
    return 2
  fi

  # A dead, exactly recorded daemon may leave only its PID file behind.  Use
  # the existing exact ownership validator to remove that stale evidence.
  if ! yk_stop_owned_usbipd; then
    echo "Could not reconcile the recorded usbipd pid $yk_usbipd_pid; preserving recovery state." >&2
    return 2
  fi
  return 0
}

yk_reconcile_cleanup_failed_unlocked() {
  local probe_code=0

  if [ "$yk_phase" != "cleanup-failed" ]; then
    return 1
  fi
  if [ -n "$yk_active_busid" ] && [ "$yk_attach_state" != "none" ]; then
    if [ -z "$yk_remote" ]; then
      echo "Cleanup-failed state has a remote attachment but no remote host; preserving recovery state." >&2
      return 2
    fi
    yk_remote_probe_attachment "$yk_active_busid" || probe_code=$?
    case "$probe_code" in
      0)
        echo "Remote USB/IP busid $yk_active_busid is still attached; retry stop before launching." >&2
        return 1
        ;;
      1)
        # An absent remote port is the expected success result for this
        # reconciliation probe; do not carry its false-status code into the
        # remaining local/tunnel/daemon checks.
        probe_code=0
        ;;
      *) return 2 ;;
    esac
  fi

  yk_reconcile_local_bind || probe_code=$?
  [ "$probe_code" = "0" ] || return "$probe_code"

  yk_reconcile_tunnel || probe_code=$?
  [ "$probe_code" = "0" ] || return "$probe_code"

  yk_reconcile_usbipd || probe_code=$?
  [ "$probe_code" = "0" ] || return "$probe_code"

  return 0
}

yk_reconcile_cleanup_failed() {
  local initial_code=0
  local load_code=0
  local reconcile_code=0
  local previous_exit_trap

  yk_load_state || load_code=$?
  if [ "$load_code" -eq 1 ]; then
    return 0
  fi
  [ "$load_code" -eq 0 ] || return 2
  [ "$yk_phase" = "cleanup-failed" ] || return 1

  if ! yk_cleanup_lock_acquire; then
    return 2
  fi
  previous_exit_trap="$(trap -p EXIT || true)"
  trap 'yk_cleanup_lock_release_on_exit' EXIT

  # Reload after taking the cleanup lock.  A concurrent stop may have
  # completed or advanced the ledger while the launch was waiting.
  yk_load_state || initial_code=$?
  if [ "$initial_code" -eq 0 ] && [ "$yk_phase" = "cleanup-failed" ]; then
    yk_reconcile_cleanup_failed_unlocked || reconcile_code=$?
    if [ "$reconcile_code" -eq 0 ]; then
      if ! yk_write_state; then
        echo "Could not persist reconciled YubiKey cleanup progress; preserving recovery state." >&2
        reconcile_code=2
      fi
    fi
    if [ "$reconcile_code" -eq 0 ]; then
      if [ -n "$yk_log_file" ] && ! yk_remove_runtime_artifact "$yk_log_file"; then
        echo "Could not remove reconciled YubiKey cleanup log $yk_log_file; preserving recovery state." >&2
        reconcile_code=2
      fi
      if [ "$reconcile_code" -eq 0 ] && runtime_path_present "$yk_attempt_lock"; then
        if ! runtime_owned_directory "$yk_attempt_lock" || ! rmdir -- "$yk_attempt_lock"; then
          echo "Could not remove reconciled YubiKey attempt lock $yk_attempt_lock; preserving recovery state." >&2
          reconcile_code=2
        fi
      fi
      if [ "$reconcile_code" -eq 0 ] && ! yk_remove_runtime_artifact "$yk_state_file"; then
        echo "Could not remove reconciled YubiKey recovery state $yk_state_file; preserving recovery state." >&2
        reconcile_code=2
      fi
      if [ "$reconcile_code" -eq 0 ]; then
        echo "Reconciled stale YubiKey cleanup state for $yk_remote; continuing launch."
      fi
    fi
  elif [ "$initial_code" -eq 1 ]; then
    reconcile_code=0
  else
    reconcile_code=2
  fi

  if ! yk_cleanup_lock_release; then
    reconcile_code=2
  fi
  if [ -n "$previous_exit_trap" ]; then
    eval "$previous_exit_trap"
  else
    trap - EXIT
  fi
  return "$reconcile_code"
}

yk_other_exports_exist() {
  local candidate name
  for candidate in "$yk_usbip_host_sysfs"/*; do
    [ -e "$candidate" ] || [ -L "$candidate" ] || continue
    name="${candidate##*/}"
    # usbip-host/module is a permanent driver symlink, not an export.
    [ "$name" = "module" ] && continue
    [[ "$name" =~ ^[0-9]+-[0-9] ]] || continue
    return 0
  done
  return 1
}

yk_stop_owned_usbipd() {
  local pid_file_status=0
  [ "$yk_started_usbipd" = "1" ] || return 0

  if [ -n "$yk_usbipd_pid" ] && [[ ! "$yk_usbipd_pid" =~ ^[0-9]+$ ]]; then
    echo "Owned usbipd has an invalid recorded PID; preserving recovery state." >&2
    return 1
  fi

  yk_pid_file_status "$yk_usbipd_pid_file" || pid_file_status=$?
  if [ "$pid_file_status" -eq 2 ]; then
    echo "Preserving unsafe usbipd pid file: $yk_usbipd_pid_file" >&2
    return 1
  fi
  if [ "$pid_file_status" -eq 0 ]; then
    if [ -z "$yk_usbipd_pid" ]; then
      local file_size=""
      file_size="$(stat -c '%s' -- "$yk_usbipd_pid_file" 2>/dev/null)" || file_size=""
      if [ "$file_size" = "0" ]; then
        yk_remove_failed_usbipd_reservation || return 1
        yk_started_usbipd=0
        yk_usbipd_pid=""
        yk_usbipd_pid_file_identity=""
        yk_usbipd_start_failed=0
        return 0
      fi
    fi
    local pid_file_pid
    if ! pid_file_pid="$(yk_validate_usbipd_pid_file "$yk_usbipd_pid")"; then
      return 1
    fi
    if [ -z "$yk_usbipd_pid" ]; then
      yk_usbipd_pid="$pid_file_pid"
    fi
  fi

  if [ -z "$yk_usbipd_pid" ]; then
    echo "Owned usbipd has no recorded PID; preserving recovery state." >&2
    return 1
  fi

  local owned=0
  if yk_owned_usbipd_running "$yk_usbipd_pid"; then
    owned=1
  elif yk_process_exists "$yk_usbipd_pid"; then
    echo "Refusing to stop unverified process at usbipd pid $yk_usbipd_pid; preserving recovery state." >&2
    return 1
  fi

  if [ "$owned" = "1" ]; then
    if [ "$yk_stop_usbipd" != "1" ]; then
      echo "Leaving tool-started usbipd pid $yk_usbipd_pid running by request."
      return 0
    fi

    if yk_other_exports_exist; then
      echo "Leaving tool-started usbipd running because other USB/IP exports remain." >&2
      return 0
    fi

    # Re-check exact ownership immediately before the destructive signal.
    if ! yk_owned_usbipd_running "$yk_usbipd_pid"; then
      echo "Refusing to stop usbipd pid $yk_usbipd_pid after ownership changed; preserving recovery state." >&2
      return 1
    fi
    if ! sudo kill "$yk_usbipd_pid" >/dev/null 2>&1; then
      echo "Could not stop owned usbipd pid $yk_usbipd_pid." >&2
      return 1
    fi
    # A mocked or very short-lived process may disappear immediately.  Wait a
    # bounded interval for a real verified process before retaining the ledger.
    if ! yk_wait_usbipd_exit "$yk_usbipd_pid"; then
      echo "Owned usbipd pid $yk_usbipd_pid is still running after kill." >&2
      return 1
    fi
    if yk_process_exists "$yk_usbipd_pid"; then
      echo "Refusing to remove usbipd pid file after ownership changed for pid $yk_usbipd_pid." >&2
      return 1
    fi
  fi

  pid_file_status=0
  yk_pid_file_status "$yk_usbipd_pid_file" || pid_file_status=$?
  if [ "$pid_file_status" -eq 2 ]; then
    echo "Preserving unsafe usbipd pid file: $yk_usbipd_pid_file" >&2
    return 1
  elif [ "$pid_file_status" -eq 0 ]; then
    if ! yk_validate_usbipd_pid_file "$yk_usbipd_pid" >/dev/null; then
      return 1
    fi
    yk_remove_pid_file "$yk_usbipd_pid_file" "$yk_usbipd_pid" || return 1
  fi
  yk_started_usbipd=0
  yk_usbipd_pid=""
  yk_usbipd_pid_file_identity=""
  yk_usbipd_start_failed=0
  return 0
}

yk_stop_orphan_usbipd_files() {
  local pid_file
  local state_file
  local pid
  local final_pid
  local previous_pid_file="$yk_usbipd_pid_file"
  local code=0
  local found=0

  while IFS= read -r pid_file; do
    [ -n "$pid_file" ] || continue
    local owned_by_state=0
    while IFS= read -r state_file; do
      [ -n "$state_file" ] || continue
      if yk_state_owns_pid_file "$state_file" "$pid_file"; then
        owned_by_state=1
        break
      fi
    done < <(yk_standard_state_files)
    [ "$owned_by_state" = "0" ] || continue
    found=1
    yk_usbipd_pid_file="$pid_file"

    if ! pid="$(yk_pid_file_pid_for_cleanup "$pid_file")"; then
      echo "Preserving invalid tool-shaped usbipd pid file: $pid_file" >&2
      code=1
      continue
    fi

    # Classify the process before applying stop policy.  An unrelated live
    # process must remain protected even when STOP_USBIPD=0 or other exports
    # make retention intentional for a positively owned daemon.
    if ! yk_owned_usbipd_running "$pid"; then
      if yk_process_exists "$pid"; then
        echo "Preserving unverified process at usbipd pid $pid ($pid_file)." >&2
        code=1
        continue
      fi
      echo "Reconciling stale usbipd pid file: $pid_file."
      if ! yk_remove_pid_file "$pid_file" "$pid"; then
        code=1
      fi
      continue
    fi

    if [ "$yk_stop_usbipd" != "1" ]; then
      echo "Leaving verified orphan usbipd pid $pid running by request ($pid_file)."
      continue
    fi
    if yk_other_exports_exist; then
      echo "Leaving verified orphan usbipd pid $pid because other USB/IP exports remain ($pid_file)." >&2
      continue
    fi

    # Re-read immediately before kill/rm so a PID-file replacement race
    # cannot turn a previously verified path into authority over another PID.
    if [ "$(yk_pid_file_pid_for_cleanup "$pid_file" 2>/dev/null || true)" != "$pid" ]; then
      echo "Preserving changed usbipd pid file during reconciliation: $pid_file" >&2
      code=1
      continue
    fi
    if ! yk_owned_usbipd_running "$pid"; then
      echo "Preserving usbipd pid file after ownership changed for pid $pid: $pid_file" >&2
      code=1
      continue
    fi

    if ! sudo kill "$pid" >/dev/null 2>&1; then
      echo "Could not stop verified orphan usbipd pid $pid ($pid_file)." >&2
      code=1
      continue
    fi
    if ! yk_wait_usbipd_exit "$pid"; then
      echo "Verified orphan usbipd pid $pid is still running ($pid_file)." >&2
      code=1
      continue
    fi
    if yk_process_exists "$pid"; then
      echo "Preserving unverified process at usbipd pid $pid ($pid_file)." >&2
      code=1
      continue
    fi

    # The daemon is gone, so an absent pid file is already reconciled.  If a
    # replacement remains, require the original verified PID before unlinking
    # it; invalid or changed evidence must be preserved for inspection.
    if runtime_path_present "$pid_file"; then
      final_pid="$(yk_pid_file_pid_for_cleanup "$pid_file" 2>/dev/null || true)"
      if [ "$final_pid" != "$pid" ]; then
        echo "Preserving replaced or invalid usbipd pid file after stop: $pid_file" >&2
        code=1
        continue
      fi
    fi

    if ! yk_remove_pid_file "$pid_file" "$pid"; then
      code=1
    else
      echo "Reconciled orphan usbipd pid file: $pid_file."
    fi
  done < <(yk_standard_pid_files)

  yk_usbipd_pid_file="$previous_pid_file"
  [ "$found" = "1" ] || return 0
  return "$code"
}

yk_remote_probe_readiness() {
  local vendor="${yk_usb_id%%:*}"
  local product="${yk_usb_id#*:}"
  local remote_script

  remote_script=$(cat <<'REMOTE_READINESS'
set +e
wanted_vendor='__VENDOR__'
wanted_product='__PRODUCT__'
hidraw_root="${REMOTE_CHROME_HIDRAW_ROOT:-/sys/class/hidraw}"
normalize_id() {
  value="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  value="${value#0x}"
  while [ "$value" != "0" ] && [ "${value#0}" != "$value" ]; do value="${value#0}"; done
  printf '%s' "$value"
}
property() {
  key="$1"
  printf '%s\n' "$properties" | awk -F= -v key="$key" '$1 == key {print tolower($2); exit}'
}
target_hidraw() {
  device="$1"
  require_fido="$2"
  properties="$(udevadm info --query=property --name="$device" 2>/dev/null || udevadm info --query=property --path="$device" 2>/dev/null)"
  [ -n "$properties" ] || return 1
  vendor_id="$(normalize_id "$(property ID_VENDOR_ID)")"
  product_id="$(normalize_id "$(property ID_MODEL_ID)")"
  [ "$vendor_id" = "$(normalize_id "$wanted_vendor")" ] || return 1
  [ "$product_id" = "$(normalize_id "$wanted_product")" ] || return 1
  if [ "$require_fido" = 1 ]; then
    printf '%s\n' "$properties" | grep -Eiq '(^|[[:space:]])(ID_INPUT_FIDO|ID_FIDO_TOKEN|ID_SECURITY_TOKEN)=1($|[[:space:]])|ID_MODEL(_FROM_DATABASE)?=.*(fido|security)' || return 1
  fi
  return 0
}
matching_hidraw_access_error() {
  user="$(id -un 2>/dev/null || printf unknown)"
  for hidraw in "$hidraw_root"/hidraw*; do
    [ -e "$hidraw" ] || continue
    device="/dev/${hidraw##*/}"
    target_hidraw "$device" 1 || continue
    if [ ! -r "$device" ] || [ ! -w "$device" ]; then
      printf 'permission-denied:%s:user=%s\n' "$device" "$user"
      return 0
    fi
  done
  return 1
}
if command -v udevadm >/dev/null 2>&1 && command -v fido2-token >/dev/null 2>&1; then
  fido_output="$(timeout 3 fido2-token -L 2>/dev/null)"
  for device in $(printf '%s\n' "$fido_output" | awk -F: '/^\/dev\/hidraw/ {print $1}'); do
    case "$device" in
      /dev/hidraw*) target_hidraw "$device" 1 && { echo verified-fido; exit 0; } ;;
    esac
  done
  if matching_hidraw_access_error; then
    exit 1
  fi
  echo fido2-unconfirmed
  exit 1
fi
if command -v udevadm >/dev/null 2>&1; then
  for hidraw in "$hidraw_root"/hidraw*; do
    [ -e "$hidraw" ] || continue
    device="/dev/${hidraw##*/}"
    target_hidraw "$device" 1 || continue
    if [ ! -r "$device" ] || [ ! -w "$device" ]; then
      printf 'permission-denied:%s:user=%s\n' "$device" \
        "$(id -un 2>/dev/null || printf unknown)"
      exit 1
    fi
    echo usb-only
    exit 0
  done
fi
echo not-ready
exit 1
REMOTE_READINESS
)
  local normalized_vendor="${vendor,,}"
  local normalized_product="${product,,}"
  remote_script="${remote_script//__VENDOR__/$normalized_vendor}"
  remote_script="${remote_script//__PRODUCT__/$normalized_product}"

  local output
  if output="$(yk_ssh "$remote_script" 2>&1)"; then
    case "$output" in
      *verified-fido*)
        yk_readiness="verified-fido"
        return 0
        ;;
      *usb-only*)
        yk_readiness="usb-only"
        return 0
        ;;
    esac
  fi
  yk_readiness="${output:-not-ready}"
  return 1
}

yk_wait_remote_ready() {
  local timeout="${REMOTE_CHROME_YUBIKEY_TIMEOUT:-15}"
  local interval="${REMOTE_CHROME_YUBIKEY_POLL_INTERVAL:-1}"
  local started elapsed remaining
  [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=15
  [[ "$interval" =~ ^[0-9]+$ ]] || interval=1
  [ "$timeout" -gt 0 ] || timeout=1
  timeout="$((10#$timeout))"
  interval="$((10#$interval))"

  started="$SECONDS"
  while [ $((SECONDS - started)) -lt "$timeout" ]; do
    if yk_remote_probe_readiness; then
      return 0
    fi
    elapsed=$((SECONDS - started))
    remaining=$((timeout - elapsed))
    [ "$remaining" -gt 0 ] || break
    [ "$interval" -gt "$remaining" ] && interval="$remaining"
    sleep "$interval"
  done

  echo "Remote YubiKey did not enumerate as a FIDO/hidraw device within ${timeout}s." >&2
  echo "Last remote readiness result: ${yk_readiness:-not-ready}" >&2
  echo "Inspect the ${yk_remote} yubikey pane and verify fido2-token/udev visibility." >&2
  return 1
}

chrome_detached_session=""
chrome_detached_cleanup_done=0
chrome_detached_yk_owned=0
chrome_detached_yk_token=""

chrome_detached_cleanup() {
  [ "$chrome_detached_cleanup_done" = "0" ] || return 0
  chrome_detached_cleanup_done=1
  if [ -n "$chrome_detached_session" ]; then
    tmux kill-session -t "=$chrome_detached_session" >/dev/null 2>&1 || true
    chrome_remove_bootstrap_script "$chrome_detached_session" || true
  fi
  if [ "$chrome_detached_yk_owned" = "1" ]; then
    if ! yk_stop "$chrome_detached_yk_token"; then
      echo "YubiKey cleanup remains incomplete; retry with $PROGRAM stop $yk_remote." >&2
    fi
  fi
}

chrome_wait_for_yubikey_window() {
  local host="$1"
  local session="$2"
  local timeout="${REMOTE_CHROME_YUBIKEY_TIMEOUT:-15}"
  local bootstrap_timeout="${REMOTE_CHROME_YUBIKEY_BOOTSTRAP_TIMEOUT:-30}"
  local readiness_grace="${REMOTE_CHROME_YUBIKEY_READY_GRACE:-5}"
  local phase readiness pane_state
  local bootstrap_started="$SECONDS"
  local readiness_started=""
  local pane_output log_output state_path_status=0 log_path_status=0
  [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=15
  [ "$timeout" -gt 0 ] || timeout=1
  [[ "$bootstrap_timeout" =~ ^[0-9]+$ ]] || bootstrap_timeout=30
  [ "$bootstrap_timeout" -gt 0 ] || bootstrap_timeout=1
  [[ "$readiness_grace" =~ ^[0-9]+$ ]] || readiness_grace=5
  [ "$readiness_grace" -gt 0 ] || readiness_grace=1
  timeout="$((10#$timeout))"
  bootstrap_timeout="$((10#$bootstrap_timeout))"
  readiness_grace="$((10#$readiness_grace))"

  while true; do
    state_path_status=0
    runtime_artifact_status "$yk_state_file" || state_path_status=$?
    if [ "$state_path_status" -eq 0 ]; then
      local state_token
      state_token="$(awk -F '\t' '$1 == "attempt_token" {print $2; exit}' "$yk_state_file" 2>/dev/null || true)"
      if [ "$state_token" != "$chrome_detached_yk_token" ]; then
        echo "YubiKey state belongs to another launch attempt; refusing to clean it." >&2
        break
      fi
      chrome_detached_yk_owned=1
      phase="$(awk -F '\t' '$1 == "phase" {print $2; exit}' "$yk_state_file" 2>/dev/null || true)"
      readiness="$(awk -F '\t' '$1 == "readiness" {print $2; exit}' "$yk_state_file" 2>/dev/null || true)"
      if [ "$phase" = "ready" ]; then
        echo "YubiKey forwarding is ready ($readiness)."
        return 0
      fi
      case "$phase" in
        attached|waiting-readiness)
          [ -n "$readiness_started" ] || readiness_started="$SECONDS"
          ;;
      esac
    elif [ "$state_path_status" -eq 2 ]; then
      echo "YubiKey state path became unsafe; refusing to read it: $yk_state_file" >&2
      break
    fi
    if ! tmux has-session -t "=$session" 2>/dev/null; then
      break
    fi
    pane_state="$(tmux list-panes -t "=$session:=yubikey" -F '#{pane_dead}' 2>/dev/null || true)"
    if [[ "$pane_state" == *1* ]]; then
      break
    fi
    if [ -n "$readiness_started" ]; then
      # The child has its own bounded readiness deadline.  Keep the parent
      # alive for a small additional grace period so its final state write,
      # tmux polling, and one in-flight SSH probe can be observed.
      [ $((SECONDS - readiness_started)) -lt "$((timeout + readiness_grace))" ] || break
    else
      [ $((SECONDS - bootstrap_started)) -lt "$bootstrap_timeout" ] || break
    fi
    sleep 1
  done

  pane_output="$(tmux capture-pane -p -t "=$session:=yubikey" 2>&1 || true)"
  if [ -n "$pane_output" ]; then
    echo "YubiKey bootstrap pane output:" >&2
    printf '%s\n' "$pane_output" >&2
  fi
  log_path_status=0
  runtime_artifact_status "$yk_log_file" || log_path_status=$?
  if [ "$log_path_status" -eq 0 ]; then
    log_output="$(cat "$yk_log_file" 2>/dev/null || true)"
    if [ -n "$log_output" ] && [ "$log_output" != "$pane_output" ]; then
      echo "YubiKey bootstrap log:" >&2
      printf '%s\n' "$log_output" >&2
    fi
  elif [ "$log_path_status" -eq 2 ]; then
    echo "Preserving unsafe YubiKey log path: $yk_log_file" >&2
  fi
  echo "YubiKey forwarding failed or timed out before readiness on $host." >&2
  return 1
}

chrome_launch_detached_with_yubikey() {
  local host="$1"
  local session="$2"
  local chrome_command_line="$3"
  shift 3
  local self
  local yk_command_line

  self="$(script_path)"
  chrome_detached_yk_token="${BASHPID:-$$}.${RANDOM}.${SECONDS}"
  local yk_command=(env "REMOTE_CHROME_YUBIKEY_ATTEMPT_TOKEN=$chrome_detached_yk_token" "$self" _yubikey-run "$host" \
    --usb-id "$yk_usb_id" --port "$yk_usbip_port" "$@")
  yk_command_line="$(quote_command "${yk_command[@]}")"
  chrome_detached_session="$session"
  chrome_detached_cleanup_done=0
  chrome_detached_yk_owned=0
  trap 'chrome_detached_cleanup; exit 130' INT
  trap 'chrome_detached_cleanup; exit 143' TERM
  trap 'chrome_detached_cleanup; exit 129' HUP

  if runtime_path_present "$yk_state_file" || runtime_path_present "$yk_attempt_lock"; then
    echo "YubiKey forwarding already has an active or provisional attempt for $yk_remote; stop it before launching again." >&2
    chrome_remove_bootstrap_script "$session" || true
    trap - INT TERM HUP
    return 1
  fi

  if ! tmux new-session -d -s "$session" -n yubikey "$yk_command_line"; then
    chrome_detached_cleanup
    trap - INT TERM HUP
    return 1
  fi
  tmux set-option -w -t "=$session:=yubikey" remain-on-exit failed >/dev/null 2>&1 || true

  if ! chrome_wait_for_yubikey_window "$host" "$session"; then
    chrome_detached_cleanup
    trap - INT TERM HUP
    return 1
  fi

  if ! tmux new-window -d -t "=$session" -n chrome bash -c "$chrome_command_line"; then
    echo "Could not create the remote Chrome tmux window after YubiKey readiness." >&2
    chrome_detached_cleanup
    trap - INT TERM HUP
    return 1
  fi
  if ! chrome_tmux_record_command "$session" "$chrome_command_line"; then
    echo "Could not record the canonical Chrome command after YubiKey readiness; cleaning up the managed session." >&2
    chrome_detached_cleanup
    trap - INT TERM HUP
    return 1
  fi

  trap - INT TERM HUP
  return 0
}

yk_rollback_start() {
  if yk_cleanup_resources 0 "$yk_attempt_token"; then
    yk_phase="failed"
    return 0
  fi
  # Keep the cleanup-failed phase and ledger for a later stop HOST retry.
  return 1
}

yk_start_impl() {
  yk_ensure_local_ready || return $?
  yk_phase="local-ready"
  yk_write_state || return $?
  yk_ensure_remote_ready || return $?
  yk_phase="remote-ready"
  yk_write_state || return $?

  local busid
  local usbip_timeout="${REMOTE_CHROME_USBIP_TIMEOUT:-5}"
  local client_port_option=""
  # Preserve the default scoped sudo command; custom ports need the USB/IP
  # client's global option as well as the daemon and SSH reverse forward.
  if [ "$yk_usbip_port" != "3240" ]; then
    client_port_option=" --tcp-port $yk_usbip_port"
  fi
  [[ "$usbip_timeout" =~ ^[0-9]+$ ]] || usbip_timeout=5
  [ "$usbip_timeout" -gt 0 ] || usbip_timeout=1
  busid="$(yk_first_busid)"
  if [ -z "${busid:-}" ]; then
    echo "No local YubiKey found with USB id $yk_usb_id." >&2
    echo "Current local USB/IP devices:" >&2
    usbip list -l >&2 || true
    return 1
  fi

  yk_active_busid="$busid"
  yk_bind_state="attempting"
  yk_bound_before=0
  if yk_local_busid_bound "$busid"; then
    yk_bound_before=1
  fi
  yk_phase="bind-starting"
  yk_write_state || return $?
  if ! sudo usbip bind -b "$busid"; then
    echo "Could not bind local YubiKey busid $busid to usbip-host." >&2
    return 1
  fi
  yk_bind_state="bound"
  yk_phase="bound"
  yk_write_state || return $?

  yk_open_tunnel || return $?
  yk_phase="tunnel-ready"
  yk_write_state || return $?

  if ! yk_ssh "timeout $usbip_timeout usbip$client_port_option list -r 127.0.0.1 | grep -q '$busid:'"; then
    echo "Remote host cannot see exported busid $busid through the SSH tunnel." >&2
    return 1
  fi

  yk_attach_state="attempting"
  yk_phase="attach-starting"
  yk_write_state || return $?
  if ! yk_ssh "timeout $usbip_timeout sudo -n usbip$client_port_option attach -r 127.0.0.1 -b '$busid'"; then
    echo "Could not attach remote YubiKey busid $busid." >&2
    return 1
  fi
  yk_attach_state="attached"
  yk_phase="attached"
  yk_readiness="waiting"
  yk_write_state || return $?

  if ! yk_wait_remote_ready; then
    return 1
  fi
  yk_phase="ready"
  yk_write_state || return $?

  echo "Forwarded local YubiKey $yk_usb_id busid $busid to $yk_remote."
  if [ "$yk_readiness" = "verified-fido" ]; then
    echo "Remote readiness verified with fido2-token (FIDO/hidraw)."
  else
    echo "Remote readiness detected via matching USB/udev FIDO metadata only (lower confidence; fido2-token did not confirm the exact device)." >&2
  fi
}

yk_cleanup_mark_failure() {
  local message="$1"
  yk_cleanup_unresolved=1
  yk_cleanup_messages+="$message"$'\n'
}

yk_cleanup_persist_state() {
  yk_phase="cleanup"
  if ! yk_write_state; then
    yk_cleanup_mark_failure "Could not persist YubiKey cleanup ledger: $yk_state_file"
    return 1
  fi
  return 0
}

yk_unbind_owned_busid() {
  local busid_bound=0
  [ -n "$yk_active_busid" ] || return 0
  case "$yk_bind_state" in
    none)
      return 0
      ;;
    attempting)
      if [ "$yk_bound_before" = "1" ]; then
        # The device was already bound before this attempt; never detach it.
        yk_bind_state="none"
        return 0
      fi
      if ! yk_local_busid_bound "$yk_active_busid"; then
        yk_bind_state="none"
        return 0
      fi
      ;;
    bound)
      [ "$yk_bound_before" = "1" ] && {
        yk_bind_state="none"
        return 0
      }
      ;;
    *)
      echo "Unknown local bind ownership state '$yk_bind_state' for busid $yk_active_busid." >&2
      return 1
      ;;
  esac

  if yk_local_busid_bound "$yk_active_busid"; then
    busid_bound=1
  else
    yk_bind_state="none"
    return 0
  fi

  if ! sudo usbip unbind -b "$yk_active_busid" >/dev/null 2>&1; then
    echo "Could not unbind local USB/IP busid $yk_active_busid." >&2
    return 1
  fi
  if [ "$busid_bound" = "1" ] && yk_local_busid_bound "$yk_active_busid"; then
    echo "Local USB/IP busid $yk_active_busid remains bound after unbind." >&2
    return 1
  fi
  yk_bind_state="none"
  return 0
}

yk_cleanup_resources_unlocked() {
  local emit_success="${1:-0}"
  local active_busid="$yk_active_busid"
  local cleanup_message

  yk_cleanup_unresolved=0
  yk_cleanup_messages=""

  if [ -n "$yk_active_busid" ] && [ "$yk_attach_state" != "none" ]; then
    if yk_remote_detach_busid "$yk_active_busid"; then
      yk_attach_state="none"
      yk_cleanup_persist_state || true
    else
      yk_cleanup_mark_failure "Could not detach remote USB/IP busid $yk_active_busid."
    fi
  fi

  if yk_close_tunnel; then
    yk_cleanup_persist_state || true
  else
    yk_cleanup_mark_failure "Could not close SSH USB/IP tunnel $yk_control_socket."
  fi

  if [ -n "$yk_active_busid" ] && [ "$yk_bind_state" != "none" ]; then
    if yk_unbind_owned_busid; then
      yk_cleanup_persist_state || true
    else
      yk_cleanup_mark_failure "Could not release local USB/IP busid $yk_active_busid."
    fi
  fi

  if [ "$yk_started_usbipd" = "1" ]; then
    if yk_stop_owned_usbipd; then
      # A daemon retained by explicit policy or other exports is no longer
      # part of this session's cleanup obligation; hostless reconciliation
      # can discover its standard PID file later.
      yk_started_usbipd=0
      yk_usbipd_pid=""
      yk_usbipd_pid_file_identity=""
      yk_usbipd_start_failed=0
      yk_cleanup_persist_state || true
    else
      yk_cleanup_mark_failure "Could not stop owned usbipd pid ${yk_usbipd_pid:-unknown}."
    fi
  fi

  if [ "$yk_cleanup_unresolved" = "1" ]; then
    yk_phase="cleanup-failed"
    yk_write_state >/dev/null 2>&1 || true
    while IFS= read -r cleanup_message; do
      [ -n "$cleanup_message" ] || continue
      echo "$cleanup_message" >&2
    done <<<"$yk_cleanup_messages"
    echo "YubiKey cleanup is incomplete; state retained for retry: $yk_state_file" >&2
    return 1
  fi

  # Do not discard the recovery ledger until every owned resource has been
  # released (or intentionally retained).  This ordering also keeps the log
  # available if state removal itself fails.
  if [ -n "$yk_log_file" ]; then
    if ! yk_remove_runtime_artifact "$yk_log_file"; then
      yk_cleanup_mark_failure "Could not remove YubiKey cleanup log $yk_log_file."
    fi
  fi
  if [ "$yk_cleanup_unresolved" = "0" ] && [ -n "$yk_attempt_lock" ] &&
    runtime_path_present "$yk_attempt_lock"; then
    if ! yk_release_attempt; then
      yk_cleanup_mark_failure "Could not release YubiKey attempt lock $yk_attempt_lock."
    fi
  fi
  if [ "$yk_cleanup_unresolved" = "0" ]; then
    if ! yk_remove_runtime_artifact "$yk_state_file"; then
      yk_cleanup_mark_failure "Could not remove YubiKey recovery state $yk_state_file."
    fi
  fi
  if [ "$yk_cleanup_unresolved" = "1" ]; then
    yk_phase="cleanup-failed"
    yk_write_state >/dev/null 2>&1 || true
    echo "YubiKey cleanup is incomplete; state retained for retry: $yk_state_file" >&2
    return 1
  fi

  if [ "$emit_success" = "1" ]; then
    if [ -n "$active_busid" ]; then
      echo "Stopped YubiKey USB/IP forwarding for $yk_remote (busid $active_busid)."
    else
      echo "Stopped provisional YubiKey USB/IP setup for $yk_remote."
    fi
  fi
  return 0
}

yk_cleanup_resources() {
  local cleanup_code=0
  local reload_code=0
  local previous_exit_trap
  local expected_token="${2:-}"

  if [ -n "$expected_token" ] && ! yk_attempt_is_current "$expected_token"; then
    return 3
  fi

  if ! yk_cleanup_lock_acquire; then
    return 1
  fi

  # A detached child can be interrupted while cleanup is in progress.  Keep
  # the per-state lock recoverable even when the shell exits unexpectedly;
  # yk_cleanup_resources_unlocked always leaves the last durable ledger phase
  # behind for a later retry.
  previous_exit_trap="$(trap -p EXIT || true)"
  trap 'yk_cleanup_lock_release_on_exit' EXIT

  if [ "$yk_cleanup_reload_state" = "1" ] || [ -n "$expected_token" ]; then
    yk_load_state || reload_code=$?
    yk_cleanup_reload_state=0
    if [ -n "$expected_token" ] &&
      { [ "$reload_code" -ne 0 ] || [ "$yk_attempt_token" != "$expected_token" ] ||
        ! runtime_owned_directory "$yk_attempt_lock" ||
        { [ -n "$yk_attempt_lock_identity" ] &&
          [ "$(runtime_path_identity "$yk_attempt_lock")" != "$yk_attempt_lock_identity" ]; }; }; then
      cleanup_code=3
    elif [ "$reload_code" -eq 1 ]; then
      # Another caller completed cleanup while this stop waited for the
      # per-state lock.  stop is idempotent once the ledger is gone.
      yk_cleanup_lock_release || cleanup_code=1
      if [ -n "$previous_exit_trap" ]; then
        eval "$previous_exit_trap"
      else
        trap - EXIT
      fi
      return "$cleanup_code"
    fi
    if [ "$reload_code" -ne 0 ] && [ "$cleanup_code" -ne 3 ]; then
      cleanup_code=1
    fi
  fi
  if [ "$cleanup_code" -eq 0 ]; then
    yk_cleanup_resources_unlocked "$@" || cleanup_code=$?
  fi
  if ! yk_cleanup_lock_release; then
    cleanup_code=1
  fi

  if [ -n "$previous_exit_trap" ]; then
    eval "$previous_exit_trap"
  else
    trap - EXIT
  fi
  return "$cleanup_code"
}

yk_start() {
  local socket_status=0
  local request_code=0
  yk_reset_runtime_state
  yk_attempt_owned=0
  yk_attempt_lock_identity=""
  yk_attempt_token="${REMOTE_CHROME_YUBIKEY_ATTEMPT_TOKEN:-}"
  yk_control_socket_status || socket_status=$?
  if [ "$socket_status" -eq 2 ]; then
    echo "Refusing to use unsafe SSH control socket path $yk_control_socket." >&2
    return 1
  fi
  yk_acquire_attempt || return $?
  if [ "$socket_status" -eq 0 ]; then
    if yk_ssh_request -S "$yk_control_socket" -O check "$yk_remote" >/dev/null 2>&1; then
      echo "YubiKey forwarding already has an active SSH tunnel: $yk_control_socket" >&2
      yk_release_attempt
      return 1
    else
      request_code=$?
    fi
    if yk_ssh_request_incomplete "$request_code"; then
      echo "SSH control check did not complete; preserving $yk_control_socket." >&2
      yk_release_attempt
      return 1
    fi
    socket_status=0
    yk_control_socket_status || socket_status=$?
    if [ "$socket_status" -eq 0 ]; then
      unlink -- "$yk_control_socket" || {
        echo "Could not remove stale SSH control socket $yk_control_socket." >&2
        yk_release_attempt
        return 1
      }
    elif [ "$socket_status" -eq 2 ]; then
      echo "SSH control socket path became unsafe: $yk_control_socket" >&2
      yk_release_attempt
      return 1
    fi
  fi

  yk_phase="starting"
  yk_readiness="none"
  if ! yk_write_state; then
    yk_release_attempt
    return 1
  fi

  local code=0
  yk_start_impl || code=$?
  if [ "$code" -ne 0 ]; then
    yk_rollback_start
    return "$code"
  fi
}

yk_stop() {
  local expected_token="${1:-}"
  local load_code=0
  local cleanup_code=0

  if [ -n "$expected_token" ] && ! yk_attempt_is_current "$expected_token"; then
    local state_status=0
    yk_state_path_status || state_status=$?
    if [ "$state_status" -eq 1 ] && [ "$yk_attempt_owned" = "1" ] &&
      [ -n "$yk_attempt_lock_identity" ] && runtime_owned_directory "$yk_attempt_lock" &&
      [ "$(runtime_path_identity "$yk_attempt_lock")" = "$yk_attempt_lock_identity" ]; then
      yk_release_attempt || return 1
    else
      # A stale helper has no authority over a missing, replaced, or unsafe
      # generation. In particular, it must leave a newer provisional lock.
      yk_attempt_owned=0
      yk_attempt_lock_identity=""
    fi
    return 0
  fi

  yk_load_state || load_code=$?
  if [ "$load_code" -eq 1 ]; then
    if [ -n "$expected_token" ]; then
      if [ "$yk_attempt_owned" = "1" ] && [ -n "$yk_attempt_lock_identity" ] &&
        runtime_owned_directory "$yk_attempt_lock" &&
        [ "$(runtime_path_identity "$yk_attempt_lock")" = "$yk_attempt_lock_identity" ]; then
        yk_release_attempt || return 1
      else
        yk_attempt_owned=0
        yk_attempt_lock_identity=""
      fi
      return 0
    fi
    echo "No managed YubiKey forwarding state for $yk_remote."
    if ! yk_release_orphan_attempt; then
      echo "Could not remove the provisional YubiKey attempt lock: $yk_attempt_lock" >&2
      return 1
    fi
    if [ "$yk_attempt_owned" = "1" ]; then
      yk_release_attempt
    fi
    return 0
  fi
  [ "$load_code" -eq 0 ] || return "$load_code"
  if [ -n "$expected_token" ] && [ "$yk_attempt_token" != "$expected_token" ]; then
    yk_attempt_owned=0
    yk_attempt_lock_identity=""
    return 0
  fi

  yk_cleanup_reload_state=1
  yk_cleanup_resources 1 "$expected_token" || cleanup_code=$?
  yk_cleanup_reload_state=0
  if [ "$cleanup_code" -eq 3 ] && [ -n "$expected_token" ]; then
    yk_attempt_owned=0
    yk_attempt_lock_identity=""
    return 0
  fi
  return "$cleanup_code"
}

yk_cleanup() {
  trap - EXIT INT TERM HUP
  if [ "$yk_cleanup_done" = "0" ]; then
    yk_cleanup_done=1
    if [ "$yk_attempt_owned" = "1" ]; then
      yk_stop "$yk_attempt_token"
    fi
  fi
}

yk_attempt_is_current() {
  local token="$1"
  runtime_artifact_status "$yk_state_file" || return 1
  runtime_owned_directory "$yk_attempt_lock" || return 1
  if [ -n "$yk_attempt_lock_identity" ] &&
    [ "$(runtime_path_identity "$yk_attempt_lock")" != "$yk_attempt_lock_identity" ]; then
    return 1
  fi
  [ -n "$token" ] &&
    [ "$(awk -F '\t' '$1 == "attempt_token" {print $2; exit}' "$yk_state_file")" = "$token" ]
}

yk_recovery_bind() {
  timeout --kill-after=1 5 sudo -n usbip bind -b "$1"
}

yk_recovery_ssh() {
  timeout --kill-after=1 6 ssh -S "$yk_control_socket" \
    -o BatchMode=yes -o ConnectTimeout=3 -o ConnectionAttempts=1 "$yk_remote" "$@"
}

yk_recover_returned_device() (
  local token="$1" busid="$2" attachment_code=0 client_port_option=""

  # Serialize with stop. A busy lock means try later; missing/replaced state
  # means this helper must retire without acquiring anything for the new owner.
  yk_attempt_is_current "$token" || return 3
  if ! REMOTE_CHROME_YUBIKEY_CLEANUP_LOCK_TIMEOUT=0 yk_cleanup_lock_acquire >/dev/null 2>&1; then
    return 2
  fi
  trap yk_cleanup_lock_release_on_exit EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  yk_attempt_is_current "$token" || return 3
  yk_load_state || return 1
  [[ "$yk_phase" = ready && "$yk_active_busid" = "$busid" && "$yk_bound_before" = 0 ]] || return 1
  yk_local_busid_bound "$busid" && return 0
  yk_sysfs_busids | grep -Fxq -- "$busid" || return 2
  if [ "$yk_started_usbipd" = 1 ]; then
    yk_owned_usbipd_running "$yk_usbipd_pid" || return 1
  fi
  yk_control_socket_status || return 1
  timeout --kill-after=1 3 ssh -S "$yk_control_socket" -O check "$yk_remote" >/dev/null 2>&1 || return 1

  # Recovery only covers the local hub reconnect. Never reopen the tunnel or
  # detach a surviving/ambiguous import. Each SSH request is bounded as a whole.
  yk_ssh() { yk_recovery_ssh "$@"; }
  yk_remote_probe_attachment "$busid" || attachment_code=$?
  [ "$attachment_code" = 1 ] || return 1
  yk_bind_state=attempting
  yk_attach_state=none
  yk_phase=bind-starting
  yk_readiness=waiting
  yk_write_state || return 1
  yk_recovery_bind "$busid" || return 1
  yk_bind_state=bound
  yk_phase=bound
  yk_write_state || return 1
  [ "$yk_usbip_port" = 3240 ] || client_port_option=" --tcp-port $yk_usbip_port"
  yk_attach_state=attempting
  yk_phase=attach-starting
  yk_write_state || return 1
  yk_ssh "timeout 5 sudo -n usbip$client_port_option attach -r 127.0.0.1 -b '$busid'" || return 1
  yk_attach_state=attached
  yk_phase=attached
  yk_write_state || return 1
  yk_wait_remote_ready || return 1
  yk_phase=ready
  yk_write_state || return 1
  echo "Restored YubiKey forwarding after USB reconnect: $busid ($yk_readiness). Chrome was kept running."
)

yk_monitor_local_usb() {
  local token="$yk_attempt_token" busid="$yk_active_busid"
  local waiting=0 disabled=0 recovery_code=0

  while true; do
    sleep 5 &
    wait "$!"
    if ! yk_attempt_is_current "$token"; then
      yk_attempt_owned=0
      return 0
    fi
    [ "$disabled" = 0 ] || continue
    yk_local_busid_bound "$busid" && continue
    if [ "$waiting" = 0 ]; then
      echo "YubiKey USB export disappeared; waiting for $yk_usb_id at port $busid. Chrome is still running."
      waiting=1
    fi
    yk_sysfs_busids | grep -Fxq -- "$busid" || continue
    recovery_code=0
    yk_recover_returned_device "$token" "$busid" || recovery_code=$?
    case "$recovery_code" in
      0) waiting=0 ;;
      2) continue ;;
      3) yk_attempt_owned=0; return 0 ;;
      *)
        disabled=1
        echo "Automatic YubiKey recovery could not complete; state retained. Use remote-chrome reset $yk_remote to retry." >&2
        ;;
    esac
  done
}

yk_run() {
  local state_code=0
  yk_cleanup_done=0
  if [ -n "$yk_log_file" ]; then
    yk_load_state || state_code=$?
    if [ "$state_code" -ne 0 ] && [ "$state_code" -ne 1 ]; then
      echo "Refusing to start with invalid YubiKey state: $yk_state_file" >&2
      return "$state_code"
    fi
    if ! (umask 077; mkdir -p -- "$(dirname -- "$yk_log_file")"); then
      echo "Could not create YubiKey log directory for $yk_log_file." >&2
      return 1
    fi
    yk_prepare_log_file || return 1
    exec > >(tee -a "$yk_log_file") 2>&1
  fi
  trap yk_cleanup EXIT
  trap 'yk_cleanup; exit 130' INT
  trap 'yk_cleanup; exit 143' TERM
  trap 'yk_cleanup; exit 129' HUP

  yk_start || return $?
  echo "YubiKey forwarding is active. Press Ctrl-C to stop and clean up."
  yk_monitor_local_usb
}

_yubikey_run_main() {
  local host="$1"
  shift
  yk_prepare_for_launch "$host" "$@"
  yk_run
}

_notify_listener_main() {
  exec python3 - "$@" <<'REMOTE_CHROME_NOTIFY_LISTENER'
import html
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
from html.parser import HTMLParser

MAX_SUMMARY = 512
MAX_BODY = 4096
MAX_APP = 128
MAX_DESKTOP_ENTRY = 128
MAX_LINE = 1 << 20
RATE_LIMIT = 10
RATE_WINDOW = 1.0
URGENCY = {0: "low", 1: "normal", 2: "critical"}
TAGS = re.compile(r"<[^>]*>")
ENTITIES = (
    ("&lt;", "<"),
    ("&gt;", ">"),
    ("&quot;", '"'),
    ("&#39;", "'"),
    ("&nbsp;", " "),
    ("&amp;", "&"),
)
SAFE_NAME = re.compile(r"[^A-Za-z0-9._-]+")


class NotificationBody(HTMLParser):
    def __init__(self, markup, limit):
        super().__init__(convert_charrefs=True)
        self.markup = markup
        self.remaining = limit
        self.closing_size = 0
        self.parts = []
        self.tags = []
        self.full = False
        if markup:
            # Declare markup even for literal-only bodies. Some daemons would
            # otherwise decode escaped tags again or guess Markdown formatting.
            self.append("<b></b>")

    def append(self, value):
        if self.full or len(value) > self.remaining - self.closing_size:
            self.full = True
            return False
        self.parts.append(value)
        self.remaining -= len(value)
        return True

    def handle_starttag(self, tag, _attrs):
        if self.full:
            return
        if tag == "br":
            self.handle_data("\n")
        elif self.markup and tag in {"b", "i", "u"}:
            closing_size = len(tag) + 3
            self.closing_size += closing_size
            if self.append(f"<{tag}>"):
                self.tags.append(tag)
            else:
                self.closing_size -= closing_size

    def handle_endtag(self, tag):
        if self.full or tag not in self.tags:
            return
        while self.tags:
            current = self.tags.pop()
            closing = f"</{current}>"
            self.closing_size -= len(closing)
            self.append(closing)
            if current == tag:
                break

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        self.handle_endtag(tag)

    def handle_data(self, data):
        if self.full:
            return
        for character in data:
            if self.markup:
                value = "<br/>" if character == "\n" else html.escape(character, quote=False)
            else:
                value = character
            if not self.append(value):
                break

    def finish(self):
        # Space for these closing tags was reserved before emitting each opener.
        while self.tags:
            self.parts.append(f"</{self.tags.pop()}>")
        return "".join(self.parts)


def clean_body(value, markup):
    if not isinstance(value, str):
        return ""
    parser = NotificationBody(markup, MAX_BODY)
    parser.feed(value)
    parser.close()
    return parser.finish()


def supports_body_markup():
    try:
        result = subprocess.run(
            ["busctl", "--user", "--json=short", "call",
             "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
             "org.freedesktop.Notifications", "GetCapabilities"],
            check=False, timeout=2, capture_output=True, text=True,
        )
        if result.returncode != 0:
            return False
        response = json.loads(result.stdout)
        return response.get("type") == "as" and "body-markup" in response["data"][0]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError, TypeError, AttributeError):
        return False


def log_line(log_path, message):
    try:
        with open(log_path, "a", encoding="utf-8") as handle:
            handle.write(f"{time.time():.0f}\t{message}\n")
    except OSError:
        pass


def clean_text(value, limit):
    if not isinstance(value, str):
        return ""
    text = value
    for source, target in ENTITIES:
        text = text.replace(source, target)
    previous = None
    while previous != text:
        previous = text
        text = TAGS.sub("", text)
    text = " ".join(text.split())
    return text[:limit]


def clean_name(value, limit):
    if not isinstance(value, str):
        return ""
    return SAFE_NAME.sub("-", value)[:limit].strip("-")


def deliver(record, log_path, body_markup):
    summary = clean_text(record.get("summary"), MAX_SUMMARY)
    plain_body = clean_body(record.get("body"), False)
    body = ""
    if plain_body.strip():
        body = clean_body(record.get("body"), True) if body_markup else plain_body
    if not summary and not plain_body.strip():
        return
    app_name = clean_text(record.get("app_name"), MAX_APP) or "remote-chrome"
    urgency = URGENCY.get(record.get("urgency"), "normal")
    desktop_entry = clean_name(record.get("desktop_entry"), MAX_DESKTOP_ENTRY)

    command = ["notify-send", f"--app-name={app_name}", f"--urgency={urgency}"]
    if desktop_entry:
        command.append(f"--hint=string:desktop-entry:{desktop_entry}")
    command.append("--")
    command.append(summary or plain_body[:MAX_SUMMARY])
    if body:
        command.append(body)
    try:
        result = subprocess.run(
            command,
            check=False,
            timeout=10,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError) as error:
        log_line(log_path, f"delivery-failed\t{error}")
        return
    if result.returncode == 0:
        log_line(log_path, f"delivered\t{app_name}\t{summary}")
    else:
        log_line(log_path, f"delivery-failed\tstatus {result.returncode}")


def handle_connection(connection, recent, log_path, body_markup):
    buffer = b""
    connection.settimeout(5)
    try:
        while b"\n" not in buffer and len(buffer) <= MAX_LINE:
            chunk = connection.recv(65536)
            if not chunk:
                break
            buffer += chunk
        if len(buffer) > MAX_LINE:
            log_line(log_path, "oversized-record-dropped")
            return
        first_line = buffer.split(b"\n", 1)[0]
        try:
            first_record = json.loads(first_line)
        except (ValueError, RecursionError):
            first_record = None
        if isinstance(first_record, dict) and first_record.get("type") == "hello":
            try:
                InteractiveClient(connection, log_path, first_record, buffer[len(first_line) + 1:]).run()
            except Exception as error:
                log_line(log_path, f"interactive-client-failed\t{type(error).__name__}: {error}")
                try:
                    connection.sendall((json.dumps({"v": 1, "type": "error", "code": "listener-unavailable",
                                                    "message": str(error)[:256]}) + "\n").encode("utf-8"))
                except OSError:
                    pass
            return
        if body_markup is None:
            # Legacy records only occur when bootstrap selected an existing
            # daemon. Interactive mode never probes the activating well-known name.
            body_markup = supports_body_markup()
        while True:
            chunk = connection.recv(65536)
            if not chunk:
                break
            buffer += chunk
            if len(buffer) > MAX_LINE:
                log_line(log_path, "oversized-record-dropped")
                return
    except OSError:
        pass
    for line in buffer.splitlines():
        try:
            record = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if not isinstance(record, dict):
            continue
        now = time.monotonic()
        recent[:] = [stamp for stamp in recent if now - stamp < RATE_WINDOW]
        if len(recent) >= RATE_LIMIT:
            log_line(log_path, "rate-limited")
            continue
        recent.append(now)
        try:
            deliver(record, log_path, body_markup)
        except (TypeError, ValueError, RecursionError) as error:
            # Each record is untrusted. Invalid hints, NULs, invalid Unicode,
            # or excessive nesting must not terminate a session's listener.
            log_line(log_path, f"invalid-record-dropped\t{type(error).__name__}")


def positive_id(value):
    return isinstance(value, int) and not isinstance(value, bool) and 0 < value <= 0xFFFFFFFF


PROTOCOL_VERSION = 1
MAX_FRAME = 64 * 1024
MAX_QUEUE_BYTES = 1 << 20
MAX_QUEUE = 64
MAX_ACTIVE = 256


class InteractiveClient:
    """One ordered D-Bus operation stream, pinned to one destination owner."""

    def __init__(self, connection, log_path, hello, initial=b""):
        import dbus
        from dbus.mainloop.glib import DBusGMainLoop
        from gi.repository import GLib
        self.dbus, self.GLib = dbus, GLib
        self.connection, self.log_path = connection, log_path
        self.session_id, self.generation = hello.get("session_id"), hello.get("generation")
        self.revisions = hello.get("notification_revisions", False)
        if (type(hello.get("v")) is not int or hello["v"] != PROTOCOL_VERSION
                or type(self.revisions) is not bool
                or not isinstance(self.session_id, str) or not 0 < len(self.session_id) <= 256
                or not isinstance(self.generation, str) or not 0 < len(self.generation) <= 128):
            raise ValueError("invalid protocol or session identity")
        self.connection.setblocking(False)
        self.input = bytearray(initial)
        self.output, self.operations = [], []
        self.output_bytes = self.operation_bytes = 0
        self.write_watch = 0
        self.closed = self.active = False
        self.states = {}
        self.recent = []
        self.inflight = None
        self.inflight_events = []
        self.cleanup_ids = set()
        self.drain_timer = 0
        self.drain_expired = False
        self.loop = GLib.MainLoop()
        DBusGMainLoop(set_as_default=True)
        self.bus = dbus.bus.BusConnection(os.environ["DBUS_SESSION_BUS_ADDRESS"])
        self.daemon = dbus.Interface(self.bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus", introspect=False),
                                     "org.freedesktop.DBus")
        self.name, self.path = "org.freedesktop.Notifications", "/org/freedesktop/Notifications"
        self.owner = str(self.daemon.GetNameOwner(self.name, timeout=0.35))
        self.interface = dbus.Interface(self.bus.get_object(self.owner, self.path, introspect=False), self.name)
        self.capabilities = {str(value) for value in self.interface.GetCapabilities(timeout=0.45)}
        self.server_information = [str(value) for value in self.interface.GetServerInformation(timeout=0.45)]
        if not {"body", "actions"}.issubset(self.capabilities):
            self.bus.close()
            raise RuntimeError("destination daemon must support body and actions")
        self.body_markup = "body-markup" in self.capabilities
        self.matches = [
            self.bus.add_signal_receiver(self.on_action, signal_name="ActionInvoked",
                dbus_interface=self.name, path=self.path, bus_name=self.owner, sender_keyword="sender"),
            self.bus.add_signal_receiver(self.on_closed, signal_name="NotificationClosed",
                dbus_interface=self.name, path=self.path, bus_name=self.owner, sender_keyword="sender"),
            self.bus.add_signal_receiver(self.on_owner_changed, signal_name="NameOwnerChanged",
                dbus_interface="org.freedesktop.DBus", path="/org/freedesktop/DBus",
                bus_name="org.freedesktop.DBus", arg0=self.name),
        ]
        # Signal matches exist before readiness, and ownership is checked again
        # after installing them so a setup-time name change cannot go unnoticed.
        if str(self.daemon.GetNameOwner(self.name, timeout=0.2)) != self.owner:
            self.bus.close()
            raise RuntimeError("destination owner changed during readiness")
        self.read_watch = GLib.io_add_watch(connection, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_socket)

    def envelope(self, kind, **fields):
        return {"v": PROTOCOL_VERSION, "type": kind, "session_id": self.session_id,
                "generation": self.generation, **fields}

    def queue(self, record):
        if self.closed:
            return
        blob = (json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
        if len(blob) > MAX_FRAME or len(self.output) >= MAX_QUEUE or self.output_bytes + len(blob) > MAX_QUEUE_BYTES:
            self.disconnect("outbound-queue-limit")
            return
        self.output.append(memoryview(blob))
        self.output_bytes += len(blob)
        if not self.write_watch:
            self.write_watch = self.GLib.io_add_watch(self.connection,
                self.GLib.IO_OUT | self.GLib.IO_HUP | self.GLib.IO_ERR, self.on_write)

    def run(self):
        self.queue(self.envelope("ready", destination_owner=self.owner,
            notification_revisions=self.revisions,
            capabilities=sorted(self.capabilities & {"body", "actions", "body-markup"}),
            server_information=self.server_information))
        log_line(self.log_path, f"interactive-ready\towner {self.owner}\tcaps {','.join(sorted(self.capabilities))}")
        try:
            self.consume_input()
            if not self.closed:
                self.loop.run()
        finally:
            self.dispose()

    def on_write(self, _source, condition):
        if condition & (self.GLib.IO_HUP | self.GLib.IO_ERR):
            self.write_watch = 0
            self.disconnect("socket-write-hangup")
            return self.GLib.SOURCE_REMOVE
        while self.output:
            try:
                written = self.connection.send(self.output[0])
            except BlockingIOError:
                return self.GLib.SOURCE_CONTINUE
            except OSError:
                written = 0
            if written <= 0:
                self.write_watch = 0
                self.disconnect("socket-write-failed")
                return self.GLib.SOURCE_REMOVE
            self.output_bytes -= written
            self.output[0] = self.output[0][written:]
            if not self.output[0]:
                self.output.pop(0)
        self.write_watch = 0
        return self.GLib.SOURCE_REMOVE

    def consume_input(self):
        while b"\n" in self.input and not self.closed:
            line, _, rest = self.input.partition(b"\n")
            self.input = bytearray(rest)
            if len(line) > MAX_FRAME:
                self.disconnect("oversized-frame")
                return
            try:
                self.handle_record(json.loads(line))
            except (ValueError, TypeError, RecursionError, UnicodeError):
                self.queue(self.envelope("error", code="malformed-record"))
        if len(self.input) > MAX_FRAME:
            self.disconnect("oversized-frame")

    def on_socket(self, _source, condition):
        if condition & (self.GLib.IO_IN | self.GLib.IO_HUP):
            while not self.closed:
                try:
                    chunk = self.connection.recv(65536)
                except BlockingIOError:
                    break
                except OSError:
                    chunk = b""
                if not chunk:
                    self.read_watch = 0
                    self.disconnect("source-disconnected")
                    return self.GLib.SOURCE_REMOVE
                self.input.extend(chunk)
                self.consume_input()
        if self.closed or condition & (self.GLib.IO_HUP | self.GLib.IO_ERR):
            self.read_watch = 0
            self.disconnect("source-disconnected")
            return self.GLib.SOURCE_REMOVE
        return self.GLib.SOURCE_CONTINUE

    def handle_record(self, record):
        if (not isinstance(record, dict) or type(record.get("v")) is not int
                or record["v"] != PROTOCOL_VERSION or record.get("session_id") != self.session_id
                or record.get("generation") != self.generation):
            self.queue(self.envelope("error", code="stale-session"))
            return
        kind = record.get("type")
        if kind == "abort":
            self.disconnect("source-aborted")
            return
        if kind == "active":
            self.active = True
            return
        if not self.active:
            self.queue(self.envelope("error", code="source-not-active"))
            return
        source_id = record.get("source_id")
        if not positive_id(source_id):
            self.queue(self.envelope("error", code="invalid-id"))
            return
        revision = record.get("revision") if self.revisions else 0
        if self.revisions and not positive_id(revision):
            self.queue(self.envelope("error", code="invalid-notification-revision"))
            return
        size = len(json.dumps(record, ensure_ascii=False).encode("utf-8"))
        if kind == "notify":
            replaces = record.get("replaces_id", 0)
            actions = record.get("actions", [])
            expires = record.get("expires", -1)
            if (type(replaces) is not int or replaces not in (0, source_id)
                    or any(not isinstance(record.get(k), str) for k in ("app_name", "summary", "body"))
                    or not isinstance(actions, list) or len(actions) > 32 or len(actions) % 2
                    or any(not isinstance(item, str) or len(item) > 256 for item in actions)
                    or type(expires) is not int or not -1 <= expires <= 0x7FFFFFFF):
                self.fail_record(record, "invalid notification")
                return
            if (self.revisions and source_id in self.states
                    and revision <= self.states[source_id]["latest_revision"]):
                self.queue(self.envelope("error", code="stale-notification-revision"))
                return
            now = time.monotonic()
            self.recent = [stamp for stamp in self.recent if now - stamp < RATE_WINDOW]
            if len(self.recent) >= RATE_LIMIT:
                self.fail_record(record, "rate limit")
                return
            self.recent.append(now)
            if source_id not in self.states:
                if len(self.states) >= MAX_ACTIVE:
                    self.queue(self.envelope("delivery-error", source_id=source_id,
                        revision=revision, error="active limit"))
                    return
                self.states[source_id] = {"local_id": 0, "actions": [], "closing": False,
                                          "pending_notifies": 0, "revision": 0, "latest_revision": 0}
            if self.states[source_id]["closing"]:
                self.queue(self.envelope("error", code="closed-source-id"))
                return
        elif kind == "close":
            state = self.states.get(source_id)
            local_id = record.get("local_id", 0)
            if state is None:
                self.queue(self.envelope("error", code="unknown-source-id"))
                return
            if self.revisions and revision != state["latest_revision"]:
                self.queue(self.envelope("error", code="stale-notification-revision"))
                return
            if (type(local_id) is not int or local_id < 0 or local_id > 0xFFFFFFFF
                    or (local_id and local_id != state["local_id"])):
                self.queue(self.envelope("error", code="mapping-mismatch"))
                return
            if state["closing"]:
                return
            state["closing"] = True
        else:
            self.queue(self.envelope("error", code="unknown-message"))
            return
        if len(self.operations) >= MAX_QUEUE or self.operation_bytes + size > MAX_QUEUE_BYTES:
            self.disconnect("operation-queue-limit")
            return
        self.operations.append((record, size))
        self.operation_bytes += size
        if kind == "notify":
            self.states[source_id]["pending_notifies"] += 1
            self.states[source_id]["latest_revision"] = revision
        self.pump()

    def pump(self):
        if self.closed or self.inflight is not None:
            return
        while self.operations:
            record, size = self.operations.pop(0)
            self.operation_bytes -= size
            source_id = record["source_id"]
            state = self.states.get(source_id)
            if state is None:
                continue
            self.inflight = record
            self.inflight_events = []
            try:
                if record["type"] == "close":
                    if not state["local_id"]:
                        self.inflight = None
                        continue
                    self.interface.CloseNotification(self.dbus.UInt32(state["local_id"]),
                        reply_handler=self.on_close_reply, error_handler=self.on_operation_error, timeout=1.0)
                else:
                    plain = clean_body(record["body"], False)
                    summary = clean_text(record["summary"], MAX_SUMMARY) or plain[:MAX_SUMMARY]
                    body = clean_body(record["body"], self.body_markup) if plain.strip() else ""
                    hints = self.dbus.Dictionary({}, signature="sv")
                    urgency = record.get("urgency", 1)
                    if type(urgency) is int and 0 <= urgency <= 2:
                        hints["urgency"] = self.dbus.Byte(urgency, variant_level=1)
                    desktop = clean_name(record.get("desktop_entry"), MAX_DESKTOP_ENTRY)
                    if desktop:
                        hints["desktop-entry"] = self.dbus.String(desktop, variant_level=1)
                    self.interface.Notify(clean_text(record["app_name"], MAX_APP) or "remote-chrome",
                        self.dbus.UInt32(state["local_id"]), "", summary, body,
                        self.dbus.Array(record.get("actions", []), signature="s"), hints,
                        self.dbus.Int32(record.get("expires", -1)), reply_handler=self.on_notify_reply,
                        error_handler=self.on_operation_error, timeout=1.0)
                return
            except Exception as error:
                self.on_operation_error(error)
                return

    def on_notify_reply(self, local_id):
        record, self.inflight = self.inflight, None
        early_events, self.inflight_events = self.inflight_events, []
        local_id = int(local_id)
        if not positive_id(local_id):
            if record is not None:
                self.fail_record(record, "invalid destination ID", enqueued=True)
            self.pump()
            return
        if self.closed:
            self.cleanup_local(local_id)
            self.finish_drain()
            return
        source_id = record["source_id"]
        state = self.states.get(source_id)
        if state is None:
            self.cleanup_local(local_id)
        else:
            state["pending_notifies"] -= 1
            state.update(local_id=local_id, actions=record.get("actions", [])[::2], revision=record.get("revision", 0))
            self.queue(self.envelope("mapped", source_id=source_id, local_id=local_id, revision=state["revision"]))
            summary = clean_text(record["summary"], MAX_SUMMARY)
            log_line(self.log_path, f"delivered\t{source_id}\t{local_id}\t{summary}")
            # The daemon may expose the popup before replying to Notify.
            # Replay only events for its returned ID, after publishing the map.
            for kind, event_id, value in early_events:
                if event_id != local_id:
                    continue
                if kind == "action":
                    self.on_action(event_id, value, sender=self.owner)
                else:
                    self.on_closed(event_id, value, sender=self.owner)
        self.pump()

    def on_close_reply(self):
        record, self.inflight = self.inflight, None
        if not self.closed and record is not None:
            state = self.states.pop(record["source_id"], None)
            if state is not None:
                self.queue(self.envelope("closed", source_id=record["source_id"],
                    local_id=state["local_id"], revision=record.get("revision", 0), reason=3))
        self.pump()
        self.finish_drain()

    def fail_record(self, record, error, *, enqueued=False):
        source_id = record["source_id"]
        state = self.states.get(source_id)
        if enqueued and record.get("type") == "notify" and state is not None:
            # Count only notifications that made it onto the operation queue.
            # A failed earlier delivery must leave any accepted replacements
            # available for pump() to deliver.
            if state["pending_notifies"] > 0:
                state["pending_notifies"] -= 1
            if state["pending_notifies"]:
                local_id = state["local_id"]
                state.update(local_id=0, actions=[])
                if local_id:
                    self.cleanup_local(local_id)
                log_line(self.log_path, f"delivery-failed\t{source_id}\t{type(error).__name__}: {error}")
                return
        state = self.states.pop(source_id, None)
        if state and state["local_id"]:
            self.cleanup_local(state["local_id"])
        self.queue(self.envelope("delivery-error", source_id=source_id,
            revision=record.get("revision", 0), error=str(error)[:256]))
        log_line(self.log_path, f"delivery-failed\t{source_id}\t{type(error).__name__}: {error}")

    def on_operation_error(self, error):
        record, self.inflight = self.inflight, None
        self.inflight_events = []
        if record is not None and not self.closed:
            self.fail_record(record, error, enqueued=True)
        self.pump()
        self.finish_drain()

    def defer_inflight_event(self, kind, local_id, value, source_id=None):
        if (self.inflight is None or self.inflight["type"] != "notify"
                or (source_id is not None and self.inflight["source_id"] != source_id)):
            return False
        if kind == "action" and len(value) > 256:
            return True
        if len(self.inflight_events) >= MAX_QUEUE:
            self.disconnect("early-event-queue-limit")
        else:
            self.inflight_events.append((kind, local_id, value))
        return True

    def on_action(self, notification_id, key, sender=None):
        local_id, key = int(notification_id), str(key)
        if self.closed or sender != self.owner or not positive_id(local_id):
            return
        for source_id, state in self.states.items():
            if state["local_id"] == local_id:
                if self.defer_inflight_event("action", local_id, key, source_id):
                    return
                if not state["closing"] and key in state["actions"]:
                    self.queue(self.envelope("action", source_id=source_id, local_id=local_id,
                        revision=state["revision"], key=key))
                    log_line(self.log_path, f"action\t{source_id}\t{local_id}\t{key[:128]}")
                return
        self.defer_inflight_event("action", local_id, key)

    def on_closed(self, notification_id, reason, sender=None):
        local_id, reason = int(notification_id), int(reason)
        if self.closed or sender != self.owner or not positive_id(local_id) or not 1 <= reason <= 4:
            return
        for source_id, state in list(self.states.items()):
            if state["local_id"] == local_id:
                if self.defer_inflight_event("closed", local_id, reason, source_id):
                    return
                if state["pending_notifies"]:
                    # An accepted replacement is still queued. The old popup
                    # closing must not invalidate it; deliver it with a fresh ID.
                    state.update(local_id=0, actions=[])
                    return
                self.states.pop(source_id)
                self.queue(self.envelope("closed", source_id=source_id, local_id=local_id,
                    revision=state["revision"], reason=reason))
                log_line(self.log_path, f"closed\t{source_id}\t{local_id}\t{reason}")
                return
        self.defer_inflight_event("closed", local_id, reason)

    def on_owner_changed(self, name, old_owner, new_owner):
        if str(name) == self.name and str(new_owner) != self.owner:
            self.disconnect("destination-owner-changed")

    def cleanup_local(self, local_id):
        if local_id in self.cleanup_ids:
            return
        self.cleanup_ids.add(local_id)
        def done(*_args):
            self.cleanup_ids.discard(local_id)
            self.finish_drain()
        try:
            self.interface.CloseNotification(self.dbus.UInt32(local_id),
                reply_handler=done, error_handler=done, timeout=0.25)
        except Exception:
            done()

    def finish_drain(self):
        if self.closed and self.inflight is None and not self.cleanup_ids:
            self.loop.quit()
        return self.GLib.SOURCE_REMOVE

    def disconnect(self, reason):
        if self.closed:
            return
        self.closed = True
        log_line(self.log_path, f"interactive-disconnected\t{reason}")
        self.operations.clear()
        self.operation_bytes = 0
        self.output.clear()
        self.output_bytes = 0
        try:
            self.connection.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        for state in self.states.values():
            if state["local_id"]:
                self.cleanup_local(state["local_id"])
        self.states.clear()
        self.drain_timer = self.GLib.timeout_add(1350, self.force_finish_drain)
        self.finish_drain()

    def force_finish_drain(self):
        self.drain_timer = 0
        self.drain_expired = True
        self.loop.quit()
        return self.GLib.SOURCE_REMOVE

    def dispose(self):
        if not self.closed:
            self.disconnect("listener-stop")
        if not self.drain_expired and (self.inflight is not None or self.cleanup_ids):
            self.loop.run()
        for watch in (self.read_watch, self.write_watch, self.drain_timer):
            if watch and self.GLib.MainContext.default().find_source_by_id(watch):
                self.GLib.source_remove(watch)
        for match in self.matches:
            match.remove()
        self.bus.close()


def main(argv):
    if len(argv) != 3:
        print("usage: _notify-listener SOCKET LOG", file=sys.stderr)
        return 64
    socket_path = argv[1]
    log_path = argv[2]
    try:
        sys.stderr = open(log_path, "a", encoding="utf-8", buffering=1)
    except OSError:
        pass
    try:
        os.chmod(log_path, 0o600)
    except OSError:
        pass

    if os.path.exists(socket_path):
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.connect(socket_path)
        except OSError:
            os.unlink(socket_path)
        else:
            print(
                f"notify-listener: another listener owns {socket_path}",
                file=sys.stderr,
            )
            return 73
        finally:
            probe.close()

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(socket_path)
    os.chmod(socket_path, 0o600)
    server.listen(8)

    def stop(_signum, _frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    body_markup = None
    log_line(log_path, f"started\tpid {os.getpid()}\tinteractive-capability-probe deferred")
    recent = []
    try:
        while True:
            try:
                connection, _ = server.accept()
            except InterruptedError:
                continue
            with connection:
                handle_connection(connection, recent, log_path, body_markup)
    finally:
        server.close()
        try:
            os.unlink(socket_path)
        except FileNotFoundError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
REMOTE_CHROME_NOTIFY_LISTENER
}

main() {
  local subcommand="${1:-}"

  case "$subcommand" in
    launch)
      shift
      chrome_launch "$@"
      ;;
    stop)
      shift
      chrome_stop "$@"
      ;;
    status)
      shift
      chrome_status "$@"
      ;;
    doctor)
      shift
      chrome_doctor "$@"
      ;;
    attach)
      shift
      chrome_attach "$@"
      ;;
    reset)
      shift
      chrome_reset "$@"
      ;;
    _yubikey-run)
      shift
      _yubikey_run_main "$@"
      ;;
    _notify-listener)
      shift
      _notify_listener_main "$@"
      ;;
    _notify-status)
      [ "$#" = "2" ] || return 2
      notify_source_status "$2"
      ;;
    -V|--version|version)
      echo "$PROGRAM $VERSION"
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      chrome_ensure "$@"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]:-}" == "$0" ]]; then
  main "$@"
fi
